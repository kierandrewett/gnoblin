# Maintainer: Kieran Drewett <kieran@drewett.dev>
# shellcheck shell=bash disable=SC2034,SC2154
pkgname=gnoblin-ananicy-rules
pkgver=0.1.0
pkgrel=1
pkgdesc='Ananicy-cpp rules for the Gnoblin compositor and shell'
arch=('any')
url='https://github.com/kierandrewett/gnoblin'
license=('GPL-2.0-or-later')
optdepends=('ananicy-cpp: applies these rules')
backup=('etc/ananicy.d/99-gnoblin.types' 'etc/ananicy.d/99-gnoblin.rules')
install="$pkgname.install"
source=('99-gnoblin.types' '99-gnoblin.rules')
sha256sums=('SKIP' 'SKIP')

package() {
    install -Dm644 -t "$pkgdir/etc/ananicy.d" 99-gnoblin.types 99-gnoblin.rules
}
