depends=('adwaita-cursors' 'dbus' 'dconf' 'gcr-4' 'glib2>=2.86.0' 'gsettings-desktop-schemas>=49.1' 'json-glib' 'libinput>=1.30.0' 'lua>=5.4' 'pipewire>=1.4.11' 'polkit' 'systemd-libs' 'wayland>=1.25' 'wireplumber' 'libcanberra' 'libdisplay-info' 'libei' 'libnm' 'polkit' 'startup-notification')
