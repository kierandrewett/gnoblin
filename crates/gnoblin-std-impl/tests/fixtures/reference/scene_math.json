  "scenario": "scene_math",
  "source": "import { Vector3, Ray, Plane } from 'gnoblin-core/math/vector';\nimport { Transform3D } from 'gnoblin-core/math/transform';\nimport { vectorFrom, rotationFrom, scaleFrom, transformFrom, eulerOfQuaternion } from 'gnoblin-core/math/spatial';\nconst r = (n: number) => Math.round(n * 1e10) / 1e10;\nconst v = (x: Vector3) => x.toArray().map(r);\nconst t = (p: Transform3D) => ({ position: v(p.position), rotation: v(p.rotation), scale: r(p.scale) });\nconst attempt = (f: () => unknown) => { try { return f(); } catch (e) { return 'throws: ' + (e as Error).message; } };\nconst rounded = (x: unknown): unknown => Array.isArray(x) ? x.map(rounded) : typeof x === 'number' ? r(x) : x;\nconst G = globalThis as any;\nG.vectorTable = () => {\nconst a = new Vector3(1, 2, 3); const b = new Vector3(-4, 5, 0.5); const z = new Vector3();\nreturn {\nadd: v(a.add(b)), subtract: v(a.subtract(b)), scale: v(a.scale(2.5)), dot: r(a.dot(b)), cross: v(a.cross(b)),\nlength: r(a.length()), normalize: v(a.normalize()), zero: attempt(() => v(z.normalize())), distance: r(a.distanceTo(b)),\nfrom: v(Vector3.from([7, 8, 9])), zeroes: v(Vector3.zero()), clone: v(a.clone()), array: a.toArray(),\nbad_from: attempt(() => v(Vector3.from([1, 2]))), bad_new: attempt(() => v(new Vector3(NaN, 0, 0))),\nparallel: v(new Vector3(0, 0, 2).cross(new Vector3(0, 0, 5))),\n};\n};\nG.rayTable = () => {\nconst plane = new Plane(new Vector3(0, 0, -2), new Vector3(0, 0, 1));\nconst hit = (o: number[], d: number[]) => {\nconst p = plane.intersect(new Ray(new Vector3(o[0], o[1], o[2]), new Vector3(d[0], d[1], d[2])));\nreturn p === null ? null : v(p);\n};\nconst tilted = new Plane(new Vector3(1, 1, 1), new Vector3(1, 1, 1)).intersect(new Ray(new Vector3(0, 0, 0), new Vector3(1, 1, 1)));\nreturn {\nat: v(new Ray(new Vector3(1, 1, 1), new Vector3(0, 0, -1)).at(3)),\nstraight: hit([0, 0, 0], [0, 0, -1]), slanted: hit([1, 2, 0], [0.5, -0.5, -1]), parallel: hit([0, 0, 0], [1, 0, 0]),\nbehind: hit([0, 0, -5], [0, 0, -1]), away: hit([0, 0, 0], [0, 0, 1]), on_plane: hit([3, 4, -2], [1, 0, 0]),\nunnormalised: hit([0, 0, 0], [0, 0, -4]), tilted: tilted === null ? null : v(tilted),\n};\n};\nG.poseTable = () => {\nconst rotations = [[0, 0, 0], [0.1, 0.2, 0.3], [Math.PI / 2, 0, 0], [0, Math.PI / 2, 0], [0, -Math.PI / 2, 0.3], [3, 2, 1], [0, 0, Math.PI], [-0.7, 1.2, -2.5]];\nconst out: unknown[] = [];\nfor (const rotation of rotations) {\nfor (const scale of [1, 2, 0.5]) {\nconst p = new Transform3D(new Vector3(1, -2, 3), rotation, scale);\nconst plane = p.plane();\nout.push({\nrotation: rotation.map(r), scale, euler: v(p.rotation), x: v(p.transformDirection(new Vector3(1, 0, 0))),\ny: v(p.transformDirection(new Vector3(0, 1, 0))), z: v(p.transformDirection(new Vector3(0, 0, 1))),\npoint: v(p.transformPoint(new Vector3(0.5, 0.25, -1))), plane: [v(plane.point), v(plane.normal)],\n});\n}\n}\nreturn out;\n};\nG.composeTable = () => {\nconst p = new Transform3D(new Vector3(1, 2, 3), [0.3, -0.4, 0.5], 2);\nconst q = new Transform3D(new Vector3(-1, 0.5, 2), [1, 0.2, -0.6], 0.5);\nconst probe = new Vector3(0.3, -0.2, 0.9);\nconst moved = p.clone(); moved.rotation = [0.1, 0.2, 0.3]; moved.position = new Vector3(9, 9, 9); moved.scale = 3;\nreturn {\nproduct: t(p.multiply(q)), reverse: t(q.multiply(p)), inverse: t(p.inverse()), round_trip: t(p.multiply(p.inverse())),\ninverse_point: v(p.inverse().transformPoint(p.transformPoint(probe))), identity: t(Transform3D.identity()),\ntranslation: t(Transform3D.translation(4, 5, 6)), clone: t(p.clone()), mutated_clone: t(moved), original: t(p),\n};\n};\nG.parseTable = () => {\nconst triples = [[1, 2, 3], { x: 1, y: 2, z: 3 }, [1, 2], [1, 2, 3, 4], [1, 'a', 3], [1, NaN, 3], [1, Infinity, 3], null, undefined, 'xyz', { x: 1, y: 2 }];\nconst rotations = [[0.1, 0.2, 0.3], { x: 0.1, y: 0.2, z: 0.3 }, { x: 0, y: Math.sin(0.25), z: 0, w: Math.cos(0.25) }, { x: 0, y: 0, z: 0, w: 1 },\n{ x: 1, y: 0, z: 0, w: 0 }, { x: 0.5, y: 0.5, z: 0.5, w: 0.5 }, { x: 0, y: 0, z: 0, w: 0 }, { x: 0, y: NaN, z: 0 }, 'turn', [1, 2]];\nconst scales = [2, [1, 2, 3], { x: 1, y: 2, z: 3 }, 0, -1, 'big', [1, 2], NaN];\nconst quaternions = [[0, 0, 0, 1], [Math.sin(Math.PI / 4), 0, 0, Math.cos(Math.PI / 4)], [0, Math.sin(Math.PI / 4), 0, Math.cos(Math.PI / 4)],\n[0, 0, Math.sin(Math.PI / 4), Math.cos(Math.PI / 4)], [0.1826, 0.3651, 0.5477, 0.7303], [0, 0.7071, 0, 0.7071], [0, 1, 0, 0]];\nreturn {\nvectors: triples.map((value) => attempt(() => rounded(vectorFrom('target', value)))),\nrotations: rotations.map((value) => attempt(() => rounded(rotationFrom('target', value)))),\nscales: scales.map((value) => attempt(() => rounded(scaleFrom('target', value)))),\nquaternions: quaternions.map(([x, y, z, w]) => rounded(eulerOfQuaternion({ x, y, z, w }))),\n};\n};\nG.transformTable = () => {\nconst inits = [{ position: { x: 5, y: 6, z: 7 } }, { rotation: [0, 0.5, 0] }, { scale: 2 }, { position: [1, 2, 3], rotation: { x: 0, y: 0, z: 0, w: 1 }, scale: [1, 2, 3] },\n{}, { pose: 1 }, { position: [0, 0, 0], pose: 1 }, { position: { x: 9, y: 9, z: 9 }, rotation: { x: 'no', y: 0, z: 0 } }, 5, null];\nreturn inits.map((init) => attempt(() => rounded(transformFrom('target', init))));\n};\n",
