{
  "scenario": "ui_text",
  "source": "const holder = new Box({ width: 400, height: 400 });\nconst put = (y: number, w: Canvas) => { w.y = y; holder.add(w); return w; };\nconst t1 = put(0, new Text({ text: 'Hello', size: 10 }));\nconst multi = put(20, new Text({ text: 'a\\nbbbb\\ncc', size: 10 }));\nconst roomy = put(80, new Text({ text: 'A long window title', size: 10, ellipsize: true }));\nconst cut = put(100, new Text({ text: 'A long window title', size: 10, ellipsize: true, width: 50 }));\nconst plain = put(120, new Text({ text: 'A long window title', size: 10, width: 50 }));\nconst mono = put(140, new Text({ text: 'ab', size: 13, color: '#c6d0f5', font: 'mono' }));\nconst squeezed = put(160, new Text({ text: 'ab', size: 13, height: 13 }));\nconst wide = put(180, new Text({ text: 'h\\u00e9llo w\\u00f6rld \\u2713', size: 16 }));\nconst empty = put(210, new Text({ text: '', size: 12 }));\nconst icon = put(230, new Icon({ icon: 'window-close-symbolic', size: 16, color: '#fff' }));\nconst iconDefault = put(260, new Icon({ icon: 'folder' }));\nconst texts = [t1, multi, roomy, cut, plain, mono, squeezed, wide, empty];\nconst metrics = () => texts.map((t) => [t.width, t.height, t.ascent, t.shown()]);\nObject.assign(globalThis, { holder, t1, metrics, icon, iconDefault });",
