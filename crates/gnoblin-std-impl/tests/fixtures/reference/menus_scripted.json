{
  "scenario": "menus_scripted",
  "source": "startDecorations(); startWindowMenu();\nglobalThis.sel = () => windowMenu.current ? [windowMenu.current.nav.depth, windowMenu.current.nav.selected()?.label ?? null] : null;\nglobalThis.card = () => { const m = windowMenu.current; if (!m) return null; const p = m.panel;\nreturn { x: p.x, y: p.y, width: p.width, height: p.height, secure: [p.secure, m.secure], rows: p.rows.map((r) => [r.label, r.enabled, r.checked]) }; };\nglobalThis.row = (label) => windowMenu.current.panel.rows.find((r) => r.label === label).node;\n\nglobalThis.ran = [];\nwindowMenu.items = () => [{ label: 'Only', run: (w) => globalThis.ran.push(w.title) }, { separator: true }, { label: 'Off', enabled: false }];\n",
