{
  "scenario": "input_drags",
  "source": "gnoblin.workspaces.add(new Workspace({ id: 'main', layout: 'monocle' }));\nglobalThis.input = gnoblin.input.primary;\nclass Probe extends PointerDragBinding {\nlabel: string;\nconstructor(label: string, trigger: string) { super({ id: label, trigger }); this.label = label; }\nonStart(e: any) { rec('start', [this.label, e.client?.id, e.position.x, e.position.y]); return { n: 0 }; }\nonUpdate(e: any, s: any) { s.n++; rec('update', [this.label, e.position.x, e.position.y]); }\nonEnd(e: any, s: any) { rec('end', [this.label, s.n]); }\nonCancel(e: any, s: any) { rec('cancel', [this.label, s.n]); }\n}\n(globalThis as any).Probe = Probe;\nglobalThis.layout = new FloatingLayout();\ngnoblin.workspaces.get('main').layout = globalThis.layout;\nclass G extends GestureBinding {\nlabel: string;\nconstructor(trigger: string, label: string) { super({ id: trigger, trigger }); this.label = label; }\nonStart(e: any) { rec('g.start', [this.label, e.progress]); return {}; }\nonUpdate(e: any) { rec('g.update', [this.label, e.progress]); }\nonEnd(e: any) { rec('g.end', [this.label, e.progress]); }\nonCancel() { rec('g.cancel', [this.label]); }\n}\ninput.bind('Swipe3Left', new G('Swipe3Left', 'left'));\ninput.bind('Swipe3Right', new G('Swipe3Right', 'right'));\n",
