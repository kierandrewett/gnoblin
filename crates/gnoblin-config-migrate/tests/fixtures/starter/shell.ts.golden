gnoblin.workspaces.add(new Workspace({ id: "1", name: "Workspace 1", layout: new FloatingLayout() }));
gnoblin.workspaces.add(new Workspace({ id: "2", name: "Workspace 2", layout: new FloatingLayout() }));
gnoblin.workspaces.add(new Workspace({ id: "3", name: "Workspace 3", layout: new FloatingLayout() }));
gnoblin.workspaces.add(new Workspace({ id: "4", name: "Workspace 4", layout: new FloatingLayout() }));

