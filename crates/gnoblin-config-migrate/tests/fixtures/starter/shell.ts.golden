// From config/40-shortcuts.lua.
input.bind("XF86AudioRaiseVolume", () => {
    gnoblin.spawn(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "5%+"]);
});
input.bind("XF86AudioLowerVolume", () => {
    gnoblin.spawn(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "5%-"]);
});
input.bind("XF86AudioMute", () => {
    gnoblin.spawn(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"]);
});
input.bind("XF86AudioMicMute", () => {
    gnoblin.spawn(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"]);
});
input.bind("XF86AudioPlay", () => {
    gnoblin.spawn(["playerctl", "play-pause"]);
});
input.bind("XF86AudioNext", () => {
    gnoblin.spawn(["playerctl", "next"]);
});
input.bind("XF86AudioPrev", () => {
    gnoblin.spawn(["playerctl", "previous"]);
});
