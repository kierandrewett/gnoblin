# shellcheck shell=bash disable=SC2034,SC2154
pkgname=gnoblin-vr
pkgver=0.1.0
pkgrel=1
pkgdesc='Optional OpenXR presentation client for Gnoblin'
arch=('x86_64')
url='https://github.com/kierandrewett/gnoblin/tree/main/extensions/gnoblin-vr'
license=('GPL-2.0-or-later')
depends=('glib2' 'openxr' 'libdrm' 'systemd-libs')
optdepends=('monado: tethered headsets (Index, Vive, PSVR2)'
    'wivrn-server: standalone headsets (Quest, Pico) over USB or Wi-Fi'
    'android-tools: USB link to standalone headsets')
makedepends=('cmake' 'gcc' 'pkgconf' 'python')
source=("gnoblin::git+https://github.com/kierandrewett/gnoblin.git")
b2sums=('SKIP')

build() {
    cmake -S "$srcdir/gnoblin/extensions/gnoblin-vr" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build" --parallel
}

check() {
    ctest --test-dir "$srcdir/build" --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
