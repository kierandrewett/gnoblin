# gnoblin gnome-shell overlay manifest — files copied verbatim into the
# gnome-shell submodule before the patch series is applied (scripts/copy-overlay.sh).
# Columns: <project> <source (rel to this dir)> <dest (rel to subproject root)>
#
# gnoblin's own shell code lives here as real, navigable source (NOT buried in
# patches). The only upstream edit is a one-line <file> entry in the JS gresource
# (patches/gnome-shell/30-gnoblin-control) so gnome-shell bundles + can import it;
# enabling is done purely via the `gnoblin` session mode's components list.
gnome-shell  js/ui/components/gnoblinControl.js  js/ui/components/gnoblinControl.js
gnome-shell  js/ui/components/gnoblinConfig.js  js/ui/components/gnoblinConfig.js
gnome-shell  js/ui/components/gnoblinRules.js  js/ui/components/gnoblinRules.js
gnome-shell  js/ui/components/gnoblinLayerAnimation.js  js/ui/components/gnoblinLayerAnimation.js
gnome-shell  shell-gnoblin-shader.c  src/shell-gnoblin-shader.c
gnome-shell  shell-gnoblin-shader.h  src/shell-gnoblin-shader.h
gnome-shell  js/ui/components/gnoblinBackdropRedraw.js  js/ui/components/gnoblinBackdropRedraw.js
gnome-shell  js/ui/components/gnoblinCornerGeometry.js  js/ui/components/gnoblinCornerGeometry.js
gnome-shell  js/ui/components/gnoblinCorners.js  js/ui/components/gnoblinCorners.js
