[Unit]
Description=Gnoblin idle and screen saver inhibition
After=graphical-session.target
Requisite=graphical-session.target
Before=xdg-desktop-autostart.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.ScreenSaver
ExecStart=@PREFIX@/libexec/gnoblin-idle
Restart=on-failure
RestartSec=1
# Status 1 means another screen saver owns the name. Trying again would not change that.
RestartPreventExitStatus=1
