-- Portal permission rules match verified identities such as app-id:org.example.App
-- or host-exe:/usr/bin/example. A matching deny always wins.
-- gnoblin.permission_rule {
--     name = "example-screen-share",
--     match = "^app-id:org\\.example\\.App$",
--     capabilities = {"screen-cast"}, -- screen-cast, remote-desktop, input-capture, screenshot, access
--     level = "ask", -- default, ask, allow, deny
--     monitors = {"primary"}, -- screen-cast/remote-desktop only
--     devices = {"keyboard", "pointer", "touchscreen"}, -- remote-desktop only
--     clipboard = false, -- remote-desktop only
-- }

-- Add a command shortcut, or use an imported name to change its fields.
-- gnoblin.configure {shortcuts = {terminal = {binding = "<Super>Return", command = {"ptyxis"}}}}
-- gnoblin.configure.shortcuts.terminal.enable = false
