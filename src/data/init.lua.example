-- gnoblin.configure {autostart = {bar = {command = {"waybar"}}}}
-- gnoblin.configure.autostart.bar.enable = false

-- Advanced input overrides. Most people should leave these commented out:
-- Gnoblin then follows each tablet/pen's existing settings and the system's
-- rotation setting. IDs only identify a device you want to change.
-- gnoblin.configure {
--     input = {
--         tablets = {
--             ["1234:5678"] = {
--                 mapping = "absolute", -- or "relative"
--                 left_handed = false,
--                 keep_aspect = true,
--             },
--         },
--         styluses = {
--             ["default-1234:5678"] = { -- or a pen's hex serial number
--                 button_action = "default",
--                 secondary_button_action = "default",
--                 tertiary_button_action = "default",
--                 button_keybinding = "",
--                 secondary_button_keybinding = "",
--                 tertiary_button_keybinding = "",
--             },
--         },
--         orientation_lock = true, -- true/false overrides the system setting
--     },
-- }
-- Pen button actions: "default", "middle", "right", "back", "forward",
-- "switch-monitor", or "keybinding" (with the matching keybinding string).

-- Split this file into modules as the config grows. Paths are relative to the
-- Lua file making the load call; globs are sorted and recursive.
