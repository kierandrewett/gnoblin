-- Copy to ~/.config/gnoblin/init.lua.
-- Load component settings before your overrides.
gnoblin.load("/usr/share/gnoblin/conf.d/*.lua")
gnoblin.load("conf.d/**/*.lua")

gnoblin.configure {
    shell = {
        window_switcher = false,
        minimize_animation = "zoom",
        minimize_duration = 150,
    },
}

-- Rules apply in declaration order.
gnoblin.window_rule {
    match = {type = "window", focused = false},
    opacity = 0.95,
}

-- Reuse an imported shortcut's name to override only the fields you supply.
-- gnoblin.shortcut {name = "terminal", command = {"ptyxis", "--new-window"}}
-- gnoblin.remove_shortcut("terminal")

-- Start a program once per login, unless a service already starts it.
-- gnoblin.autostart {name = "bar", command = {"waybar"}}

