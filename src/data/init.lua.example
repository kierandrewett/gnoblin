-- Gnoblin's complete Lua configuration reference.
-- This file is copied to ~/.config/gnoblin/init.lua on first login only when
-- no init.lua, gnoblin.toml, or gnoblin.conf already exists. Edit and save it;
-- Gnoblin reloads valid changes automatically.
-- Full reference: https://gnoblin.org/configuration-reference/

-- Load shell/component defaults first. Files are evaluated in sorted order;
-- your values below then override imported values.
gnoblin.load("/usr/share/gnoblin/conf.d/*.lua")
gnoblin.load("conf.d/**/*.lua")

gnoblin.configure {
    -- Cursor changes are optional. Gnoblin includes this artwork; install
    -- other Hyprcursor themes before selecting them.
    cursor = {},
    -- cursor = {theme = "Adwaita-Hyprcursor", size = 24}, -- size: 1..256

    -- Window focus, placement, workspaces and titlebar actions.
    window_management = {
        focus_mode = "click", -- "click", "sloppy", "mouse"
        focus_new_windows = "smart", -- Set to "strict" to prevent focus stealing.
        raise_on_click = true,
        auto_raise = false,
        auto_raise_delay = 500, -- milliseconds, 0..10000
        focus_change_on_pointer_rest = false,
        dynamic_workspaces = false,
        num_workspaces = 4, -- 1..36; used when dynamic_workspaces is false
        workspace_names = {}, -- up to 36 strings, in workspace order
        workspace_ids = {}, -- up to 36 unique stable IDs, in workspace order
        workspaces_only_on_primary = false,
        edge_tiling = false,
        center_new_windows = false,
        attach_modal_dialogs = false,
        constrain_drag_to_work_area = true,

        -- GTK apps often draw their own titlebars and read GNOME settings.
        -- These Lua actions control Mutter's titlebar handling and Gnoblin's
        -- built-in fallback SSD, which implements the actions. A custom SSD
        -- must implement titlebar controls itself.
        action_double_click_titlebar = "toggle-maximize",
        action_middle_click_titlebar = "lower",
        action_right_click_titlebar = "menu",
        -- Actions: "toggle-maximize", "toggle-maximize-horizontally",
        -- "toggle-maximize-vertically", "minimize", "lower", "menu", "none".
    },

    -- General compositor interaction preferences. Accessibility settings are
    -- managed separately.
    compositor = {
        enable_animations = true,
        locate_pointer = false,
        visual_bell = false,
        audible_bell = true,
        visual_bell_type = "fullscreen-flash", -- or "frame-flash"
    },

    -- Input works automatically with your device/system settings. Only add
    -- fields below when you want to change their behavior. Tablets and pens
    -- need no device IDs, and screen rotation follows the system setting.
    input = {
        mouse = {
            -- speed = 0.0, -- -1..1
            -- left_handed = false,
            -- natural_scroll = false,
            -- accel_profile = "adaptive", -- "default", "flat", "adaptive"
        },
        touchpad = {
            -- speed = 0.0, -- -1..1
            -- scroll_speed = 1.0, -- 0..2; 1 is the default, 0.5 is half speed
            -- left_handed = "mouse", -- "right", "left", "mouse"
            -- natural_scroll = true,
            -- accel_profile = "adaptive", -- "default", "flat", "adaptive"
            -- tap_to_click = false,
            -- tap_button_map = "default", -- "default", "lrm", "lmr"
            -- tap_and_drag = true,
            -- tap_and_drag_lock = false,
            -- disable_while_typing = true,
            -- edge_scrolling_enabled = false,
            -- two_finger_scrolling_enabled = true,
            -- click_method = "default", -- "default", "none", "areas", "fingers"
        },
        keyboard = {
            -- ["repeat"] = true,
            -- delay = 500, -- milliseconds, 1..10000
            -- repeat_interval = 30, -- milliseconds, 1..10000
            -- remember_numlock_state = true,
            -- numlock_state = false, -- in-memory while this config is active
            -- xkb_options = {"caps:escape"}, -- overrides the current XKB options
        },
        -- Advanced tablet, pen, and rotation overrides are shown below.
    },

    -- Keep the GNOME session's configured sources unless you intentionally
    -- replace them. IDs come from the input-source catalogue on your system.
    -- This table replaces the active source list in memory on reload.
    -- input_sources = {
    --     sources = {
    --         {type = "xkb", id = "us"},
    --         {type = "ibus", id = "anthy"},
    --     },
    --     per_window = false,
    -- },

    -- Define swipe gestures as paths relative to their start point.
    -- Commands and direct actions can use multi-point paths with turns.
    touchpad_gestures = {
        {name = "workspace-previous", gesture = "swipe", fingers = 3, path = {{x = 0, y = 0}, {x = 1, y = 0}},
            action = "workspace.progress", when = "normal"},
        {name = "workspace-next", gesture = "swipe", fingers = 3, path = {{x = 0, y = 0}, {x = -1, y = 0}},
            action = "workspace.progress", when = "normal"},
        {name = "emoji-page-previous", gesture = "swipe", fingers = 3, path = {{x = 0, y = 0}, {x = 1, y = 0}},
            action = "emoji-pager.progress", when = "emoji-picker"},
        {name = "emoji-page-next", gesture = "swipe", fingers = 3, path = {{x = 0, y = 0}, {x = -1, y = 0}},
            action = "emoji-pager.progress", when = "emoji-picker"},
        {name = "unlock-screen-up", gesture = "swipe", fingers = 3, path = {{x = 0, y = 0}, {x = 0, y = -1}},
            action = "unlock-screen.progress", when = "unlock-screen"},
        {name = "unlock-screen-down", gesture = "swipe", fingers = 3, path = {{x = 0, y = 0}, {x = 0, y = 1}},
            action = "unlock-screen.progress", when = "unlock-screen"},
        -- Add a command gesture, for example:
        -- {name = "open-terminal", gesture = "pinch", fingers = 4, direction = "out",
        --     command = {"kgx"}, when = "normal"},
    },

    -- Shell transitions and built-in shell features.
    shell = {
        minimize_animation = {minimize = "gnome-minimize", restore = "gnome-restore"},
        layer_animation = {["layer-open"] = "gnoblin-layer-open", ["layer-close"] = "gnoblin-layer-close"},
        window_menu = gnoblin.array {}, -- argv for your shell's window-menu handler
        window_switcher = false,
        -- These supported saved preferences are opt-in. Leave them unset to
        -- preserve their current state.
        -- notifications = true,
        -- input_source_switcher = true,
    },

    -- Portal policy. The global fallback may be "default", "ask", or "deny";
    -- global "allow" is refused. Rules can scope screen/remote desktop access.
    permissions = {
        default = "default",
        rules = {}, -- up to 256 rules; see the example below
    },

    -- These take effect at the next login. Use an empty table to keep the
    -- compositor's built-in protocol defaults.
    protocols = {},
    -- Protocol switches are booleans. Available names:
    -- wlr_layer_shell, wlr_screencopy, ext_foreign_toplevel_list,
    -- wlr_foreign_toplevel_management, xdg_decoration, window_frame_renderer,
    -- ext_data_control, ext_idle_notify, wlr_gamma_control,
    -- wlr_output_power_management, ext_background_effect_v1, blur_fade,
    -- ext_session_lock.

    -- Layer-shell clients can preserve the active app when they appear.
    layer_shell = {
        preserve_active_window = true,
    },

    -- Frame renderers are named argv commands. The built-in renderer is
    -- "native" and cannot be replaced by a service registration.
    frame_renderers = {},
    -- Example: frame_renderers = {
    --     cairo = {"gnoblin-frame-cairo", "--theme-file=frame-theme.txt"},
    -- },

    -- Shortcuts use stable names. Use the same name to change an imported
    -- entry; fields you omit keep their earlier values. Set enable = false
    -- to disable one. Built-in actions use a GNOME keybinding name.
    shortcuts = {
        screenshot = {action = "gnome:shell.show_screenshot_ui", binding = {"Print"}},
        ["volume-up"] = {binding = "XF86AudioRaiseVolume", command = {"wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "5%+"}},
        ["volume-down"] = {binding = "XF86AudioLowerVolume", command = {"wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "5%-"}},
        ["volume-mute"] = {binding = "XF86AudioMute", command = {"wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"}},
        ["microphone-mute"] = {binding = "XF86AudioMicMute", command = {"wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"}},
        ["brightness-up"] = {binding = "XF86MonBrightnessUp", command = {"brightnessctl", "set", "5%+"}},
        ["brightness-down"] = {binding = "XF86MonBrightnessDown", command = {"brightnessctl", "set", "5%-"}},
        ["media-play-pause"] = {binding = "XF86AudioPlay", command = {"playerctl", "play-pause"}},
        ["media-next"] = {binding = "XF86AudioNext", command = {"playerctl", "next"}},
        ["media-previous"] = {binding = "XF86AudioPrev", command = {"playerctl", "previous"}},
        files = {binding = "<Super>e", command = {"sh", "-c", 'gio open "$HOME"'}},
    },

    -- Start each named command once per login. Commands are argv arrays, not
    -- shell strings; use a script path if shell syntax is required.
    -- autostart = {bar = {command = {"waybar"}}},

    -- Add ordered window rules here. Later matching rules override fields they
    -- specify. Use gnoblin.window_rule to append; uncomment to replace the list.
    -- window_rules = {},
}

-- Register custom transitions once and reuse them by name in shell settings
-- or window rules. See /guides/animations for events and preview controls.
