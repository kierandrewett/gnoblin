# gnoblin.toml: live shell settings and startup Wayland protocol settings.
# Location: $GNOBLIN_CONFIG, else $XDG_CONFIG_HOME/gnoblin/gnoblin.toml.
# The shell watches saves automatically. Manual reload: gnoblinctl reload-config.
# Invalid shell settings retain the last valid configuration.

[shell]
# Native GNOME Alt+Tab and related window switchers are opt-in.
window-switcher = false
# zoom uses the dock icon, then minimize-target, then monitor bottom-centre.
# Alternatives: "fade", "none", or "gnome" (native GNOME fallback).
minimize-animation = "zoom"
minimize-duration = 200
layer-animation = "slide"
layer-duration = 220
layer-easing = "ease-out-cubic"
# Optional fallback in logical desktop coordinates:
# minimize-target = [960, 1040]
# Optional persistent feature settings. Omitted entries keep their current state.
# osd = false
# osd-volume = true
# osd-microphone = true
# osd-brightness = true
# osd-keyboard-brightness = true
# osd-pad = true
# screenshot = true
# notifications = false
# Keep GNOME's own layout popup off when Bingux owns the keyboard-layout UI.
# input-source-switcher = false

# Protocol changes require a new compositor session.
[protocols]
# Each key gates one Wayland protocol overlay. true (default) = advertised;
# false = not registered, so clients can't bind it.
wlr-layer-shell                 = true   # layer-shell chrome (bars/docks/etc.); the
                                         #   whole point — leave on unless debugging
wlr-screencopy                  = true   # grim-style screen capture
ext-idle-notify                 = true   # idle notifications (swayidle etc.)
ext-foreign-toplevel-list       = true   # window list for taskbars
wlr-foreign-toplevel-management = true   # window control for taskbars
wlr-gamma-control               = true   # night-light via wlsunset
wlr-output-power-management     = true   # DPMS via wlr clients
ext-data-control                = true   # clipboard managers (cliphist)

# Named autostart entries run once per name per login, including new entries
# added on reload. Use either this or an existing systemd service, not both.
# [[autostart]]
# name = "bingux"
# command = ["qs", "-c", "bingux"]

# Compositor effects reload live after the rebuilt stack's first login.
[[window-rules]]
match.type = "layer"
blur = 24
opacity = 0.96

# Shortcut changes apply live. Commands are argument arrays, not shell syntax.
# Release any conflicting built-in binding before assigning its keys.
# [keybindings.shell]
# show-screenshot-ui = []
# [[shortcuts]]
# name = "capture"
# binding = "<Alt>s"
# command = ["qs", "ipc", "--any-display", "-c", "bingux", "call", "capture", "open"]
# [keybindings.wm]
# close = ["<Super>q"]

# Built-in rounding: app/focus exceptions use the same window-rule matchers.
# See docs/window-effects.md for borders, shadows, padding and state settings.
# [[window-rules]]
# match.type = "window"
# corners = { radius = 14, smoothing = 0.6 }
# corners.shadow-animation = { duration = 180, easing = "ease-out-cubic" }
# [[window-rules]]
# match.app-id = "^my-game$"
# corners.mode = "off"

# Optional desktop-owned double border. Disabled unless a rule enables it.
# [[window-rules]]
# match.type = "window"
# Use outer-width = 0 for an outline entirely inside the client bounds.
# borders = { inner-width = 1, inner-color = "#505050ff", outer-width = 0, outer-color = "#00000000", radius = 12, smoothing = 0.0, keep-fullscreen = false }

# Portal consent policy. See docs/permissions.md for supported gates and identities.
[permissions]
default = "default"

# Uncomment and adjust the verified identity to permit unattended capture.
# [[permissions.rules]]
# name = "rustdesk"
# match = '^host-exe:/usr/bin/rustdesk$'
# capabilities = ["screen-cast", "remote-desktop"]
# level = "allow"
# monitors = ["primary"]
# devices = ["keyboard", "pointer"]
# clipboard = true
