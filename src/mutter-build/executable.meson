# Gnoblin: the monolithic compositor. It replaces Mutter's own `mutter` executable: the Gnoblin session, the Lua
# runtime and the diagnostic console link into the compositor process. src/meson.build includes this directory after
# libmutter_dep exists.

gnoblin_python = find_program('python3')
gnoblin_root = run_command(
  gnoblin_python, '-c', 'import os; print(os.environ["GNOBLIN_SOURCE_ROOT"])',
  check: true).stdout().strip()
gnoblin_prefix = run_command(
  gnoblin_python, '-c', 'import os; print(os.environ["GNOBLIN_PREFIX"])',
  check: true).stdout().strip()
gnoblin_fs = import('fs')
gnoblin_lua_dep = dependency('lua5.4', required: false)
if not gnoblin_lua_dep.found()
  gnoblin_lua_dep = dependency('lua-5.4', required: false)
endif
if not gnoblin_lua_dep.found()
  gnoblin_lua_dep = dependency('lua54', required: false)
endif
if not gnoblin_lua_dep.found()
  gnoblin_lua_dep = dependency('lua', required: false)
endif
if not gnoblin_lua_dep.found()
  error('Gnoblin requires Lua 5.4 development files')
endif
gnoblin_json_dep = dependency('json-glib-1.0')

gnoblin_api_header = gnoblin_fs.read(gnoblin_root / 'src/control/gnoblin-native-control.h')
gnoblin_api_major = ''
gnoblin_api_minor = ''
foreach api_line : gnoblin_api_header.split('\n')
  if api_line.startswith('#define GNOBLIN_NATIVE_CONTROL_API_MAJOR ')
    gnoblin_api_major = api_line.split().get(2)
  elif api_line.startswith('#define GNOBLIN_NATIVE_CONTROL_API_MINOR ')
    gnoblin_api_minor = api_line.split().get(2)
  endif
endforeach
if gnoblin_api_major == '' or gnoblin_api_minor == ''
  error('Could not read the Gnoblin native control API version')
endif

gnoblin_default_config = custom_target('gnoblin-default-config',
  input: files(
    gnoblin_root / 'data/default-config/init.lua',
    gnoblin_root / 'data/default-config/config/10-windows.lua',
    gnoblin_root / 'data/default-config/config/20-input.lua',
    gnoblin_root / 'data/default-config/config/30-session.lua',
    gnoblin_root / 'data/default-config/config/40-shortcuts.lua',
    gnoblin_root / 'data/default-config/config/50-pointer.lua',
  ),
  output: 'gnoblin-default-config.c',
  command: [gnoblin_python, gnoblin_root / 'scripts/embed-config.py',
            gnoblin_root / 'data/default-config', '@OUTPUT@'],
)

gnoblin_config_sources = files(
  gnoblin_root / 'src/config/gnoblin-config-input.c',
  gnoblin_root / 'src/config/gnoblin-config-windows.c',
  gnoblin_root / 'src/config/gnoblin-config-portal.c',
  gnoblin_root / 'src/config/gnoblin-config-keybindings.c',
  gnoblin_root / 'src/config/gnoblin-config-validate.c',
  gnoblin_root / 'src/config/gnoblin-config.c',
  gnoblin_root / 'src/config/gnoblin-config-salvage.c',
  gnoblin_root / 'src/input/gnoblin-input-config.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-variant.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-merge.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-subscriptions.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-operation.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-process.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-request.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-objects.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-tween.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-find.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-operations.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-contexts.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-animation.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-input.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-extension.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-named.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-queries.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-state-queries.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-install.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-runtime.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-dispatch.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-console.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-read.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-finish.c',
  gnoblin_root / 'src/config/lua/gnoblin-lua-pattern.c',
  gnoblin_root / 'src/config/gnoblin-glob.c',
  gnoblin_root / 'src/input/gnoblin-keybinding-catalog.c',
)
gnoblin_session_sources = files(
  gnoblin_root / 'src/main.c',
  gnoblin_root / 'src/session/gnoblin-runtime-diagnostics.c',
  gnoblin_root / 'src/session/gnoblin-runtime-environment.c',
  gnoblin_root / 'src/session/gnoblin-runtime-packets.c',
  gnoblin_root / 'src/session/gnoblin-runtime-events.c',
  gnoblin_root / 'src/session/gnoblin-runtime-compositor.c',
  gnoblin_root / 'src/session/gnoblin-runtime-worker.c',
  gnoblin_root / 'src/session/gnoblin-runtime-autostart.c',
  gnoblin_root / 'src/session/gnoblin-runtime-supervisor.c',
  gnoblin_root / 'src/session/gnoblin-runtime.c',
  gnoblin_root / 'src/session/gnoblin-autostart.c',
  gnoblin_root / 'src/session/gnoblin-runtime-spawn.c',
  gnoblin_root / 'src/session/gnoblin-priority.c',
  gnoblin_root / 'src/control/gnoblin-runtime-protocol.c',
)
gnoblin_include_dirs = include_directories(
  gnoblin_root / 'src/config', gnoblin_root / 'src/config/lua', gnoblin_root / 'src/session',
  gnoblin_root / 'src/portal/backend', gnoblin_root / 'src/input',
  gnoblin_root / 'src/control',
)
gnoblin_diagnostic_sources = files(
  gnoblin_root / 'src/compositor/plugin/gnoblin-plugin.c',
  gnoblin_root / 'src/compositor/plugin/gnoblin-plugin-ui.cpp',
  gnoblin_root / 'src/compositor/plugin/gnoblin-debug-panel.cpp',
  gnoblin_root / 'src/compositor/plugin/gnoblin-recovery-panel.cpp',
  gnoblin_root / 'src/compositor/plugin/gnoblin-console-panel.cpp',
  gnoblin_root / 'src/compositor/plugin/gnoblin-imgui-overlay.cpp',
  gnoblin_root / 'subprojects/imgui/imgui.cpp',
  gnoblin_root / 'subprojects/imgui/imgui_draw.cpp',
  gnoblin_root / 'subprojects/imgui/imgui_tables.cpp',
  gnoblin_root / 'subprojects/imgui/imgui_widgets.cpp',
)
gnoblin_diagnostic_includes = include_directories(
  gnoblin_root / 'src/compositor/plugin',
  gnoblin_root / 'subprojects/imgui',
)
gnoblin = executable('gnoblin',
  sources: [files('../core/mutter.c'), gnoblin_default_config] +
    gnoblin_config_sources + gnoblin_session_sources + gnoblin_diagnostic_sources,
  include_directories: [mutter_includes, gnoblin_include_dirs, gnoblin_diagnostic_includes],
  c_args: mutter_c_args + [
    '-DG_LOG_DOMAIN="gnoblin"',
    '-DGNOBLIN_NATIVE_CONTROL_API_MAJOR=' + gnoblin_api_major,
    '-DGNOBLIN_NATIVE_CONTROL_API_MINOR=' + gnoblin_api_minor,
    '-DGNOBLIN_DEFAULT_COMPOSITOR="' + gnoblin_prefix / 'bin/gnoblin' + '"',
  ],
  dependencies: [libmutter_dep, mutter_deps, gnoblin_lua_dep, gnoblin_json_dep],
  install_rpath: '$ORIGIN/../' + get_option('libdir') + ':$ORIGIN/../' + get_option('libdir') / 'mutter-51',
  install_dir: bindir,
  install: true,
)
