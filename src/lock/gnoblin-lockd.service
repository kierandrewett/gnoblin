[Unit]
Description=Gnoblin opt-in session lock policy broker
Documentation=man:gnoblin-lockd(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@PREFIX@/libexec/gnoblin-lockd
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
