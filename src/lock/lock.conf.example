# The broker is disabled by default.  Do not enable it until the compositor's
# ext-session-lock-v1 implementation has passed the hardware checklist.
[Lock]
Enabled=false

# The native compositor coordinator owns the fixed trusted Bingux launcher and
# admits its PID. The broker never starts an arbitrary lock command.

# 0 disables idle locking. A positive value uses Mutter's compositor-global
# IdleMonitor, never a broker wall-clock timer. It honours broker inhibitors.
IdleTimeoutSeconds=0

# Keep false while GNOME ScreenShield owns these names. When true, names are
# still acquired only after the native coordinator advertises Capability>=1 and
# LauncherReady=true. This does not enable the service or cut over the session.
OwnCompatibilityNames=false
