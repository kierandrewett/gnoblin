#!/usr/bin/env python3
"""Small human-facing control client for the opt-in Gnoblin lock broker."""

from __future__ import annotations

import sys

from gi.repository import Gio, GLib

BUS_NAME = "org.gnoblin.Lock"
OBJECT_PATH = "/org/gnoblin/Lock"
INTERFACE = "org.gnoblin.Lock"


def call(method: str, signature: str = "", values: tuple = ()):
    connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    return connection.call_sync(BUS_NAME, OBJECT_PATH, INTERFACE, method,
                                GLib.Variant(f"({signature})", values) if signature else None,
                                None, Gio.DBusCallFlags.NONE, 5000, None)


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] not in {"lock", "get-state"}:
        print("usage: gnoblin-lockctl lock [reason] | get-state", file=sys.stderr)
        return 2
    if argv[1] == "lock":
        call("Lock", "s", (argv[2] if len(argv) > 2 else "manual",))
        return 0
    print(call("GetState").unpack()[0])
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
