#!/usr/bin/env python3
"""Control Gnoblin, its windows and live shell settings."""

import argparse
import json
import os
import re
from pathlib import Path
import shutil
import socket
import sys
import time
import uuid


class CommandError(Exception):
    pass


def gnoblin_version():
    """Return the installed Gnoblin SemVer without depending on the live shell."""
    script = Path(__file__).resolve()
    candidates = []
    if override := os.environ.get("GNOBLIN_VERSION_FILE"):
        candidates.append(Path(override))
    candidates.extend((script.parent.parent / "share/gnoblin/version.json", script.parents[2] / "gnoblin-version.json"))
    for candidate in candidates:
        try:
            version = json.loads(candidate.read_text())["version"]
        except (FileNotFoundError, KeyError, ValueError):
            continue
        if isinstance(version, str):
            return version
    return "unknown"


def default_lua_config():
    """Read the example shipped with this installation, without contacting the shell."""
    script = Path(__file__).resolve()
    candidates = [
        script.parent.parent / "share/gnoblin/init.lua.example",
        script.parents[2] / "src/data/init.lua.example",
    ]
    data_dirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    candidates.extend(Path(directory) / "gnoblin/init.lua.example" for directory in data_dirs.split(":") if directory)
    for candidate in candidates:
        try:
            return candidate.read_text(encoding="utf-8")
        except FileNotFoundError:
            continue
        except OSError as error:
            raise CommandError(f"Cannot read default Lua config at {candidate}: {error.strerror}") from None
    raise CommandError("Default Lua config not found; install the Gnoblin session config package")


def capture_accelerator(wait_seconds, socket_path):
    """Ask Gnoblin to capture a key and return its GTK accelerator name."""
    print("Press a shortcut now; Escape cancels.", file=sys.stderr, flush=True)
    result = api_call("shortcut.capture", {"timeout": wait_seconds}, socket_path, wait_seconds + 2)
    return result["accelerator"]


def version_record(shell_version):
    return {
        "gnomeVersion": str(shell_version).removesuffix("-gnoblin"),
        "gnoblinVersion": gnoblin_version(),
        "shellVersion": shell_version,
    }


def number(low, high):
    def parse(value):
        try:
            result = int(value)
        except ValueError:
            raise argparse.ArgumentTypeError("must be an integer") from None
        if not low <= result <= high:
            raise argparse.ArgumentTypeError(f"must be between {low} and {high}")
        return result

    return parse


