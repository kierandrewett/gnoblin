def user_config_path():
    override = os.environ.get("GNOBLIN_CONFIG")
    if override:
        return Path(override).expanduser()
    directory = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "gnoblin"
    for name in ("init.lua", "gnoblin.toml", "gnoblin.conf"):
        candidate = directory / name
        if candidate.exists():
            return candidate
    return directory / "init.lua"


def compositor(request, path, timeout=5):
    identity = uuid.uuid4().hex
    deadline = time.monotonic() + timeout
    payload = dict(request)
    payload.setdefault("op", "command")
    payload["id"] = identity
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(timeout)
        try:
            connection.connect(path)
        except OSError as error:
            raise CommandError(
                f"Cannot connect to compositor socket {path}: {error.strerror}. Check that a Gnoblin session is running and that the socket path is correct."
            ) from None
        connection.sendall((json.dumps(payload) + "\n").encode())
        buffer = b""
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("Compositor request timed out; it was not retried")
            connection.settimeout(remaining)
            chunk = connection.recv(65536)
            if not chunk:
                raise CommandError("Compositor disconnected before replying; the request was not retried")
            buffer += chunk
            if len(buffer) > 4 * 1024 * 1024:
                raise CommandError("Compositor response is too large")
            while b"\n" in buffer:
                line, buffer = buffer.split(b"\n", 1)
                try:
                    response = json.loads(line)
                except (ValueError, UnicodeDecodeError):
                    raise CommandError("Invalid compositor response") from None
                if not isinstance(response, dict):
                    raise CommandError("Invalid compositor response")
                if response.get("id") != identity:
                    continue
                if response.get("event") == "error":
                    raise CommandError(response.get("message", "Compositor rejected request"))
                if response.get("event") == "reply":
                    if not isinstance(response.get("result"), dict):
                        raise CommandError("Invalid compositor response")
                    return response["result"]


def api_call(method, arguments, path, timeout=5):
    """Call a canonical Gnoblin session API operation through the bridge."""
    return compositor(
        {"op": "api", "method": method, "arguments": arguments},
        path,
        timeout,
    )


def dispatch(args, cli):
    cmd = args.command
    if cmd == "config" and args.action == "path":
        return str(user_config_path())
    if cmd == "shortcut" and args.action == "capture":
        return capture_accelerator(args.timeout, args.socket)

    def workspace_selector(workspace_id=None, workspace_number=None):
        if workspace_id is not None:
            return {"id": workspace_id}
        return {"number": workspace_number}

    if cmd == "window" and args.action == "list":
        return api_call(
            "window.list",
            {
                key: value
                for key, value in {"app_id": args.app_id, "title": args.title, "focused": args.focused}.items()
                if value
            },
            args.socket,
            args.timeout,
        )
    if cmd == "window" and args.action == "match":
        return api_call("window.match", {"window": args.id}, args.socket, args.timeout)
    if cmd == "window":
        arguments = {"action": args.action, "window": args.id}
        for field in ("x", "y", "width", "height", "monitor"):
            if hasattr(args, field):
                arguments[field] = getattr(args, field)
        if args.action == "workspace":
            return api_call(
                "workspace.move_window",
                {
                    "window": args.id,
                    "workspace": workspace_selector(
                        args.workspace_id,
                        args.number if args.number is not None else args.workspace,
                    ),
                },
                args.socket,
                args.timeout,
            )
        return api_call("window.action", arguments, args.socket, args.timeout)
    if cmd == "animation":
        arguments = {}
        if args.action in ("inspect", "preview"):
            arguments["name"] = args.name
            if args.event is not None:
                arguments["event"] = args.event
            if args.window is not None:
                arguments.update(targetType="window", target=args.window)
            elif args.layer is not None:
                arguments.update(targetType="layer", target=args.layer)
            elif args.namespace is not None:
                arguments.update(targetType="namespace", target=args.namespace)
            else:
                arguments.update(targetType="window", target="active")
            if args.action == "preview":
                arguments["autoplay"] = args.autoplay
        elif args.action in ("seek", "step"):
            arguments["session"] = args.session
            arguments["progress" if args.action == "seek" else "milliseconds"] = (
                args.value / 100 if args.action == "seek" else args.value
            )
        elif args.action in ("play", "pause", "stop"):
            arguments["session"] = args.session
        return api_call(f"animation.{args.action}", arguments, args.socket, args.timeout)
    if cmd == "layer" and args.action == "list":
        return api_call("layer.list", {}, args.socket, args.timeout)
    if cmd == "monitor":
        return api_call("monitor.list", {}, args.socket, args.timeout)
    if cmd == "workspace":
        if args.action == "list":
            return api_call("workspace.list", {}, args.socket, args.timeout)
        if args.action == "create":
            arguments = {"name": args.name, "activate": args.activate}
            if args.id is not None:
                arguments["id"] = args.id
            return api_call("workspace.create", arguments, args.socket, args.timeout)
        if args.action == "rename":
            return api_call(
                "workspace.rename",
                {**workspace_selector(args.workspace_id, args.number), "name": args.name},
                args.socket,
                args.timeout,
            )
        if args.action == "remove":
            return api_call(
                "workspace.remove",
                workspace_selector(args.workspace_id, args.number),
                args.socket,
                args.timeout,
            )
        if args.action == "switch":
            selector = workspace_selector(
                args.workspace_id,
                args.number if args.number is not None else args.workspace,
            )
            return api_call("workspace.switch", selector, args.socket, args.timeout)
        if args.action in ("next", "previous"):
            return api_call(f"workspace.{args.action}", {}, args.socket, args.timeout)
        selector = workspace_selector(args.workspace_id, args.number)
        return api_call(
            "workspace.move_active",
            {"workspace": selector, "follow": args.follow},
            args.socket,
            args.timeout,
        )
    if cmd == "status":
        result = api_call("shell.status", {}, args.socket, args.timeout)
        shell_version = result.pop("version")
        return {**version_record(shell_version), **result}
    if cmd == "ping":
        return api_call("shell.ping", {}, args.socket, args.timeout)["pong"]
    if cmd == "version":
        return version_record(api_call("shell.version", {}, args.socket, args.timeout)["version"])
    if cmd == "feature":
        if args.action == "list":
            return api_call("feature.list", {}, args.socket, args.timeout)
        if args.action == "show":
            return api_call("feature.show", {"id": args.id}, args.socket, args.timeout)
        return api_call(f"feature.{args.action}", {"id": args.id}, args.socket, args.timeout)
    if cmd == "script":
        return api_call("script.list", {}, args.socket, args.timeout)
    if cmd == "input":
        if args.action == "list":
            return api_call("input.list", {}, args.socket, args.timeout)
        if args.action == "current":
            return api_call("input.current", {}, args.socket, args.timeout)
        return api_call("input.select", {"type": args.type, "id": args.id}, args.socket, args.timeout)
    if cmd == "privacy":
        return api_call("privacy.get", {}, args.socket, args.timeout)
    if cmd == "permissions":
        if args.action in (None, "list"):
            return api_call("permissions.list", {}, args.socket, args.timeout)
        if args.action == "check":
            return api_call(
                "permissions.check",
                {"capability": args.capability, "identity": args.identity},
                args.socket,
                args.timeout,
            )
    if cmd == "grant":
        if args.action == "list":
            return api_call("grant.list", {}, args.socket, args.timeout)
        return api_call("grant.revoke", {"kind": args.kind, "id": args.id}, args.socket, args.timeout)
    if cmd == "launch":
        if args.action == "status":
            return api_call("launch.status", {}, args.socket, args.timeout)
        if args.action == "begin":
            return api_call(
                "launch.begin",
                {"token": args.token, "application": args.application, "milliseconds": args.milliseconds},
                args.socket,
                args.timeout,
            )
        return api_call("launch.end", {"token": args.token}, args.socket, args.timeout)
    if cmd == "reload":
        return api_call("shell.reload", {}, args.socket, args.timeout)
    if cmd == "config" and args.action == "reload":
        return api_call("runtime.reload_config", {}, args.socket, args.timeout)


def text(value):
    if value is None:
        return "-"
    if isinstance(value, bool):
        return "yes" if value else "no"
    if isinstance(value, (list, dict)):
        value = json.dumps(value, ensure_ascii=False)
    return "".join(character if character.isprintable() else " " for character in str(value))


def table(rows):
    if not rows:
        print("No items.")
        return
    if not isinstance(rows[0], dict):
        for row in rows:
            print(text(row))
        return
    fields = list(rows[0])
    if "appId" in fields:
        fields = ["id", "focused", "workspace", "monitorIndex", "appId", "title"]
    values = [[text(row.get(field)) for field in fields] for row in rows]
    labels = {"appId": "APP ID", "monitorIndex": "MONITOR", "shortName": "SHORT NAME"}
    headers = [labels.get(field, field.upper()) for field in fields]
    widths = [max(len(header), *(len(row[index]) for row in values)) for index, header in enumerate(headers)]
    available = max(40, shutil.get_terminal_size((120, 24)).columns) - 2 * (len(fields) - 1)
    while sum(widths) > available and max(widths) > 10:
        index = widths.index(max(widths))
        widths[index] -= 1

    def line(row):
        return "  ".join(
            (value if len(value) <= width else value[: max(0, width - 3)] + "...").ljust(width)
            for value, width in zip(row, widths)
        ).rstrip()

    print(line(headers))
    print(line(["-" * width for width in widths]))
    for row in values:
        print(line(row))


def render(result, output_format):
    if output_format == "json" or output_format == "auto" and not sys.stdout.isatty() and not isinstance(result, str):
        print(json.dumps(result, ensure_ascii=False))
    elif isinstance(result, str):
        print(text(result))
    elif isinstance(result, dict) and len(result) == 1 and isinstance(next(iter(result.values())), list):
        table(next(iter(result.values())))
    elif isinstance(result, dict):
        for key, value in result.items():
            print(f"{human_label(key)}: {text(value)}")
    else:
        print(text(result))


def subcommands(cli):
    return next((action.choices for action in cli._actions if isinstance(action, argparse._SubParsersAction)), {})


def human_label(key):
    return re.sub(r"(?<!^)([A-Z])", r" \1", str(key)).replace("_", " ").lower()


def option_words(cli):
    return " ".join(
        option
        for action in cli._actions
        if action.option_strings and action.dest != "help"
        for option in action.option_strings
    )


def completions(cli, shell):
    choices = subcommands(cli)
    names = " ".join(choices)
    nested = {
        name: " ".join((*subcommands(command), option_words(command)))
        for name, command in choices.items()
        if subcommands(command)
    }
    bash_cases = "\n".join(f"        {name}:2) words='{actions}' ;;" for name, actions in nested.items())
    bash_action_cases = "\n".join(
        f"        {group}:{action}:3) words='{option_words(parser)}' ;;"
        for group, command in choices.items()
        for action, parser in subcommands(command).items()
    )
    zsh_cases = "\n".join(f"            {name}) compadd {actions} ;;" for name, actions in nested.items())
    if shell == "bash":
        print(
            """_gnoblinctl() {
    local cur=${COMP_WORDS[COMP_CWORD]} words='--help --json --format --timeout --socket' index=1 command action position
    while [[ ${COMP_WORDS[index]} == -* ]]; do
        case ${COMP_WORDS[index]} in --format|--timeout|--socket) ((index += 2));; *) ((index++));; esac
    done
    command=${COMP_WORDS[index]}; action=${COMP_WORDS[index + 1]}; position=$((COMP_CWORD - index + 1))
    case "$command:$position" in
        *:1) words='NAMES' ;;
CASES
    esac
    case "$command:$action:$position" in
ACTION_CASES
    esac
    case "${COMP_WORDS[COMP_CWORD-1]}" in
        --format) words='auto json table' ;;
        --socket) COMPREPLY=($(compgen -f -- "$cur")); return ;;
    esac
    COMPREPLY=($(compgen -W "$words" -- "$cur"))
}
complete -F _gnoblinctl gnoblinctl""".replace("NAMES", names)
            .replace("ACTION_CASES", bash_action_cases)
            .replace("CASES", bash_cases)
        )
    elif shell == "zsh":
        print(
            """#compdef gnoblinctl
_gnoblinctl() {
    if (( CURRENT == 2 )); then
        compadd NAMES
    elif (( CURRENT == 3 )); then
        case $words[2] in
CASES
        esac
    else
        _arguments '--json[JSON output]' '--format[Output format]:format:(auto json table)' '--socket[Compositor socket]:path:_files' '--timeout[Request timeout]:seconds:'
    fi
}
compdef _gnoblinctl gnoblinctl""".replace("NAMES", names).replace("CASES", zsh_cases)
        )
    else:
        print("complete -c gnoblinctl -f")
        for name in choices:
            print(f"complete -c gnoblinctl -n '__fish_use_subcommand' -a '{name}'")
        for name, actions in nested.items():
            print(f"complete -c gnoblinctl -n '__fish_seen_subcommand_from {name}' -a '{actions}'")
        print("complete -c gnoblinctl -l json -s j -d 'JSON output'")


def main(argv=None):
    cli = parser()
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "help":
        argv = [*argv[1:], "--help"]
    args = cli.parse_args(argv)
    defaults = {
        "format": "auto",
        "timeout": 30 if args.command == "shortcut" and args.action == "capture" else 5,
        "socket": os.environ.get("GNOBLIN_COMPOSITOR_SOCKET")
        or str(Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "gnoblin/compositor-v1.sock"),
    }
    for key, value in defaults.items():
        if not hasattr(args, key):
            setattr(args, key, value)
    if not args.command:
        cli.print_help()
        return 0
    if args.command == "completion":
        completions(cli, args.shell)
        return 0
    if (
        args.command
        in (
            "config",
            "window",
            "layer",
            "workspace",
            "monitor",
            "input",
            "feature",
            "script",
            "grant",
            "launch",
            "permissions",
            "shortcut",
        )
        and args.action is None
    ):
        subcommands(cli)[args.command].print_help()
        return 0
    try:
        if args.command == "config" and args.action == "default":
            sys.stdout.write(default_lua_config())
        else:
            render(dispatch(args, cli), args.format)
        return 0
    except BrokenPipeError:
        return 0
    except (CommandError, OSError, TimeoutError) as error:
        message = str(error)
        if isinstance(error, TimeoutError):
            message = "Request timed out; it was not retried. Check current state before repeating an action."
        print(f"gnoblinctl: {message}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
