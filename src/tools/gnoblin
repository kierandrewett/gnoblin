#!/usr/bin/env bash
# gnoblin -- the wayland-sessions Exec= target for the Gnoblin session.
#
# The login manager invokes this directly. Set up lookup paths for the patched
# build in $PREFIX through gnoblin-env.sh, shared with the development launchers
# and gnoblin-shell-service.
#
# The lean login starts gnoblin-shell-service directly. The optional GNOME
# Session path starts Shell through the Gnoblin-specific systemd user unit.
#
# Installed to $PREFIX/bin/gnoblin by scripts/install-session.sh,
# which also bakes this script's absolute path into the installed
# gnoblin.desktop's Exec=. Self-locates its prefix from its own installed
# path.
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
PREFIX="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

if [[ ${1:-} == --version ]]; then
    shift
    exec "$PREFIX/bin/gnoblinctl" --version "$@"
fi

if [[ ${GNOBLIN_STANDALONE_SESSION:-0} == 1 ]]; then
    if [[ ${XDG_SESSION_TYPE:-} != wayland || -z ${XDG_SESSION_ID:-} ||
        -n ${WAYLAND_DISPLAY:-} || -n ${DISPLAY:-} ]]; then
        echo 'gnoblin: standalone mode needs a fresh Wayland login session' >&2
        exit 2
    fi
    if systemctl --user is-active --quiet graphical-session.target; then
        echo 'gnoblin: another graphical session is already active' >&2
        exit 2
    fi
    unset XAUTHORITY GNOME_SETUP_DISPLAY
fi

# gnome-session mirrors its environment into the user systemd/D-Bus activation
# environment. Keep the user's ambient lookup paths for that process, but do
# not let Gnoblin's private ABI/schema paths poison a later stock GNOME login.
BASE_PATH="${PATH:-/usr/local/bin:/usr/bin:/bin}"
BASE_XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

source "$PREFIX/libexec/gnoblin-env.sh"
gnoblin_env_apply "$PREFIX"
if [[ ${GNOBLIN_STANDALONE_SESSION:-0} == 1 ]]; then
    # OnlyShowIn=GNOME autostart entries belong to GNOME's session. The
    # standalone path starts only entries that select Gnoblin explicitly or
    # have no desktop filter. gnoblin_env_apply retains this identity in both
    # the wrapper and the Shell service it launches.
    export XDG_SESSION_DESKTOP=gnoblin
fi

# Some D-Bus activated desktop services require the logind session class in
# the user manager. Display managers do not always export that variable to the
# session command, so read the class from the session logind registered.
if [[ -n ${XDG_SESSION_ID:-} ]] && command -v loginctl >/dev/null 2>&1; then
    session_class="$(loginctl show-session "$XDG_SESSION_ID" --property=Class --value 2>/dev/null || true)"
    if [[ -n $session_class ]]; then
        export XDG_SESSION_CLASS="$session_class"
    fi
fi

# Give a first-time user a complete editable config before gnome-session starts
# Gnoblin Shell, so its initial config load reads the same file as later reloads.
example="$PREFIX/share/gnoblin/init.lua.example"
if [[ ! -r "$example" ]]; then
    IFS=: read -r -a data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for data_dir in "${data_dirs[@]}"; do
        candidate="$data_dir/gnoblin/init.lua.example"
        if [[ -r "$candidate" ]]; then
            example="$candidate"
            break
        fi
    done
fi
"$PREFIX/libexec/gnoblin-seed-config" "$example"

# D-Bus activation and systemd --user keep their own environment snapshot.
# Update both before gnome-session can cause any session services to activate;
# otherwise a service can inherit the previous desktop's session identity and
# display.  Keep this list limited to session-routing variables: the private
# Gnoblin library paths must not leak into every user service.
gnoblin_sync_activation_environment() {
    local activation_vars=(
        GNOME_SHELL_SESSION_MODE
        XDG_CURRENT_DESKTOP
        XDG_SESSION_DESKTOP
        XDG_SESSION_CLASS
        XDG_SESSION_TYPE
        WAYLAND_DISPLAY
        DISPLAY
        XAUTHORITY
    )

    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        if ! dbus-update-activation-environment --systemd "${activation_vars[@]}"; then
            echo "gnoblin: could not update D-Bus activation environment" >&2
        fi
    fi
}

# GOA is D-Bus activated as a transient user service, so it is not necessarily
# stopped when the previous GNOME session ends.  A surviving GOA instance can
# retain proxies for the previous Secret Service instance and report the
# misleading "Failed to retrieve credentials from the keyring" error.  Stop
# only GOA and its Identity helper; they will be reactivated on demand after
# the environment above has been imported.  Leave Secret Service itself alone
# so existing keyring state and connections are not disturbed.
gnoblin_reset_online_accounts_services() {
    local units unit

    command -v systemctl >/dev/null 2>&1 || return 0

    units="$(systemctl --user list-units --all --plain --no-legend \
        'dbus-*-org.gnome.OnlineAccounts@*.service' \
        'dbus-*-org.gnome.Identity@*.service' 2>/dev/null || true)"

    while read -r unit _; do
        case "$unit" in
            dbus-*-org.gnome.OnlineAccounts@*.service | dbus-*-org.gnome.Identity@*.service)
                if ! systemctl --user stop "$unit"; then
                    echo "gnoblin: could not stop stale $unit" >&2
                fi
                ;;
        esac
    done <<<"$units"
}

if [[ ${GNOBLIN_STANDALONE_SESSION:-0} == 1 ]]; then
    # The user bus survives a logout and cannot unset activation variables.
    # Replace the previous desktop's display addresses with empty values until
    # Mutter publishes this session's Wayland/XWayland addresses. systemd can
    # unset them, so its new units do not inherit empty X11 variables.
    command -v dbus-update-activation-environment >/dev/null 2>&1 || {
        echo 'gnoblin: dbus-update-activation-environment is required' >&2
        exit 1
    }
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY= DISPLAY= XAUTHORITY= GNOME_SETUP_DISPLAY=
    systemctl --user unset-environment \
        WAYLAND_DISPLAY DISPLAY XAUTHORITY GNOME_SETUP_DISPLAY
fi

gnoblin_sync_activation_environment
gnoblin_reset_online_accounts_services

if [[ ${GNOBLIN_STANDALONE_SESSION:-0} == 1 ]] &&
    systemctl --user is-active --quiet org.gnome.SettingsDaemon.ScreensaverProxy.service; then
    # The user bus survives a desktop switch. GNOME's proxy owns the same
    # freedesktop ScreenSaver name as Gnoblin's standalone idle service.
    if ! systemctl --user stop org.gnome.SettingsDaemon.ScreensaverProxy.service; then
        echo 'gnoblin: could not stop the previous screensaver proxy' >&2
    fi
fi

# The Gnoblin shell unit sources gnoblin-env.sh itself, so these private paths
# are not needed by gnome-session or any user-manager service. Clear both the
# manager snapshot and the direct process environment before starting the
# session manager. This matters when switching from Gnoblin to stock GNOME
# without ending the user's systemd --user instance.
systemctl --user unset-environment \
    GNOBLIN_PREFIX GNOBLIN_LIBDIR GSETTINGS_SCHEMA_DIR \
    LD_LIBRARY_PATH GI_TYPELIB_PATH >/dev/null 2>&1 || true

# Standalone mode owns the login lifecycle. Keep
# this wrapper alive so it can stop Gnoblin's graphical-session/autostart
# targets when the compositor exits. The optional login entry uses gnome-session.
if [[ ${GNOBLIN_STANDALONE_SESSION:-0} == 1 ]]; then
    standalone_pid=''
    standalone_cleanup() {
        if [[ -n $standalone_pid ]]; then
            kill "$standalone_pid" 2>/dev/null || true
        fi
        # Both targets belong to this login. Stop the graphical target as
        # well so portal services with PartOf=graphical-session.target cannot
        # survive into a later GNOME login while the user bus is still alive.
        systemctl --user stop gnoblin-session.target graphical-session.target \
            >/dev/null 2>&1 || true
        dbus-update-activation-environment --systemd \
            GNOME_SHELL_SESSION_MODE= XDG_CURRENT_DESKTOP= \
            XDG_SESSION_DESKTOP= XDG_SESSION_CLASS= XDG_SESSION_TYPE= \
            WAYLAND_DISPLAY= DISPLAY= XAUTHORITY= GNOME_SETUP_DISPLAY= \
            >/dev/null 2>&1 || true
        systemctl --user unset-environment \
            GNOME_SHELL_SESSION_MODE XDG_CURRENT_DESKTOP \
            XDG_SESSION_DESKTOP XDG_SESSION_CLASS XDG_SESSION_TYPE \
            WAYLAND_DISPLAY DISPLAY XAUTHORITY GNOME_SETUP_DISPLAY \
            >/dev/null 2>&1 || true
    }
    trap standalone_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    # Regenerate XDG autostart units after importing this session's desktop
    # identity into the user manager. Shell starts gnoblin-session.target only
    # after its compositor is ready for clients.
    systemctl --user daemon-reload
    shell_args=(--wayland --mode=gnoblin)
    # Xwayland is useful for legacy apps but is not part of the lean session's
    # required runtime. Mutter must not try to launch it when it is absent.
    if ! command -v Xwayland >/dev/null 2>&1; then
        shell_args+=(--no-x11)
    fi
    "$PREFIX/bin/gnoblin-shell-service" "${shell_args[@]}" "$@" &
    standalone_pid=$!
    set +e
    wait "$standalone_pid"
    status=$?
    set -e
    standalone_pid=''
    exit "$status"
fi

# gnome-session normally re-executes through the user's login shell. NixOS
# login profiles rebuild XDG_DATA_DIRS and remove this package's session file,
# so keep the runtime environment established above for the session manager.
exec env \
    -u GNOBLIN_PREFIX \
    -u GNOBLIN_LIBDIR \
    -u GSETTINGS_SCHEMA_DIR \
    -u LD_LIBRARY_PATH \
    -u GI_TYPELIB_PATH \
    PATH="$BASE_PATH" \
    XDG_DATA_DIRS="$BASE_XDG_DATA_DIRS" \
    gnome-session --no-reexec --session=gnoblin "$@"
