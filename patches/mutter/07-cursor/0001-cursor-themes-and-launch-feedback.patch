From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sat, 19 Sep 2026 22:00:26 +0100
Subject: [PATCH] cursor: load Hyprcursor themes and support global launch
 feedback

Only a Gnoblin session may show the launch cursor; the check uses the supervisor session predicate
gnoblin_native_control_is_session instead of reading GNOME_SHELL_SESSION_MODE.
---
 config.h.meson                     |  1 +
 meson.build                        |  7 +++++
 meson.options                      |  6 +++++
 src/backends/meta-cursor-theme.c   |  6 +++++
 src/backends/meta-cursor-tracker.c | 41 ++++++++++++++++++++++++++++++
 src/backends/meta-cursor-xcursor.c | 15 +++++++++++
 src/meta/meta-cursor-tracker.h     |  7 +++++
 7 files changed, 83 insertions(+)

diff --git a/config.h.meson b/config.h.meson
index 5e7e09b1..420e749b 100644
--- a/config.h.meson
+++ b/config.h.meson
@@ -27,6 +27,7 @@
 
 /* Have GL for rendering */
 #mesondefine HAVE_GL
+#mesondefine HAVE_HYPRCURSOR
 
 /* Have GLES 2.0 for rendering */
 #mesondefine HAVE_GLES2
diff --git a/meson.build b/meson.build
index cdd13b68..6359dbf4 100644
--- a/meson.build
+++ b/meson.build
@@ -116,6 +116,12 @@ subproject('gvdb')
 
 m_dep = cc.find_library('m', required: true)
 graphene_dep = dependency('graphene-gobject-1.0', version: graphene_req)
+hyprcursor_dep = dependency('hyprcursor', version: '>= 0.1.11', required: get_option('hyprcursor'))
+have_hyprcursor = hyprcursor_dep.found()
+if have_hyprcursor
+  add_languages('cpp')
+  add_project_arguments('-std=c++20', language: 'cpp')
+endif
 pixman_dep = dependency('pixman-1', version: pixman_req)
 gsettings_desktop_schemas_dep = dependency('gsettings-desktop-schemas',
                                            version: gsettings_desktop_schemas_req)
@@ -536,6 +542,7 @@ cc.compiles('void main (void) { __builtin_ffsl (0); __builtin_popcountl (0); }')
 have_eventfd = cc.has_header('sys/eventfd.h')
 
 cdata = configuration_data()
+cdata.set('HAVE_HYPRCURSOR', have_hyprcursor)
 cdata.set_quoted('GETTEXT_PACKAGE', gettext_package)
 cdata.set_quoted('VERSION', meson.project_version())
 cdata.set_quoted('PACKAGE_NAME', meson.project_name())
diff --git a/meson.options b/meson.options
index 4f8c0c9b..fff441f3 100644
--- a/meson.options
+++ b/meson.options
@@ -1,3 +1,9 @@
+option('hyprcursor',
+  type: 'feature',
+  value: 'auto',
+  description: 'Enable Gnoblin Hyprcursor themes'
+)
+
 option('opengl',
   type: 'boolean',
   value: true,
diff --git a/src/backends/meta-cursor-theme.c b/src/backends/meta-cursor-theme.c
index 36431184..6c7f8887 100644
--- a/src/backends/meta-cursor-theme.c
+++ b/src/backends/meta-cursor-theme.c
@@ -23,6 +23,9 @@
 
 #include "backends/meta-backend-private.h"
 #include "backends/meta-cursor-xcursor.h"
+#ifdef HAVE_HYPRCURSOR
+#include "backends/gnoblin-hyprcursor.h"
+#endif
 
 enum
 {
@@ -173,5 +176,8 @@ meta_cursor_theme_get_cursor (MetaCursorTheme   *cursor_theme,
 void
 meta_cursor_theme_reset (MetaCursorTheme *cursor_theme)
 {
+#ifdef HAVE_HYPRCURSOR
+  gnoblin_hyprcursor_invalidate ();
+#endif
   g_hash_table_remove_all (cursor_theme->cursors);
 }
diff --git a/src/backends/meta-cursor-tracker.c b/src/backends/meta-cursor-tracker.c
index 8d8432f3..b62568fb 100644
--- a/src/backends/meta-cursor-tracker.c
+++ b/src/backends/meta-cursor-tracker.c
@@ -37,6 +37,7 @@
 #include "backends/meta-sprite.h"
 #include "cogl/cogl.h"
 #include "core/display-private.h"
+#include "core/gnoblin-native-control.h"
 #include "clutter/clutter-mutter.h"
 #include "clutter/clutter.h"
 #include "meta/main.h"
@@ -58,6 +59,7 @@ typedef struct _MetaCursorTrackerPrivate
   MetaBackend *backend;
 
   ClutterCursor *current_cursor;
+  ClutterCursor *gnoblin_launch_cursor;
 
   int cursor_visibility_inhibitors;
 
@@ -163,6 +165,9 @@ meta_cursor_tracker_real_get_sprite (MetaCursorTracker *tracker)
     meta_backend_get_clutter_backend (backend);
   ClutterSeat *seat = clutter_backend_get_default_seat (clutter_backend);
 
+  if (priv->gnoblin_launch_cursor)
+    return priv->gnoblin_launch_cursor;
+
   if (!clutter_seat_is_unfocus_inhibited (seat))
     return NULL;
 
@@ -242,6 +247,7 @@ meta_cursor_tracker_finalize (GObject *object)
     meta_cursor_tracker_get_instance_private (tracker);
 
   g_clear_object (&priv->current_cursor);
+  g_clear_object (&priv->gnoblin_launch_cursor);
   meta_prefs_remove_listener (on_prefs_changed, tracker);
 
   G_OBJECT_CLASS (meta_cursor_tracker_parent_class)->finalize (object);
@@ -465,3 +471,38 @@ meta_cursor_tracker_get_backend (MetaCursorTracker *tracker)
 
   return priv->backend;
 }
+
+/**
+ * meta_cursor_tracker_set_gnoblin_launch_cursor:
+ * @tracker: the cursor tracker
+ * @active: whether to show the themed wait cursor over client cursors
+ *
+ * Changes cursor rendering without a pointer grab or focus change.
+ */
+void
+meta_cursor_tracker_set_gnoblin_launch_cursor (MetaCursorTracker *tracker,
+                                              gboolean           active)
+{
+  MetaCursorTrackerPrivate *priv =
+    meta_cursor_tracker_get_instance_private (tracker);
+
+  if (active && !gnoblin_native_control_is_session (NULL))
+    return;
+
+  if (active && !priv->gnoblin_launch_cursor)
+    priv->gnoblin_launch_cursor =
+      meta_backend_get_cursor (priv->backend, CLUTTER_CURSOR_WAIT);
+  else if (!active)
+    g_clear_object (&priv->gnoblin_launch_cursor);
+
+  meta_cursor_tracker_notify_cursor_changed (tracker);
+}
+
+gboolean
+meta_cursor_tracker_get_gnoblin_launch_cursor (MetaCursorTracker *tracker)
+{
+  MetaCursorTrackerPrivate *priv =
+    meta_cursor_tracker_get_instance_private (tracker);
+
+  return priv->gnoblin_launch_cursor != NULL;
+}
diff --git a/src/backends/meta-cursor-xcursor.c b/src/backends/meta-cursor-xcursor.c
index 2f0acfc6..70783fe3 100644
--- a/src/backends/meta-cursor-xcursor.c
+++ b/src/backends/meta-cursor-xcursor.c
@@ -19,6 +19,9 @@
 #include "config.h"
 
 #include "backends/meta-cursor-xcursor.h"
+#ifdef HAVE_HYPRCURSOR
+#include "backends/gnoblin-hyprcursor.h"
+#endif
 
 #include "backends/meta-backend-private.h"
 #include "backends/meta-logical-monitor-private.h"
@@ -179,6 +182,18 @@ load_cursor_on_client (MetaCursorXcursor *cursor_xcursor,
   cursor_names[0] = clutter_cursor_type_to_name (cursor);
   cursor_names[1] = meta_cursor_get_legacy_name (cursor);
 
+#ifdef HAVE_HYPRCURSOR
+  for (i = 0; i < G_N_ELEMENTS (cursor_names); i++)
+    {
+      xcursor_images =
+        gnoblin_hyprcursor_load (meta_cursor_get_theme_name (meta_cursor),
+                                 cursor_names[i],
+                                 meta_cursor_get_size (meta_cursor) * scale);
+      if (xcursor_images)
+        return xcursor_images;
+    }
+#endif
+
   for (i = 0; i < G_N_ELEMENTS (cursor_names); i++)
     {
       xcursor_images =
diff --git a/src/meta/meta-cursor-tracker.h b/src/meta/meta-cursor-tracker.h
index 60c16f5d..bdd5b944 100644
--- a/src/meta/meta-cursor-tracker.h
+++ b/src/meta/meta-cursor-tracker.h
@@ -60,3 +60,10 @@ void           meta_cursor_tracker_inhibit_cursor_visibility (MetaCursorTracker
 
 META_EXPORT
 void           meta_cursor_tracker_uninhibit_cursor_visibility (MetaCursorTracker *tracker);
+
+META_EXPORT
+void meta_cursor_tracker_set_gnoblin_launch_cursor (MetaCursorTracker *tracker,
+                                                   gboolean           active);
+
+META_EXPORT
+gboolean meta_cursor_tracker_get_gnoblin_launch_cursor (MetaCursorTracker *tracker);
-- 
