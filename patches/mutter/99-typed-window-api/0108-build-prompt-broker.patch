From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Tue, 6 Oct 2026 22:05:00 +0100
Subject: [PATCH] mutter: build the prompt broker

---
diff --git a/src/meson.build b/src/meson.build
index 0fc61863c7..1a36b89d7d 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -1200,6 +1200,7 @@ libmutter = library(libmutter_name,
   files('core/gnoblin-control-capture.c'),
   files('core/gnoblin-control-privacy.c'),
   files('core/gnoblin-control-grants.c'),
+  files('core/gnoblin-control-prompts.c'),
   files('core/gnoblin-touchpad-router.c'),
   files('core/gnoblin-keybinding-catalog.c'),
   version: '0.0.0',
@@ -1216,6 +1217,7 @@ libmutter = library(libmutter_name,
     mutter_deps,
     gvdb_dep,
     dependency('json-glib-1.0'),
+    dependency('gcr-4'),
     dependency('polkit-agent-1'),
     dependency('polkit-gobject-1'),
   ],
