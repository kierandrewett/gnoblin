From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 14 Sep 2026 16:33:21 +0200
Subject: [PATCH] mutter: dispatch trusted shortcut context through supervisor

---
diff --git a/src/core/display-private.h b/src/core/display-private.h
index 946015818..f82464787 100644
--- a/src/core/display-private.h
+++ b/src/core/display-private.h
@@ -61,6 +61,11 @@ typedef enum
 typedef void (* MetaDisplayWindowFunc) (MetaWindow *window,
                                         gpointer    user_data);
 
+typedef void (* MetaGnoblinShortcutActivatedFunc) (MetaDisplay        *display,
+                                                    guint               action,
+                                                    const ClutterEvent *event,
+                                                    gpointer            user_data);
+
 
 /* To avoid ifdefing MetaX11Display usage when built without X11 support */
 #ifndef HAVE_XWAYLAND
@@ -240,6 +245,9 @@ void meta_display_accelerator_activate (MetaDisplay           *display,
 void meta_display_accelerator_deactivate (MetaDisplay           *display,
                                           guint                  action,
                                           const ClutterEvent    *event);
+void meta_display_set_gnoblin_shortcut_activated_handler (MetaDisplay                       *display,
+                                                          MetaGnoblinShortcutActivatedFunc   callback,
+                                                          gpointer                           user_data);
 void meta_display_modifiers_accelerator_activate (MetaDisplay *display);
 
 void meta_display_update_focus_window (MetaDisplay *display,
diff --git a/src/core/display.c b/src/core/display.c
index 45b860eb8..c1e4948fb 100644
--- a/src/core/display.c
+++ b/src/core/display.c
@@ -128,6 +128,9 @@ typedef struct _MetaDisplayPrivate
 
   gboolean enable_input_capture;
 
+  MetaGnoblinShortcutActivatedFunc gnoblin_shortcut_activated;
+  gpointer gnoblin_shortcut_activated_data;
+
   MetaWindow *pointer_window;
   gulong pointer_window_unmanaging_handler_id;
 
@@ -2229,12 +2232,32 @@ meta_display_accelerator_activate (MetaDisplay           *display,
                                    guint                  action,
                                    const ClutterEvent    *event)
 {
+  MetaDisplayPrivate *priv = meta_display_get_instance_private (display);
+
+  if (priv->gnoblin_shortcut_activated)
+    priv->gnoblin_shortcut_activated (display, action, event,
+                                      priv->gnoblin_shortcut_activated_data);
+
   g_signal_emit (display, display_signals[ACCELERATOR_ACTIVATED], 0,
                  action,
                  clutter_event_get_source_device (event),
                  clutter_event_get_time (event));
 }
 
+void
+meta_display_set_gnoblin_shortcut_activated_handler (MetaDisplay                       *display,
+                                                     MetaGnoblinShortcutActivatedFunc   callback,
+                                                     gpointer                           user_data)
+{
+  MetaDisplayPrivate *priv = meta_display_get_instance_private (display);
+
+  g_return_if_fail (callback == NULL || priv->gnoblin_shortcut_activated == NULL);
+  g_return_if_fail (callback == NULL || user_data != NULL);
+
+  priv->gnoblin_shortcut_activated = callback;
+  priv->gnoblin_shortcut_activated_data = user_data;
+}
+
 void
 meta_display_accelerator_deactivate (MetaDisplay           *display,
                                      guint                  action,
diff --git a/src/core/util-private.h b/src/core/util-private.h
index 9274cfc45..f7f61b7d4 100644
--- a/src/core/util-private.h
+++ b/src/core/util-private.h
@@ -22,6 +22,17 @@
 
 #pragma once
 
+#include <glib.h>
+
+#include "meta/display.h"
+
+gboolean meta_display_dispatch_gnoblin_shortcut_event (MetaDisplay *display,
+                                                       const char  *event,
+                                                       GVariant    *payload,
+                                                       guint64      context_handle,
+                                                       guint64      generation,
+                                                       gint64       expires_at_us);
+
 #include <glib/gi18n-lib.h>
 #include <sys/time.h>
 
diff --git a/src/core/util.c b/src/core/util.c
index a741363f2..2b083fdd2 100644
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -716,6 +716,43 @@ meta_display_dispatch_gnoblin_event (MetaDisplay *display,
 #endif
 }
 
+gboolean
+meta_display_dispatch_gnoblin_shortcut_event (MetaDisplay *display,
+                                               const char  *event,
+                                               GVariant    *payload,
+                                               guint64      context_handle,
+                                               guint64      generation,
+                                               gint64       expires_at_us)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) event_payload = NULL;
+  GVariantDict payload_dict;
+  gboolean claimed = FALSE;
+
+  if (!payload || !g_variant_is_of_type (payload, G_VARIANT_TYPE_VARDICT) ||
+      !context_handle || !generation || expires_at_us <= g_get_monotonic_time ())
+    return FALSE;
+
+  g_variant_dict_init (&payload_dict, payload);
+  g_variant_dict_insert (&payload_dict, "focus_context_handle", "t",
+                         context_handle);
+  g_variant_dict_insert (&payload_dict, "focus_context_generation", "t",
+                         generation);
+  g_variant_dict_insert (&payload_dict, "focus_context_expires_at_us", "x",
+                         expires_at_us);
+  event_payload = g_variant_ref_sink (g_variant_dict_end (&payload_dict));
+
+  if (!gnoblin_native_control_is_session (display))
+    return FALSE;
+  if (!gnoblin_native_control_dispatch_runtime_event (display, event,
+                                                       event_payload, &claimed,
+                                                       &error))
+    g_warning ("gnoblin runtime shortcut event %s: %s", event,
+               error ? error->message : "could not queue event");
+  return claimed;
+}
+
+
 #define GNOBLIN_WORKSPACE_ID "gnoblin-native-id"
 #define GNOBLIN_WORKSPACE_NAME "gnoblin-native-name"
 #define GNOBLIN_WORKSPACE_PERSISTENT "gnoblin-native-persistent"
