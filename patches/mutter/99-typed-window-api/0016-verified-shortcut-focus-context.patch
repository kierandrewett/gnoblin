From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 28 Sep 2026 06:18:39 +0100
Subject: [PATCH] mutter: dispatch trusted one-use shortcut focus contexts

---
diff --git a/src/core/display-private.h b/src/core/display-private.h
index a77d87a81..a5689c9cb 100644
--- a/src/core/display-private.h
+++ b/src/core/display-private.h
@@ -61,6 +61,11 @@ typedef enum
 typedef void (* MetaDisplayWindowFunc) (MetaWindow *window,
                                         gpointer    user_data);
 
+typedef void (* MetaGnoblinShortcutActivatedFunc) (MetaDisplay        *display,
+                                                    guint               action,
+                                                    const ClutterEvent *event,
+                                                    gpointer            user_data);
+
 
 /* To avoid ifdefing MetaX11Display usage when built without X11 support */
 #ifndef HAVE_XWAYLAND
@@ -246,6 +251,9 @@ void meta_display_accelerator_activate (MetaDisplay           *display,
 void meta_display_accelerator_deactivate (MetaDisplay           *display,
                                           guint                  action,
                                           const ClutterEvent    *event);
+void meta_display_set_gnoblin_shortcut_activated_handler (MetaDisplay                       *display,
+                                                          MetaGnoblinShortcutActivatedFunc   callback,
+                                                          gpointer                           user_data);
 void meta_display_modifiers_accelerator_activate (MetaDisplay *display);
 
 void meta_display_update_focus_window (MetaDisplay *display,
diff --git a/src/core/display.c b/src/core/display.c
index eac594855..9374d12a3 100644
--- a/src/core/display.c
+++ b/src/core/display.c
@@ -128,6 +128,9 @@ typedef struct _MetaDisplayPrivate
 
   gboolean enable_input_capture;
 
+  MetaGnoblinShortcutActivatedFunc gnoblin_shortcut_activated;
+  gpointer gnoblin_shortcut_activated_data;
+
   MetaWindow *pointer_window;
   gulong pointer_window_unmanaging_handler_id;
 
@@ -2262,12 +2265,32 @@ meta_display_accelerator_activate (MetaDisplay           *display,
                                    guint                  action,
                                    const ClutterEvent    *event)
 {
+  MetaDisplayPrivate *priv = meta_display_get_instance_private (display);
+
+  if (priv->gnoblin_shortcut_activated)
+    priv->gnoblin_shortcut_activated (display, action, event,
+                                      priv->gnoblin_shortcut_activated_data);
+
   g_signal_emit (display, display_signals[ACCELERATOR_ACTIVATED], 0,
                  action,
                  clutter_event_get_source_device (event),
                  clutter_event_get_time (event));
 }
 
+void
+meta_display_set_gnoblin_shortcut_activated_handler (MetaDisplay                       *display,
+                                                     MetaGnoblinShortcutActivatedFunc   callback,
+                                                     gpointer                           user_data)
+{
+  MetaDisplayPrivate *priv = meta_display_get_instance_private (display);
+
+  g_return_if_fail (callback == NULL || priv->gnoblin_shortcut_activated == NULL);
+  g_return_if_fail (callback == NULL || user_data != NULL);
+
+  priv->gnoblin_shortcut_activated = callback;
+  priv->gnoblin_shortcut_activated_data = user_data;
+}
+
 void
 meta_display_accelerator_deactivate (MetaDisplay           *display,
                                      guint                  action,
diff --git a/src/core/util-private.h b/src/core/util-private.h
index 9274cfc45..03e29897e 100644
--- a/src/core/util-private.h
+++ b/src/core/util-private.h
@@ -22,6 +22,16 @@
 
 #pragma once
 
+#include <glib.h>
+
+#include "meta/display.h"
+
+gboolean meta_display_dispatch_gnoblin_shortcut_event (MetaDisplay *display,
+                                                       const char  *event,
+                                                       GVariant    *payload,
+                                                       guint64      context_handle,
+                                                       gint64       expires_at_us);
+
 #include <glib/gi18n-lib.h>
 #include <sys/time.h>
 
diff --git a/src/core/util.c b/src/core/util.c
index 873520a87..d140327cf 100644
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -34,6 +34,8 @@
 #include <errno.h>
 #include <string.h>
 
+static void meta_gnoblin_revoke_focus_contexts (void);
+
 #ifdef HAVE_SYS_PRCTL
 #include <sys/prctl.h>
 #endif
@@ -816,6 +818,8 @@ meta_gnoblin_finish_config_load (gboolean commit)
 {
 #ifdef HAVE_WAYLAND
   gnoblin_config_finish_load (commit);
+  if (commit)
+    meta_gnoblin_revoke_focus_contexts ();
 #endif
 }
 
@@ -835,6 +839,13 @@ static MetaDisplay *native_runtime_callback_display;
 static guint native_runtime_callbacks_idle_id;
 static void meta_gnoblin_drain_native_runtime_operations (MetaDisplay *display);
 
+static void
+meta_gnoblin_revoke_focus_contexts (void)
+{
+  if (native_runtime_callback_display)
+    gnoblin_native_control_revoke_focus_contexts (native_runtime_callback_display);
+}
+
 static gboolean
 meta_gnoblin_drain_native_runtime_operations_idle (gpointer user_data)
 {
@@ -900,6 +911,7 @@ meta_gnoblin_set_native_config_host (gboolean enabled)
   native_config_host_enabled = enabled;
   if (!enabled)
     {
+      meta_gnoblin_revoke_focus_contexts ();
       gnoblin_config_set_runtime_wakeup_callback (NULL, NULL);
       if (native_runtime_callbacks_idle_id)
         {
@@ -918,6 +930,8 @@ meta_gnoblin_set_native_config_host (gboolean enabled)
 void
 meta_gnoblin_set_native_config_display (MetaDisplay *display)
 {
+  if (!display)
+    meta_gnoblin_revoke_focus_contexts ();
   if (native_runtime_callbacks_idle_id)
     {
       g_source_remove (native_runtime_callbacks_idle_id);
@@ -1012,6 +1026,18 @@ meta_gnoblin_drain_native_runtime_operations (MetaDisplay *display)
                                                                &error))
                 continue;
             }
+          else if (g_str_equal (method, "window.focus"))
+            {
+              guint64 context_handle = 0;
+              guint64 generation = 0;
+              if (gnoblin_config_take_focus_context (request_id, &context_handle,
+                                                     &generation))
+                result = gnoblin_native_control_focus_window (
+                  display, arguments, context_handle, generation, &error);
+              else
+                g_set_error_literal (&error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                                     "window.focus requires a live one-use shortcut context");
+            }
           else
             result = meta_gnoblin_dispatch_native_api (display, method,
                                                        arguments, &error);
@@ -1082,6 +1108,40 @@ meta_display_dispatch_gnoblin_event (MetaDisplay *display,
   return FALSE;
 #endif
 }
+
+gboolean
+meta_display_dispatch_gnoblin_shortcut_event (MetaDisplay *display,
+                                              const char  *event,
+                                              GVariant    *payload,
+                                              guint64      context_handle,
+                                              gint64       expires_at_us)
+{
+  gboolean frontend_consumed = FALSE;
+
+#ifdef HAVE_WAYLAND
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) document =
+    gnoblin_config_dispatch_shortcut_event (event, payload, context_handle,
+                                            expires_at_us, &error);
+
+  if (error)
+    {
+      g_warning ("gnoblin Lua shortcut event %s: %s", event, error->message);
+      return FALSE;
+    }
+  if (document)
+    {
+      g_signal_emit_by_name (display, "gnoblin-config-event", event, document,
+                             payload, &frontend_consumed);
+      gnoblin_config_finish_event (TRUE);
+    }
+  if (native_runtime_event_batch_depth == 0)
+    meta_gnoblin_drain_native_runtime_operations (display);
+  return frontend_consumed;
+#else
+  return FALSE;
+#endif
+}
 GVariant *
 meta_gnoblin_call_config_api (const char *method,
                               GVariant   *arguments,
