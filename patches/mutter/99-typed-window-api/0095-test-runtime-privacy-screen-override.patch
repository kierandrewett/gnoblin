From 7e0c184181b345959a4fb8dc3a42023933ce392f Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sun, 4 Oct 2026 16:03:49 +0100
Subject: [PATCH] mutter: test runtime privacy-screen override

---
 .../gnoblin-privacy-screen-settings-test.c    | 45 +++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/src/tests/gnoblin-privacy-screen-settings-test.c b/src/tests/gnoblin-privacy-screen-settings-test.c
index 8f4588860e..59e5764a42 100644
--- a/src/tests/gnoblin-privacy-screen-settings-test.c
+++ b/src/tests/gnoblin-privacy-screen-settings-test.c
@@ -73,6 +73,49 @@ meta_test_gnoblin_privacy_screen_preference (void)
   g_assert_true (meta_settings_is_privacy_screen_enabled (meta_settings));
 }
 
+static void
+meta_test_gnoblin_privacy_screen_runtime_override (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaSettings *meta_settings = meta_backend_get_settings (backend);
+  g_autoptr (GSettings) privacy_settings =
+    g_settings_new ("org.gnome.desktop.privacy");
+  g_autoptr (GVariant) disabled = create_privacy_preferences (FALSE);
+
+  meta_settings_apply_gnoblin_privacy_screen_runtime_override (meta_settings,
+                                                               FALSE,
+                                                               FALSE);
+  meta_settings_apply_gnoblin_privacy_screen_preferences (meta_settings, NULL);
+  g_settings_set_boolean (privacy_settings, "privacy-screen", TRUE);
+  drain_main_context ();
+
+  meta_settings_apply_gnoblin_privacy_screen_preferences (meta_settings,
+                                                          disabled);
+  g_assert_false (meta_settings_is_privacy_screen_enabled (meta_settings));
+
+  meta_settings_apply_gnoblin_privacy_screen_runtime_override (meta_settings,
+                                                               TRUE,
+                                                               TRUE);
+  g_assert_true (meta_settings_is_privacy_screen_enabled (meta_settings));
+  g_assert_true (g_settings_get_boolean (privacy_settings, "privacy-screen"));
+
+  g_settings_set_boolean (privacy_settings, "privacy-screen", FALSE);
+  drain_main_context ();
+  g_assert_true (meta_settings_is_privacy_screen_enabled (meta_settings));
+
+  meta_settings_apply_gnoblin_privacy_screen_runtime_override (meta_settings,
+                                                               FALSE,
+                                                               FALSE);
+  g_assert_false (meta_settings_is_privacy_screen_enabled (meta_settings));
+  g_assert_false (g_settings_get_boolean (privacy_settings, "privacy-screen"));
+
+  meta_settings_apply_gnoblin_privacy_screen_preferences (meta_settings, NULL);
+  g_assert_false (meta_settings_is_privacy_screen_enabled (meta_settings));
+  g_settings_set_boolean (privacy_settings, "privacy-screen", TRUE);
+  drain_main_context ();
+  g_assert_true (meta_settings_is_privacy_screen_enabled (meta_settings));
+}
+
 int
 main (int    argc,
       char **argv)
@@ -90,6 +133,8 @@ main (int    argc,
   test_context = context;
   g_test_add_func ("/settings/gnoblin-privacy-screen-preference",
                    meta_test_gnoblin_privacy_screen_preference);
+  g_test_add_func ("/settings/gnoblin-privacy-screen-runtime-override",
+                   meta_test_gnoblin_privacy_screen_runtime_override);
 
   ret = meta_context_test_run_tests (META_CONTEXT_TEST (context),
                                      META_TEST_RUN_FLAG_CAN_SKIP);
-- 
