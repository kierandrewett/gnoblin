     }
 
   /* Eat the key events if we have a focused surface. */
diff --git a/src/wayland/meta-wayland-pointer.c b/src/wayland/meta-wayland-pointer.c
index 0cab62fc31..21d9f3f262 100644
--- a/src/wayland/meta-wayland-pointer.c
+++ b/src/wayland/meta-wayland-pointer.c
@@ -67,6 +67,7 @@
 #include "wayland/meta-wayland-pointer.h"
 #include "wayland/meta-wayland-popup.h"
 #include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-activation.h"
 #include "wayland/meta-wayland-seat.h"
 #include "wayland/meta-wayland-surface-private.h"
 
@@ -520,6 +521,9 @@ meta_wayland_pointer_send_button (MetaWaylandPointer *pointer,
                                   event_type == CLUTTER_BUTTON_PRESS ? 1 : 0);
         }
 
+      meta_wayland_activation_record_input (
+        meta_wayland_input_device_get_seat (input_device),
+        pointer->focus_surface, serial, event);
       meta_wayland_pointer_broadcast_frame (pointer);
     }
 
diff --git a/src/wayland/meta-wayland-seat.c b/src/wayland/meta-wayland-seat.c
index 19cb7e0919..52427c36ad 100644
--- a/src/wayland/meta-wayland-seat.c
+++ b/src/wayland/meta-wayland-seat.c
@@ -23,6 +23,7 @@
 
 #include "wayland/meta-wayland-data-device.h"
 #include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-activation.h"
 #include "wayland/meta-wayland-surface-private.h"
 #include "wayland/meta-wayland-client-private.h"
 #include "wayland/meta-wayland-tablet-seat.h"
@@ -439,6 +440,8 @@ void
 meta_wayland_seat_update (MetaWaylandSeat    *seat,
                           const ClutterEvent *event)
 {
+  meta_wayland_activation_update_input (seat->compositor, event);
+
   if (is_tablet_event (seat, event))
     {
       meta_wayland_tablet_seat_update (seat->tablet_seat, event);
diff --git a/src/wayland/meta-wayland-tablet-tool.c b/src/wayland/meta-wayland-tablet-tool.c
index d25de93c18..5df83521d3 100644
--- a/src/wayland/meta-wayland-tablet-tool.c
+++ b/src/wayland/meta-wayland-tablet-tool.c
@@ -21,6 +21,8 @@
 
 #include "config.h"
 
+#include "wayland/meta-wayland-activation.h"
+
 #include "wayland/meta-wayland-tablet-tool.h"
 
 #include <glib.h>
@@ -741,6 +743,10 @@ broadcast_down (MetaWaylandTabletTool *tool,
     {
       zwp_tablet_tool_v2_send_down (resource, tool->down_serial);
     }
+  if (!wl_list_empty (&tool->focus_resource_list))
+    meta_wayland_activation_record_input (tool->seat->seat,
+                                          tool->focus_surface,
+                                          tool->down_serial, event);
 }
 
 static void
@@ -772,6 +778,10 @@ broadcast_button (MetaWaylandTabletTool *tool,
                                       ZWP_TABLET_TOOL_V2_BUTTON_STATE_PRESSED :
                                       ZWP_TABLET_TOOL_V2_BUTTON_STATE_RELEASED);
     }
+  if (!wl_list_empty (&tool->focus_resource_list))
+    meta_wayland_activation_record_input (tool->seat->seat,
+                                          tool->focus_surface,
+                                          tool->button_serial, event);
 }
 
 static void
diff --git a/src/wayland/meta-wayland-touch.c b/src/wayland/meta-wayland-touch.c
index 7ff1ea7c36..4a804bf710 100644
--- a/src/wayland/meta-wayland-touch.c
+++ b/src/wayland/meta-wayland-touch.c
@@ -21,6 +21,8 @@
 
 #include "config.h"
 
+#include "wayland/meta-wayland-activation.h"
+
 #include <glib.h>
 #include <string.h>
 
@@ -404,6 +406,11 @@ handle_touch_begin (MetaWaylandTouch   *touch,
                           wl_fixed_from_double (touch_info->y));
     }
 
+  if (!wl_list_empty (l))
+    meta_wayland_activation_record_input (
+      meta_wayland_input_device_get_seat (META_WAYLAND_INPUT_DEVICE (touch)),
+      touch_info->focus_surface->surface, touch_info->slot_serial, event);
+
   touch_info->begin_delivered = TRUE;
 }
 
