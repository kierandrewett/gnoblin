From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 28 Sep 2026 06:18:39 +0100
Subject: [PATCH] mutter: route Lua input source selection to native control

---
diff --git a/src/core/util.c b/src/core/util.c
index e145e2bd8..c65b54fea 100644
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -22,6 +22,7 @@
 #include "config.h"
 
 #include "core/display-private.h"
+#include "core/gnoblin-native-control.h"
 #include "core/meta-workspace-manager-private.h"
 #include "core/util-private.h"
 
@@ -54,6 +55,7 @@
 
 #include "wayland/gnoblin-config.h"
 #include "wayland/gnoblin-console-lua.h"
+#include "wayland/meta-wayland-layer-shell.h"
 
 static const GDebugKey meta_debug_keys[] = {
   { "focus", META_DEBUG_FOCUS },
@@ -907,8 +909,16 @@ meta_gnoblin_drain_native_runtime_operations (MetaDisplay *display)
               continue;
             }
 
-          result = meta_gnoblin_dispatch_native_api (display, method,
-                                                     arguments, &error);
+          if (g_str_equal (method, "input.select"))
+            {
+              if (gnoblin_native_control_select_input_source (display, arguments,
+                                                               request_id, method,
+                                                               &error))
+                continue;
+            }
+          else
+            result = meta_gnoblin_dispatch_native_api (display, method,
+                                                       arguments, &error);
           if (!result && !error)
             g_set_error (&error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
                          "operation '%s' requires a Shell handler", method);
