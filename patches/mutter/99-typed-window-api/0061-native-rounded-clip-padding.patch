From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 14 Sep 2026 16:33:21 +0200
Subject: [PATCH] mutter: apply configured padding to native rounded clips

---
diff --git a/src/compositor/meta-window-actor-wayland.c b/src/compositor/meta-window-actor-wayland.c
index 238e2cb1c..23f24ae27 100644
--- a/src/compositor/meta-window-actor-wayland.c
+++ b/src/compositor/meta-window-actor-wayland.c
@@ -665,7 +665,8 @@ void
 meta_window_actor_wayland_set_rounded_clip (MetaWindowActor *actor,
                                             double           radius,
                                             double           exponent,
-                                            gboolean         automatic)
+                                            gboolean         automatic,
+                                            const double     padding[4])
 {
   MetaWindowActorWayland *self;
 
@@ -673,7 +674,7 @@ meta_window_actor_wayland_set_rounded_clip (MetaWindowActor *actor,
 
   self = META_WINDOW_ACTOR_WAYLAND (actor);
   meta_gnoblin_window_effects_set_rounded_clip (
-    CLUTTER_ACTOR (self->surface_container), radius, exponent, automatic);
+    CLUTTER_ACTOR (self->surface_container), radius, exponent, automatic, padding);
 }
 
 static void
diff --git a/src/compositor/meta-window-actor-wayland.h b/src/compositor/meta-window-actor-wayland.h
index 89054bf60..b05a6f88a 100644
--- a/src/compositor/meta-window-actor-wayland.h
+++ b/src/compositor/meta-window-actor-wayland.h
@@ -39,4 +39,5 @@ void meta_window_actor_wayland_rebuild_surface_tree (MetaWindowActor *actor);
 void meta_window_actor_wayland_set_rounded_clip (MetaWindowActor *actor,
                                                  double           radius,
                                                  double           exponent,
-                                                 gboolean         automatic);
+                                                 gboolean         automatic,
+                                                 const double     padding[4]);
diff --git a/src/compositor/meta-window-actor-x11.c b/src/compositor/meta-window-actor-x11.c
index b360959e3..7f9a6ac99 100644
--- a/src/compositor/meta-window-actor-x11.c
+++ b/src/compositor/meta-window-actor-x11.c
@@ -1071,7 +1071,8 @@ void
 meta_window_actor_x11_set_rounded_clip (MetaWindowActorX11 *actor_x11,
                                         double              radius,
                                         double              exponent,
-                                        gboolean            automatic)
+                                        gboolean            automatic,
+                                        const double        padding[4])
 {
   MetaSurfaceActor *surface;
 
@@ -1082,7 +1083,7 @@ meta_window_actor_x11_set_rounded_clip (MetaWindowActorX11 *actor_x11,
     return;
 
   meta_gnoblin_window_effects_set_rounded_clip (
-    CLUTTER_ACTOR (surface), radius, exponent, automatic);
+    CLUTTER_ACTOR (surface), radius, exponent, automatic, padding);
 }
 
 static void
diff --git a/src/compositor/meta-window-actor-x11.h b/src/compositor/meta-window-actor-x11.h
index 5a58ec3a4..ab62f9789 100644
--- a/src/compositor/meta-window-actor-x11.h
+++ b/src/compositor/meta-window-actor-x11.h
@@ -35,4 +35,5 @@ void meta_window_actor_x11_update_shape (MetaWindowActorX11 *actor_x11);
 void meta_window_actor_x11_set_rounded_clip (MetaWindowActorX11 *actor_x11,
                                              double              radius,
                                              double              exponent,
-                                             gboolean            automatic);
+                                             gboolean            automatic,
+                                             const double        padding[4]);
