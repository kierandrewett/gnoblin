From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Tue, 6 Oct 2026 22:05:00 +0100
Subject: [PATCH] mutter: build native polkit auth agent

---
diff --git a/src/meson.build b/src/meson.build
index 16c3559081..e7f0cbf22f 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -1195,6 +1195,7 @@ libmutter = library(libmutter_name,
   mutter_built_sources,
   files('core/gnoblin-native-control.c'),
   files('core/gnoblin-location-agent.c'),
+  files('core/gnoblin-auth-agent.c'),
   files('core/gnoblin-touchpad-router.c'),
   files('core/gnoblin-keybinding-catalog.c'),
   version: '0.0.0',
@@ -1211,6 +1212,8 @@ libmutter = library(libmutter_name,
     mutter_deps,
     gvdb_dep,
     dependency('json-glib-1.0'),
+    dependency('polkit-agent-1'),
+    dependency('polkit-gobject-1'),
   ],
   install_rpath: pkglibdir,
   install_dir: libdir,
