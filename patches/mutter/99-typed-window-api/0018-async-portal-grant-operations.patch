From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 28 Sep 2026 13:22:48 +0100
Subject: [PATCH] mutter: route Lua portal grant operations to native control

---
diff --git a/src/core/util.c b/src/core/util.c
index 9fbebc249..82b201e70 100644
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -1026,6 +1026,13 @@ meta_gnoblin_drain_native_runtime_operations (MetaDisplay *display)
                                                                &error))
                 continue;
             }
+          else if (g_str_equal (method, "grant.list") ||
+                   g_str_equal (method, "grant.revoke"))
+            {
+              if (gnoblin_native_control_portal_grant_operation (
+                    display, method, arguments, request_id, &error))
+                continue;
+            }
           else if (g_str_equal (method, "window.focus"))
             {
               guint64 context_handle = 0;
