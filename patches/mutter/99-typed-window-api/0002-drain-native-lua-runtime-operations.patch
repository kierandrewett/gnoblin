From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 14 Sep 2026 16:33:21 +0200
Subject: [PATCH] mutter: drain native Lua runtime operations

---
diff --git a/src/core/mutter.c b/src/core/mutter.c
index 0d64d0767..21b17db7b 100644
--- a/src/core/mutter.c
+++ b/src/core/mutter.c
@@ -108,7 +108,6 @@ load_native_config (GVariant **native_document,
   g_autofree char *path = g_canonicalize_filename (gnoblin_config, NULL);
   g_autoptr (GVariant) result = meta_gnoblin_load_config (path);
   g_autoptr (GVariant) document = NULL;
-  g_autoptr (GVariant) events = NULL;
   const char *message = NULL;
 
   if (g_variant_lookup (result, "error", "&s", &message))
@@ -119,17 +118,12 @@ load_native_config (GVariant **native_document,
     }
 
   document = g_variant_lookup_value (result, "document", G_VARIANT_TYPE_VARDICT);
-  events = g_variant_lookup_value (result, "events", G_VARIANT_TYPE_STRING_ARRAY);
   if (!document)
     {
       g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
                    "%s: Lua config did not return a document", path);
       goto reject;
     }
-  if (events && g_variant_n_children (events) > 0)
-    g_warning ("%s: native compositor skips Lua event handlers; start the Gnoblin Shell session to use them",
-               path);
-
   GVariantIter iter;
   const char *key;
   GVariant *value;
@@ -169,6 +163,7 @@ load_native_config (GVariant **native_document,
   g_setenv ("GNOBLIN_CONFIG", path, TRUE);
   g_setenv ("GNOME_SHELL_SESSION_MODE", "gnoblin", TRUE);
   meta_gnoblin_finish_config_load (TRUE);
+  meta_gnoblin_set_native_config_host (TRUE);
   *native_document = g_steal_pointer (&document);
   return TRUE;
 
diff --git a/src/core/util.c b/src/core/util.c
index 289bbb260..123d3f632 100644
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -821,6 +821,108 @@ meta_gnoblin_finish_config_event (gboolean commit)
 #endif
 }
 
+static gboolean native_config_host_enabled;
+static gboolean native_runtime_operations_draining;
+static guint native_runtime_operations_idle_id;
+static void meta_gnoblin_drain_native_runtime_operations (MetaDisplay *display);
+
+static gboolean
+meta_gnoblin_drain_native_runtime_operations_idle (gpointer user_data)
+{
+  MetaDisplay *display = META_DISPLAY (user_data);
+
+  native_runtime_operations_idle_id = 0;
+  meta_gnoblin_drain_native_runtime_operations (display);
+  return G_SOURCE_REMOVE;
+}
+
+void
+meta_gnoblin_set_native_config_host (gboolean enabled)
+{
+  native_config_host_enabled = enabled;
+}
+
+static void
+meta_gnoblin_drain_native_runtime_operations (MetaDisplay *display)
+{
+  const guint max_operations = 256;
+  guint dispatched = 0;
+
+  if (!native_config_host_enabled || native_runtime_operations_draining)
+    return;
+
+  native_runtime_operations_draining = TRUE;
+  while (dispatched < max_operations)
+    {
+      g_autoptr (GVariant) operations =
+        meta_gnoblin_drain_config_runtime_operations ();
+
+      if (!operations || g_variant_n_children (operations) == 0)
+        break;
+
+      /* Draining empties the whole Lua queue. Finish this batch before yielding
+       * so requests past the work budget are not silently discarded. */
+      for (gsize i = 0; i < g_variant_n_children (operations); i++, dispatched++)
+        {
+          g_autoptr (GVariant) operation = g_variant_get_child_value (operations, i);
+          g_autoptr (GVariant) arguments = NULL;
+          g_autoptr (GVariant) result = NULL;
+          g_autoptr (GError) error = NULL;
+          GVariantBuilder completion;
+          const char *method = NULL;
+          gint64 request_id = 0;
+          gboolean ok;
+
+          if (!g_variant_lookup (operation, "request_id", "x", &request_id) ||
+              request_id <= 0 ||
+              !g_variant_lookup (operation, "method", "&s", &method) ||
+              !*method ||
+              !(arguments = g_variant_lookup_value (operation, "arguments",
+                                                      G_VARIANT_TYPE_VARDICT)))
+            {
+              g_warning ("ignoring malformed Gnoblin Lua runtime operation");
+              continue;
+            }
+
+          result = meta_gnoblin_dispatch_native_api (display, method,
+                                                     arguments, &error);
+          if (!result && !error)
+            g_set_error (&error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                         "operation '%s' requires a Shell handler", method);
+          ok = result != NULL;
+
+          g_variant_builder_init (&completion, G_VARIANT_TYPE_VARDICT);
+          g_variant_builder_add (&completion, "{sv}", "request_id",
+                                 g_variant_new_int64 (request_id));
+          g_variant_builder_add (&completion, "{sv}", "method",
+                                 g_variant_new_string (method));
+          g_variant_builder_add (&completion, "{sv}", "ok",
+                                 g_variant_new_boolean (ok));
+          if (ok)
+            g_variant_builder_add (&completion, "{sv}", "result", result);
+          else
+            g_variant_builder_add (&completion, "{sv}", "error",
+                                   g_variant_new_string (error->message));
+
+          g_autoptr (GVariant) payload =
+            g_variant_ref_sink (g_variant_builder_end (&completion));
+          meta_display_dispatch_gnoblin_event (
+            display, "gnoblin.api.operation-completed", payload);
+        }
+    }
+
+  if (dispatched == max_operations)
+    {
+      g_warning ("continuing Gnoblin Lua runtime operation drain in a later main-loop turn");
+      if (!native_runtime_operations_idle_id)
+        native_runtime_operations_idle_id =
+          g_idle_add_full (G_PRIORITY_DEFAULT_IDLE,
+                           meta_gnoblin_drain_native_runtime_operations_idle,
+                           g_object_ref (display), g_object_unref);
+    }
+  native_runtime_operations_draining = FALSE;
+}
+
 gboolean
 meta_display_dispatch_gnoblin_event (MetaDisplay *display,
                                      const char  *event,
@@ -843,6 +945,7 @@ meta_display_dispatch_gnoblin_event (MetaDisplay *display,
       g_signal_emit_by_name (display, "gnoblin-config-event", event, document,
                              payload, &frontend_consumed);
       gnoblin_config_finish_event (TRUE);
+      meta_gnoblin_drain_native_runtime_operations (display);
     }
   return frontend_consumed;
 #else
diff --git a/src/meta/util.h b/src/meta/util.h
index d10d5167f..2cb9be623 100644
--- a/src/meta/util.h
+++ b/src/meta/util.h
@@ -114,6 +114,8 @@ META_EXPORT
 void meta_gnoblin_finish_config_load (gboolean commit);
 META_EXPORT
 void meta_gnoblin_finish_config_event (gboolean commit);
+META_EXPORT
+void meta_gnoblin_set_native_config_host (gboolean enabled);
 
 META_EXPORT
 GVariant *meta_gnoblin_console_lua (const char *operation, const char *source);
