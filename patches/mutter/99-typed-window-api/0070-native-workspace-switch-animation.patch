+  MetaMotionDirection direction;
+  double width, height;
+  gboolean finished;
+} WorkspaceSwitch;
+
 typedef struct {
   GHashTable *previews;
+  WorkspaceSwitch *workspace_switch;
   guint lock_watch_id;
+  gulong shutdown_handler_id;
+  MetaBackend *backend;
 } AnimationState;
 
 typedef struct {
@@ -104,6 +130,12 @@ static void frame_add_number(GVariantBuilder *builder, const char *key,
 static void stop_lock_watch(AnimationState *state);
 static gboolean is_locked(MetaDisplay *display);
 static GVariant *animation_spec_variant(AnimationSpec *spec);
+static void workspace_switch_stop(WorkspaceSwitch *workspace_switch,
+                                  gboolean complete);
+static void workspace_switch_stop_for_display(MetaDisplay *display,
+                                              gboolean complete);
+static void workspace_switch_shutdown(MetaBackend *backend,
+                                      MetaDisplay *display);
 
