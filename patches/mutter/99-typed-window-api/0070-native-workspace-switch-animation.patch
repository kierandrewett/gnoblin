   float base_pivot_x, base_pivot_y;
 } AnimationPreview;
 
+typedef struct {
+  ClutterActor *actor;
+  ClutterActor *parent;
+  ClutterActor *previous_sibling;
+  ClutterActor *next_sibling;
+  gboolean was_visible;
+} WorkspaceActorState;
+
+typedef struct {
+  MetaDisplay *display;
+  MetaPlugin *plugin;
+  ClutterActor *stage;
+  ClutterActor *outgoing_group;
+  ClutterActor *incoming_group;
+  ClutterTimeline *timeline;
