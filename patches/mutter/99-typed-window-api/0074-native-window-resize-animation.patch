                                                      : actor_keys;
   GVariant *maps[] = {spec->from, spec->to};
   for (guint i = 0; i < G_N_ELEMENTS(maps); i++)
@@ -1765,8 +1808,8 @@ static gboolean animation_supports_lifecycle_event(const char *name,
 
   if (g_str_equal(name, "none"))
     return g_strv_contains((const char *const[]){"minimize", "restore", "open",
-                                                  "close", "workspace-switch",
