   default:
     g_assert_not_reached();
   }
@@ -1270,8 +1311,10 @@ static gboolean validate_previewable(AnimationSpec *spec, GError **error) {
   static const char *const actor_keys[] = {
       "x", "y", "scale", "scale_x", "scale_y", "rotation", "opacity", NULL};
   static const char *const workspace_keys[] = {"progress", NULL};
+  static const char *const resize_keys[] = {"progress", NULL};
   const char *const *allowed_keys =
       g_str_equal(spec->event, "workspace-switch") ? workspace_keys
