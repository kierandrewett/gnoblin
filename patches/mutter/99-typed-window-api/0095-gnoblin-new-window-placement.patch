diff --git a/src/meta/prefs.h b/src/meta/prefs.h
index 10a345cd..30770a67 100644
--- a/src/meta/prefs.h
+++ b/src/meta/prefs.h
@@ -29,6 +29,23 @@
 #include "meta/common.h"
 #include "meta/types.h"
 
+
+/**
+ * MetaNewWindowPlacement:
+ * @META_NEW_WINDOW_PLACEMENT_FREE_SPACE: the first free area of the monitor, cascading from the top-left when none fits
+ * @META_NEW_WINDOW_PLACEMENT_CENTER: centred on the monitor work area
+ * @META_NEW_WINDOW_PLACEMENT_CASCADE: always cascaded diagonally from the top-left
+ *
+ * Where normal windows are placed when they are first mapped. Dialogs,
+ * modal dialogs, splash screens and transients keep Mutter's own placement.
+ */
+typedef enum
+{
+  META_NEW_WINDOW_PLACEMENT_FREE_SPACE,
+  META_NEW_WINDOW_PLACEMENT_CENTER,
+  META_NEW_WINDOW_PLACEMENT_CASCADE,
+} MetaNewWindowPlacement;
+
 /**
  * MetaPreference:
  * @META_PREF_MOUSE_BUTTON_MODS: mouse button modifiers
@@ -61,7 +78,7 @@
  * @META_PREF_WORKSPACES_ONLY_ON_PRIMARY: workspaces only on primary
  * @META_PREF_DRAGGABLE_BORDER_WIDTH: draggable border width
  * @META_PREF_AUTO_MAXIMIZE: auto-maximize
- * @META_PREF_CENTER_NEW_WINDOWS: center new windows
+ * @META_PREF_NEW_WINDOW_PLACEMENT: new window placement
  * @META_PREF_DRAG_THRESHOLD: drag threshold
  * @META_PREF_LOCATE_POINTER: show pointer location
  */
@@ -99,7 +116,7 @@ typedef enum
   META_PREF_WORKSPACES_ONLY_ON_PRIMARY,
   META_PREF_DRAGGABLE_BORDER_WIDTH,
   META_PREF_AUTO_MAXIMIZE,
-  META_PREF_CENTER_NEW_WINDOWS,
+  META_PREF_NEW_WINDOW_PLACEMENT,
   META_PREF_DRAG_THRESHOLD,
   META_PREF_LOCATE_POINTER,
   META_PREF_CHECK_ALIVE_TIMEOUT,
@@ -187,7 +204,7 @@ META_EXPORT
 gboolean                    meta_prefs_get_auto_maximize      (void);
 
 META_EXPORT
-gboolean                    meta_prefs_get_center_new_windows (void);
+MetaNewWindowPlacement      meta_prefs_get_new_window_placement (void);
 
 META_EXPORT
 gboolean                    meta_prefs_get_show_fallback_app_menu (void);
