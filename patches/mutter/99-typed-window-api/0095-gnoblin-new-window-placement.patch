diff --git a/data/org.gnome.mutter.gschema.xml.in b/data/org.gnome.mutter.gschema.xml.in
index 40f6c2ef..9d30706a 100644
--- a/data/org.gnome.mutter.gschema.xml.in
+++ b/data/org.gnome.mutter.gschema.xml.in
@@ -92,12 +92,18 @@
       </description>
     </key>
 
-    <key name="center-new-windows" type="b">
-      <default>true</default>
-      <summary>Place new windows in the center</summary>
+    <key name="new-window-placement" type="s">
+      <choices>
+        <choice value="free_space"/>
+        <choice value="center"/>
+        <choice value="cascade"/>
+      </choices>
+      <default>'free_space'</default>
+      <summary>Where new normal windows are placed</summary>
       <description>
-        When true, the new windows will always be put in the center of the
-        active screen of the monitor.
+        free_space places a new window in the first free area of the monitor,
+        center opens it centred on the work area, and cascade always steps it
+        diagonally from the top-left. Dialogs and transients keep Mutter placement.
       </description>
     </key>
 
