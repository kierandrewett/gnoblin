From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 2 Nov 2026 22:48:55 +0000
Subject: [PATCH] eis: build against libei 1.3.0

Fedora 41 and Alpine 3.21 ship libei 1.3.0. libeis added the
EIS_EVENT_SYNC event in 1.3.901, and the code names it in a switch case.
Leave that case out when the library does not have the event, with a
define in config.h.meson as for HAVE_EIS_EVENT_REF.

The case already does nothing below libei 1.5.0, because its body needs
eis_event_ref(). libeis 1.3.0 answers a client sync itself and sends no
event. So below libei 1.5.0 a sync from a remote desktop client is
answered at once and does not wait for queued real input. This was
already the behaviour with libei 1.3.901 and 1.4.

diff --git a/config.h.meson b/config.h.meson
index 1230506e5..a225c87e2 100644
--- a/config.h.meson
+++ b/config.h.meson
@@ -120,6 +120,9 @@
 /* Building with font rendering integration support */
 #mesondefine HAVE_FONTS
 
+/* Whether libeis has the EIS_EVENT_SYNC event (1.3.901) */
+#mesondefine HAVE_EIS_EVENT_SYNC
+
 /* Whether libei has eis_event_ref() */
 #mesondefine HAVE_EIS_EVENT_REF
 
diff --git a/meson.build b/meson.build
index 7a8e29cb8..4fcd43c13 100644
--- a/meson.build
+++ b/meson.build
@@ -37,7 +37,7 @@ libcanberra_req = '>= 0.26'
 libwacom_req = '>= 0.13'
 atk_req = '>= 2.5.3'
 harfbuzz_req = '>= 2.6'
-libei_req = '>= 1.3.901'
+libei_req = '>= 1.3.0'
 libdisplay_info_req = '>= 0.2'
 
 # optional version requirements
@@ -590,6 +590,8 @@ cdata.set('HAVE_FONTS', have_fonts)
 cdata.set('HAVE_DRM_PLANE_SIZE_HINT', have_drm_plane_size_hint)
 cdata.set('HAVE_XKBCOMMON_KANA_COMPOSE_LEDS',
   xkbcommon_dep.version().version_compare('>= 1.8.0'))
+cdata.set('HAVE_EIS_EVENT_SYNC',
+  libeis_dep.version().version_compare('>= 1.3.901'))
 cdata.set('HAVE_EIS_EVENT_REF',
   libeis_dep.version().version_compare('>= 1.5.0'))
 cdata.set('HAVE_ASAN_TESTS', have_asan_tests)
diff --git a/src/backends/meta-eis.c b/src/backends/meta-eis.c
index 0ef1b88ee..5d2df6c26 100644
--- a/src/backends/meta-eis.c
+++ b/src/backends/meta-eis.c
@@ -151,6 +151,7 @@ process_event (MetaEis          *eis,
     case EIS_EVENT_CLIENT_DISCONNECT:
       meta_eis_remove_client (eis, eis_client);
       break;
+#ifdef HAVE_EIS_EVENT_SYNC
     case EIS_EVENT_SYNC:
 #ifdef HAVE_EIS_EVENT_REF
       if (META_IS_BACKEND_NATIVE (eis->backend))
@@ -173,6 +174,7 @@ process_event (MetaEis          *eis,
         }
 #endif /* HAVE_EIS_EVENT_REF */
       break;
+#endif /* HAVE_EIS_EVENT_SYNC */
     default:
       client = g_hash_table_lookup (eis->eis_clients, eis_client);
       if (!client)
