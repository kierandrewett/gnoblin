From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 14 Sep 2026 16:33:21 +0200
Subject: [PATCH] clutter: build against GLib 2.80

Ubuntu 24.04 ships GLib 2.80.0. Mutter asks for 2.81.1 only for
g_sort_array(), which replaced g_qsort_with_data() in GLib 2.82. Both
sort the same array with the same comparison function, and both are
stable sorts, so the layout result is the same.

Use g_qsort_with_data() when GLib is older than 2.82. Nothing is lost.

---
diff --git a/clutter/clutter/clutter-box-layout.c b/clutter/clutter/clutter-box-layout.c
index d6ec39606..86e9ec572 100644
--- a/clutter/clutter/clutter-box-layout.c
+++ b/clutter/clutter/clutter-box-layout.c
@@ -585,9 +585,15 @@ distribute_natural_allocation (float          extra_space,
    */
 
   /* Sort descending by gap and position. */
+#if GLIB_CHECK_VERSION (2, 82, 0)
   g_sort_array (spreading,
                 n_requested_sizes, sizeof (unsigned int),
                 compare_gap, sizes);
+#else
+  g_qsort_with_data (spreading,
+                     n_requested_sizes, sizeof (unsigned int),
+                     compare_gap, sizes);
+#endif
 
   /* Distribute available space.
    * This master piece of a loop was conceived by Behdad Esfahbod.
diff --git a/clutter/clutter/clutter-grid-layout.c b/clutter/clutter/clutter-grid-layout.c
index 129208043..7643a94bc 100644
--- a/clutter/clutter/clutter-grid-layout.c
+++ b/clutter/clutter/clutter-grid-layout.c
@@ -971,9 +971,15 @@ distribute_natural_allocation (gint           extra_space,
    */
 
   /* Sort descending by gap and position. */
+#if GLIB_CHECK_VERSION (2, 82, 0)
   g_sort_array (spreading,
                 n_requested_sizes, sizeof (guint),
                 compare_gap, sizes);
+#else
+  g_qsort_with_data (spreading,
+                     n_requested_sizes, sizeof (guint),
+                     compare_gap, sizes);
+#endif
 
   /* Distribute available space.
    * This master piece of a loop was conceived by Behdad Esfahbod.
diff --git a/meson.build b/meson.build
index 94b69a389..fdc9a7400 100644
--- a/meson.build
+++ b/meson.build
@@ -16,7 +16,7 @@ mutter_builddir = meson.current_build_dir()
 lcms2_req = '>= 2.6'
 colord_req = '>= 1.4.5'
 fribidi_req = '>= 1.0.0'
-glib_req = '>= 2.81.1'
+glib_req = '>= 2.80.0'
 gi_req = '>= 0.9.5'
 graphene_req = '>= 1.10.2'
 gtk3_req = '>= 3.19.8'
