diff --git a/meson.build b/meson.build
index cdd13b683..a70c8e4c4 100644
--- a/meson.build
+++ b/meson.build
@@ -25,7 +25,7 @@ pango_req = '>= 1.46.0'
 cairo_req = '>= 1.10.0'
 pangocairo_req = '>= 1.20'
 pixman_req = '>= 0.42'
-gsettings_desktop_schemas_req = '>= 51.rc'
+gsettings_desktop_schemas_req = '>= 49.1'
 x11_req = '>= 1.7.0'
 xcomposite_req = '>= 0.4'
 xkbcommon_req = '>= 0.4.3'
@@ -55,7 +55,7 @@ gbm_req = '>= 21.3'
 libdrm_req = '>= 2.4.118'
 
 # screen cast version requirements
-libpipewire_req = '>= 1.6.0'
+libpipewire_req = '>= 1.4.11'
 
 # profiler requirements
 sysprof_req = '>= 3.37.2'
