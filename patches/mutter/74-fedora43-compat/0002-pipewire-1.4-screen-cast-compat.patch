From b08406a70612957d7aa9489199e5071599575729 Mon Sep 17 00:00:00 2001
From: Gnoblin Build <build@gnoblin.local>
Date: Sat, 26 Sep 2026 09:00:00 +0100
Subject: [PATCH] screencast: keep device negotiation optional on older PipeWire

PipeWire capability and peer-capability parameters were added in 1.5.84.
Mutter 51 otherwise builds against PipeWire 1.4, so keep the newer
device-ID negotiation path conditional on the installed PipeWire API.

---
diff --git a/meson.build b/meson.build
index cdd13b683..3cf6a3c55 100644
--- a/meson.build
+++ b/meson.build
@@ -278,2 +278,5 @@ if have_remote_desktop
   libpipewire_dep = dependency('libpipewire-0.3', version: libpipewire_req)
+  if libpipewire_dep.version().version_compare('>= 1.5.84')
+    add_project_arguments('-DHAVE_PIPEWIRE_CAPABILITIES', language: 'c')
+  endif
 endif
diff --git a/src/backends/meta-stream-source.c b/src/backends/meta-stream-source.c
index 263a05d4e..e71c27c41 100644
--- a/src/backends/meta-stream-source.c
+++ b/src/backends/meta-stream-source.c
@@ -24,14 +24,22 @@
 #include <fcntl.h>
 #include <glib/gstdio.h>
 #include <pipewire/pipewire.h>
+#ifdef HAVE_PIPEWIRE_CAPABILITIES
 #include <pipewire/capabilities.h>
+#endif
 #include <spa/debug/pod.h>
+#ifdef HAVE_PIPEWIRE_CAPABILITIES
 #include <spa/param/dict.h>
+#endif
+#ifdef HAVE_PIPEWIRE_CAPABILITIES
 #include <spa/param/dict-utils.h>
+#endif
 #include <spa/param/props.h>
 #include <spa/param/format-utils.h>
 #include <spa/param/tag-utils.h>
+#ifdef HAVE_PIPEWIRE_CAPABILITIES
 #include <spa/param/peer-utils.h>
+#endif
 #include <spa/param/video/format-utils.h>
 #include <spa/pod/dynamic.h>
 #include <spa/utils/result.h>
@@ -1894,2 +1896,3 @@
+#ifdef HAVE_PIPEWIRE_CAPABILITIES
 static void
 append_capabilities_dict_entry (MetaStreamSource *source,
@@ -1984,2 +1987,3 @@
+#endif
 static void
 build_stream_params (MetaStreamSource       *source,
@@ -1990,3 +1994,5 @@ build_stream_params (MetaStreamSource       *source,
   build_tag_params (source, pod_builder, pod_offsets);
+#ifdef HAVE_PIPEWIRE_CAPABILITIES
   build_capability_params (source, pod_builder, pod_offsets);
+#endif
 }
@@ -2473,2 +2479,3 @@
+#ifdef HAVE_PIPEWIRE_CAPABILITIES
 static void
 negotiate_with_device_cb (gpointer user_data)
@@ -2561,2 +2568,3 @@
+#endif
 static void
 on_stream_param_changed (void                 *data,
@@ -2576,7 +2584,9 @@ on_stream_param_changed (void                 *data,
     case SPA_PARAM_Tag:
       on_tag_param_changed (source, param);
       break;
+#ifdef HAVE_PIPEWIRE_CAPABILITIES
     case SPA_PARAM_PeerCapability:
       on_peer_capability_param_changed (source, param);
       break;
+#endif
     }
--
2.55.0
