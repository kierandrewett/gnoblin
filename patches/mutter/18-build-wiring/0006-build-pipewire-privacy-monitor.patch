From: kierandrewett <kieran@drewett.dev>
Date: Mon, 14 Sep 2026 16:33:21 +0200
Subject: [PATCH] mutter: build PipeWire microphone privacy monitor

---
diff --git a/src/meson.build b/src/meson.build
index a41656735..ab7dde010 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -1179,6 +1179,10 @@ mutter_sources += [
   'wayland/gnoblin-lua-pattern.c',
 ]
 
+if have_remote_desktop
+  mutter_sources += 'core/gnoblin-pipewire-monitor.c'
+endif
+
 libmutter = library(libmutter_name,
   mutter_sources,
   mutter_built_sources,
