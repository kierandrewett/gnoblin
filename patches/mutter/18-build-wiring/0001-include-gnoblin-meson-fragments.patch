From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Wed, 4 Nov 2026 17:16:04 +0000
Subject: [PATCH] mutter: include the Gnoblin Meson fragments

Include the Gnoblin Meson fragments that the overlays install, and the test fragment, before Mutter builds the test
executables from test_cases. The Gnoblin settings tests are overlay files, src/tests/*-gnoblin-settings-test.c, and
their test_cases entries are the overlay fragment src/tests/gnoblin-tests/meson.build.
---
 src/meson.build       | 24 +++++++++++-------------
 src/tests/meson.build |  2 ++
 2 files changed, 13 insertions(+), 13 deletions(-)

diff --git a/src/meson.build b/src/meson.build
index 60970cef..3ce67428 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -11,6 +11,12 @@ mutter_includes = [
 mutter_lib_deps = [
   m_dep,
 ]
+if have_ibus
+  mutter_lib_deps += ibus_dep
+endif
+if have_hyprcursor
+  mutter_lib_deps += hyprcursor_dep
+endif
 
 mutter_pkg_deps = [
   gio_unix_dep,
@@ -1057,6 +1063,8 @@ else
   ]
 endif
 
+subdir('gnoblin-wiring')
+
 protocol_xmls = files()
 
 foreach p: wayland_protocols
@@ -1114,6 +1122,7 @@ subdir('third_party')
 libmutter = library(libmutter_name,
   mutter_sources,
   mutter_built_sources,
+  gnoblin_libmutter_sources,
   version: '0.0.0',
   soversion: 0,
   gnu_symbol_visibility: 'hidden',
@@ -1127,6 +1136,7 @@ libmutter = library(libmutter_name,
     libmutter_clutter_dep,
     mutter_deps,
     gvdb_dep,
+    gnoblin_libmutter_deps,
   ],
   install_rpath: pkglibdir,
   install_dir: libdir,
@@ -1144,19 +1154,7 @@ libmutter_dep = declare_dependency(
   ],
 )
 
-mutter = executable('mutter',
-  sources: [
-    files('core/mutter.c'),
-  ],
-  include_directories: mutter_includes,
-  c_args: [
-    mutter_c_args,
-    '-DG_LOG_DOMAIN="mutter"',
-  ],
-  dependencies: [libmutter_dep],
-  install_dir: bindir,
-  install: true,
-)
+subdir('gnoblin-executable')
 
 if have_introspection
   mutter_introspected_sources = []
diff --git a/src/tests/meson.build b/src/tests/meson.build
index a58ddacf..262c952f 100644
--- a/src/tests/meson.build
+++ b/src/tests/meson.build
@@ -1291,6 +1291,8 @@ test_cases += [
   },
 ]
 
+subdir('gnoblin-tests')
+
 foreach test_case: test_cases
   test_executable = executable('mutter-' + test_case['name'],
     sources: test_case['sources'],
-- 
2.55.0

