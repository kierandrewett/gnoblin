From e21cb11361fd6feb43654ceb9695c0b8e37d6169 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sat, 26 Sep 2026 00:13:23 +0100
Subject: [PATCH] wayland: retain xdg roles through resource teardown

Wayland resources keep raw pointers to their MetaWaylandXdgSurface role. During client teardown, wl_surface resources can be destroyed before xdg_surface or xdg_toplevel resources, releasing the surface-owned role first. Keep one GObject reference for each constructed xdg resource until its destructor has finished using the role.
---
 src/wayland/meta-wayland-xdg-shell.c | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/wayland/meta-wayland-xdg-shell.c b/src/wayland/meta-wayland-xdg-shell.c
index f191021c95..03777793fc 100644
--- a/src/wayland/meta-wayland-xdg-shell.c
+++ b/src/wayland/meta-wayland-xdg-shell.c
@@ -221,6 +221,8 @@ xdg_toplevel_destructor (struct wl_resource *resource)
 
   meta_wayland_shell_surface_destroy_window (shell_surface);
   xdg_toplevel->resource = NULL;
+
+  g_object_unref (xdg_toplevel);
 }
 
 static void
@@ -609,6 +611,8 @@ xdg_popup_destructor (struct wl_resource *resource)
   xdg_popup->resource = NULL;
 
   meta_wayland_compositor_sync_focus (wayland_compositor);
+
+  g_object_unref (xdg_popup);
 }
 
 static void
@@ -1860,6 +1864,8 @@ xdg_surface_destructor (struct wl_resource *resource)
 
   priv->resource = NULL;
   priv->first_buffer_attached = FALSE;
+
+  g_object_unref (xdg_surface);
 }
 
 static void
@@ -2250,7 +2256,7 @@ meta_wayland_xdg_surface_constructor_finalize (MetaWaylandXdgSurfaceConstructor
 
   wl_resource_set_implementation (constructor->resource,
                                   &meta_wayland_xdg_surface_interface,
-                                  xdg_surface,
+                                  g_object_ref (xdg_surface),
                                   xdg_surface_destructor);
 
   g_free (constructor);
@@ -2298,7 +2304,7 @@ xdg_surface_constructor_get_toplevel (struct wl_client   *client,
                                                id);
   wl_resource_set_implementation (xdg_toplevel->resource,
                                   &meta_wayland_xdg_toplevel_interface,
-                                  xdg_toplevel,
+                                  g_object_ref (xdg_toplevel),
                                   xdg_toplevel_destructor);
 
   xdg_surface = META_WAYLAND_XDG_SURFACE (xdg_toplevel);
@@ -2374,7 +2380,7 @@ xdg_surface_constructor_get_popup (struct wl_client   *client,
                                             id);
   wl_resource_set_implementation (xdg_popup->resource,
                                   &meta_wayland_xdg_popup_interface,
-                                  xdg_popup,
+                                  g_object_ref (xdg_popup),
                                   xdg_popup_destructor);
 
   xdg_surface = META_WAYLAND_XDG_SURFACE (xdg_popup);
-- 
