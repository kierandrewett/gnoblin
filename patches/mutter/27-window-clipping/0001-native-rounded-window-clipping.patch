From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Fri, 25 Sep 2026 14:00:00 +0100
Subject: [PATCH] mutter: add native rounded window clipping

Clip native windows with rounded corners on Wayland and X11 window actors, and apply the configured padding to the
rounded clips.
---
 src/compositor/meta-window-actor-wayland.c | 17 +++++++++++++++++
 src/compositor/meta-window-actor-wayland.h |  6 ++++++
 src/compositor/meta-window-actor-x11.c     | 20 ++++++++++++++++++++
 src/compositor/meta-window-actor-x11.h     |  6 ++++++
 4 files changed, 49 insertions(+)

diff --git a/src/compositor/meta-window-actor-wayland.c b/src/compositor/meta-window-actor-wayland.c
index 310c953e..23f24ae2 100644
--- a/src/compositor/meta-window-actor-wayland.c
+++ b/src/compositor/meta-window-actor-wayland.c
@@ -24,6 +24,7 @@
 #include "compositor/meta-cullable.h"
 #include "compositor/meta-surface-actor-wayland.h"
 #include "compositor/meta-window-actor-wayland.h"
+#include "compositor/meta-gnoblin-window-effects.h"
 #include "meta/meta-window-actor.h"
 #include "wayland/meta-wayland-actor-surface.h"
 #include "wayland/meta-wayland-buffer.h"
@@ -660,6 +661,22 @@ meta_window_actor_wayland_sync_geometry (MetaWindowActor *actor)
   self->needs_sync = !do_sync_geometry (self);
 }
 
+void
+meta_window_actor_wayland_set_rounded_clip (MetaWindowActor *actor,
+                                            double           radius,
+                                            double           exponent,
+                                            gboolean         automatic,
+                                            const double     padding[4])
+{
+  MetaWindowActorWayland *self;
+
+  g_return_if_fail (META_IS_WINDOW_ACTOR_WAYLAND (actor));
+
+  self = META_WINDOW_ACTOR_WAYLAND (actor);
+  meta_gnoblin_window_effects_set_rounded_clip (
+    CLUTTER_ACTOR (self->surface_container), radius, exponent, automatic, padding);
+}
+
 static void
 meta_window_actor_wayland_map (ClutterActor *actor)
 {
diff --git a/src/compositor/meta-window-actor-wayland.h b/src/compositor/meta-window-actor-wayland.h
index c32c8b77..b05a6f88 100644
--- a/src/compositor/meta-window-actor-wayland.h
+++ b/src/compositor/meta-window-actor-wayland.h
@@ -35,3 +35,9 @@ G_DECLARE_FINAL_TYPE (MetaSurfaceContainerActorWayland,
                       ClutterActor)
 
 void meta_window_actor_wayland_rebuild_surface_tree (MetaWindowActor *actor);
+
+void meta_window_actor_wayland_set_rounded_clip (MetaWindowActor *actor,
+                                                 double           radius,
+                                                 double           exponent,
+                                                 gboolean         automatic,
+                                                 const double     padding[4]);
diff --git a/src/compositor/meta-window-actor-x11.c b/src/compositor/meta-window-actor-x11.c
index 54b03c0d..7f9a6ac9 100644
--- a/src/compositor/meta-window-actor-x11.c
+++ b/src/compositor/meta-window-actor-x11.c
@@ -26,6 +26,7 @@
 #include "clutter/clutter-frame-clock.h"
 #include "compositor/compositor-private.h"
 #include "compositor/meta-cullable.h"
+#include "compositor/meta-gnoblin-window-effects.h"
 #include "compositor/meta-shaped-texture-private.h"
 #include "compositor/meta-surface-actor.h"
 #include "core/window-private.h"
@@ -1066,6 +1067,25 @@ meta_window_actor_x11_update_shape (MetaWindowActorX11 *actor_x11)
   clutter_actor_queue_redraw (CLUTTER_ACTOR (surface));
 }
 
+void
+meta_window_actor_x11_set_rounded_clip (MetaWindowActorX11 *actor_x11,
+                                        double              radius,
+                                        double              exponent,
+                                        gboolean            automatic,
+                                        const double        padding[4])
+{
+  MetaSurfaceActor *surface;
+
+  g_return_if_fail (META_IS_WINDOW_ACTOR_X11 (actor_x11));
+
+  surface = meta_window_actor_get_surface (META_WINDOW_ACTOR (actor_x11));
+  if (!surface)
+    return;
+
+  meta_gnoblin_window_effects_set_rounded_clip (
+    CLUTTER_ACTOR (surface), radius, exponent, automatic, padding);
+}
+
 static void
 handle_updates (MetaWindowActorX11 *actor_x11)
 {
diff --git a/src/compositor/meta-window-actor-x11.h b/src/compositor/meta-window-actor-x11.h
index dfcd3428..ab62f978 100644
--- a/src/compositor/meta-window-actor-x11.h
+++ b/src/compositor/meta-window-actor-x11.h
@@ -31,3 +31,9 @@ G_DECLARE_FINAL_TYPE (MetaWindowActorX11,
                       MetaWindowActor)
 
 void meta_window_actor_x11_update_shape (MetaWindowActorX11 *actor_x11);
+
+void meta_window_actor_x11_set_rounded_clip (MetaWindowActorX11 *actor_x11,
+                                             double              radius,
+                                             double              exponent,
+                                             gboolean            automatic,
+                                             const double        padding[4]);
-- 
2.55.0

