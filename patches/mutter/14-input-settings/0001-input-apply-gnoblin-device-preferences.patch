+void
+meta_display_apply_gnoblin_input_config (MetaDisplay *display,
+                                         GVariant    *input)
+{
+  MetaBackend *backend;
+  MetaInputSettings *input_settings;
+  MetaInputSettingsPrivate *priv;
+  GHashTableIter iter;
+  gpointer value;
+
+  g_return_if_fail (META_IS_DISPLAY (display));
+  g_return_if_fail (input == NULL || g_variant_is_of_type (input, G_VARIANT_TYPE_VARDICT));
+
+  backend = meta_context_get_backend (meta_display_get_context (display));
+  input_settings = meta_backend_get_input_settings (backend);
+  if (!input_settings)
+    return;
+
+  priv = meta_input_settings_get_instance_private (input_settings);
+  g_clear_pointer (&priv->gnoblin_config, g_variant_unref);
+  if (input)
+    priv->gnoblin_config = g_variant_ref_sink (g_variant_get_normal_form (input));
+
+  priv->gnoblin_numlock_state = input_get_boolean (input_settings,
+                                                  priv->keyboard_settings,
+                                                  "numlock-state");
+
+  apply_device_settings (input_settings, NULL);
+  update_keyboard_repeat (input_settings);
+
+  g_hash_table_iter_init (&iter, priv->mappable_devices);
+  while (g_hash_table_iter_next (&iter, NULL, &value))
+    apply_mappable_device_settings (input_settings, value);
+
+  g_hash_table_iter_init (&iter, priv->current_tools);
+  while (g_hash_table_iter_next (&iter, NULL, &value))
+    {
+      CurrentToolInfo *tool_info = value;
+      apply_stylus_settings (input_settings, tool_info->device, tool_info->tool);
+    }
+}
