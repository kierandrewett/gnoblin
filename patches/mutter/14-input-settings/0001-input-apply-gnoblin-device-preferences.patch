+/* Gnoblin input settings are an in-memory overlay. The desktop schemas remain
+ * the fallback for keys that Gnoblin does not specify. */
+static GVariant *
+gnoblin_setting (MetaInputSettings *input_settings,
+                 GSettings         *settings,
+                 const char        *key)
+{
+  MetaInputSettingsPrivate *priv = meta_input_settings_get_instance_private (input_settings);
+  const char *group = NULL;
+  const char *selector;
+  GVariant *group_dict = NULL;
+  GVariant *device_dict = NULL;
+  GVariant *value = NULL;
+
+  if (!priv->gnoblin_config)
+    return NULL;
+
+  if (settings == priv->mouse_settings)
+    group = "mouse";
+  else if (settings == priv->touchpad_settings)
+    group = "touchpad";
+  else if (settings == priv->keyboard_settings)
+    group = "keyboard";
+  else if ((selector = g_object_get_qdata (G_OBJECT (settings), quark_gnoblin_settings_selector)))
+    group = g_str_has_prefix (selector, "tablets:") ? "tablets" : "styluses";
+  else
+    return NULL;
+
+  group_dict = g_variant_lookup_value (priv->gnoblin_config, group, G_VARIANT_TYPE_VARDICT);
+  if (!group_dict)
+    return NULL;
+
+  if (g_str_equal (group, "tablets") || g_str_equal (group, "styluses"))
+    {
+      selector = g_object_get_qdata (G_OBJECT (settings), quark_gnoblin_settings_selector);
+      if (selector)
+        device_dict = g_variant_lookup_value (group_dict, strchr (selector, ':') + 1,
+                                              G_VARIANT_TYPE_VARDICT);
+      g_variant_unref (group_dict);
+      group_dict = device_dict;
+      if (!group_dict)
+        return NULL;
+    }
+
+  value = g_variant_lookup_value (group_dict, key, NULL);
+  g_variant_unref (group_dict);
+  return value;
+}
+
+static gboolean
+input_settings_has_key (MetaInputSettings *input_settings,
+                        GSettings         *settings,
+                        const char        *key)
+{
+  MetaInputSettingsPrivate *priv = meta_input_settings_get_instance_private (input_settings);
+  const char *schema_id = NULL;
+  const char *selector;
+  g_autoptr (GSettingsSchema) schema = NULL;
+
+  if (settings == priv->mouse_settings)
+    schema_id = "org.gnome.desktop.peripherals.mouse";
+  else if (settings == priv->touchpad_settings)
+    schema_id = "org.gnome.desktop.peripherals.touchpad";
+  else if (settings == priv->trackball_settings)
+    schema_id = "org.gnome.desktop.peripherals.trackball";
+  else if (settings == priv->pointing_stick_settings)
+    schema_id = "org.gnome.desktop.peripherals.pointingstick";
+  else if (settings == priv->keyboard_settings)
+    schema_id = "org.gnome.desktop.peripherals.keyboard";
+  else if (settings == priv->keyboard_a11y_settings)
+    schema_id = "org.gnome.desktop.a11y.keyboard";
+  else if ((selector = g_object_get_qdata (G_OBJECT (settings),
+                                           quark_gnoblin_settings_selector)))
+    schema_id = g_str_has_prefix (selector, "tablets:")
+                ? "org.gnome.desktop.peripherals.tablet"
+                : "org.gnome.desktop.peripherals.tablet.stylus";
+  else
+    return TRUE;
+
+  schema = g_settings_schema_source_lookup (g_settings_schema_source_get_default (),
+                                            schema_id, TRUE);
+  return schema && g_settings_schema_has_key (schema, key);
+}
+
+static void
+set_gnoblin_settings_selector (GSettings  *settings,
+                               const char *group,
+                               const char *selector)
+{
+  g_object_set_qdata_full (G_OBJECT (settings), quark_gnoblin_settings_selector,
+                           g_strdup_printf ("%s:%s", group, selector), g_free);
+}
+
+static gboolean
+input_get_boolean (MetaInputSettings *input_settings,
+                   GSettings         *settings,
+                   const char        *key)
+{
+  GVariant *value = gnoblin_setting (input_settings, settings, key);
+  gboolean result = value && g_variant_is_of_type (value, G_VARIANT_TYPE_BOOLEAN)
+                    ? g_variant_get_boolean (value)
+                    : input_settings_has_key (input_settings, settings, key)
+                      ? g_settings_get_boolean (settings, key)
+                      : FALSE;
+  g_clear_pointer (&value, g_variant_unref);
+  return result;
+}
+
+static double
+input_get_double (MetaInputSettings *input_settings,
+                  GSettings         *settings,
+                  const char        *key)
+{
+  GVariant *value = gnoblin_setting (input_settings, settings, key);
+  double result = value && g_variant_is_of_type (value, G_VARIANT_TYPE_DOUBLE)
+                  ? g_variant_get_double (value)
+                  : input_settings_has_key (input_settings, settings, key)
+                    ? g_settings_get_double (settings, key)
+                    : 0.0;
+  g_clear_pointer (&value, g_variant_unref);
+  return result;
+}
+
+static guint
+input_get_uint (MetaInputSettings *input_settings,
+                GSettings         *settings,
+                const char        *key)
+{
+  GVariant *value = gnoblin_setting (input_settings, settings, key);
+  guint result = value && g_variant_is_of_type (value, G_VARIANT_TYPE_UINT32)
+                 ? g_variant_get_uint32 (value)
+                 : input_settings_has_key (input_settings, settings, key)
+                   ? g_settings_get_uint (settings, key)
+                   : 0;
+  g_clear_pointer (&value, g_variant_unref);
+  return result;
+}
+
+static gint
+input_get_int (MetaInputSettings *input_settings,
+               GSettings         *settings,
+               const char        *key)
+{
+  GVariant *value = gnoblin_setting (input_settings, settings, key);
+  gint result = value && g_variant_is_of_type (value, G_VARIANT_TYPE_INT32)
+                ? g_variant_get_int32 (value)
+                : input_settings_has_key (input_settings, settings, key)
+                  ? g_settings_get_int (settings, key)
+                  : 0;
+  g_clear_pointer (&value, g_variant_unref);
+  return result;
+}
+
+static gint
+input_get_enum (MetaInputSettings *input_settings,
+                GSettings         *settings,
+                const char        *key)
+{
+  MetaInputSettingsPrivate *priv = meta_input_settings_get_instance_private (input_settings);
+  GVariant *value = gnoblin_setting (input_settings, settings, key);
+  gint result = input_settings_has_key (input_settings, settings, key)
+                ? g_settings_get_enum (settings, key)
+                : 0;
+
+  if (value)
+    {
+      if (g_variant_is_of_type (value, G_VARIANT_TYPE_INT32))
+        result = g_variant_get_int32 (value);
+      else if (g_variant_is_of_type (value, G_VARIANT_TYPE_STRING))
+        {
+          const char *nick = g_variant_get_string (value, NULL);
+          const char * const *nicks = NULL;
+          static const char * const accel[] = { "default", "flat", "adaptive", "custom", NULL };
+          static const char * const handed[] = { "right", "left", "follow-mouse", NULL };
+          static const char * const tap_map[] = { "default", "left-right-middle", "left-middle-right", NULL };
+          static const char * const click[] = { "default", "none", "areas", "fingers", NULL };
+          static const char * const mapping[] = { "absolute", "relative", NULL };
+          static const char * const stylus[] = {
+            "default", "middle", "right", "back", "forward",
+            "switch-monitor", "keybinding", NULL
+          };
+          const char *selector = g_object_get_qdata (G_OBJECT (settings),
+                                                     quark_gnoblin_settings_selector);
+
+          if (g_str_equal (key, "accel-profile"))
+            nicks = accel;
+          else if (g_str_equal (key, "left-handed"))
+            nicks = handed;
+          else if (g_str_equal (key, "tap-button-map"))
+            nicks = tap_map;
+          else if (g_str_equal (key, "click-method"))
+            nicks = click;
+          else if (g_str_equal (key, "mapping"))
+            nicks = mapping;
+          else if (g_str_has_suffix (key, "button-action"))
+            nicks = stylus;
+
+          if (nicks)
+            for (gint i = 0; nicks[i]; i++)
+              if (g_str_equal (nick, nicks[i]))
+                {
+                  result = i;
+                  break;
+                }
+
+          /* Avoid applying an enum string to unrelated settings that happen
+           * to share a key name. */
+          if (!selector && settings != priv->mouse_settings &&
+              settings != priv->touchpad_settings)
+            result = input_settings_has_key (input_settings, settings, key)
+                     ? g_settings_get_enum (settings, key)
+                     : 0;
+        }
+    }
+  g_clear_pointer (&value, g_variant_unref);
+  return result;
+}
