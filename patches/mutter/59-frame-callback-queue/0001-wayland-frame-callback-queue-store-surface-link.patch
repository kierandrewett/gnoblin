From 64f6ae7ca305044814fc1fcb5b0e54388487db97 Mon Sep 17 00:00:00 2001
From: Gnoblin <gnoblin@example.invalid>
Date: Sat, 12 Sep 2026 05:00:00 +0100
Subject: [PATCH] wayland: remove frame callback surfaces in constant time

Each wl_surface.frame request adds its surface to the compositor callback
queue. A surface can have many callbacks, but it needs one queue entry.

Keep that entry on MetaWaylandSurface. This removes the linear list search
when a callback is queued and the linear removal when a surface is destroyed.
The callback delivery order and timing do not change.
---
 src/wayland/meta-wayland-surface-private.h |  1 +
 src/wayland/meta-wayland.c                 | 14 +++++++++++---
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/src/wayland/meta-wayland-surface-private.h b/src/wayland/meta-wayland-surface-private.h
index e08cca7f0..ca67c3725 100644
--- a/src/wayland/meta-wayland-surface-private.h
+++ b/src/wayland/meta-wayland-surface-private.h
@@ -185,6 +185,7 @@ struct _MetaWaylandSurface
   MetaWaylandClient *client;
   MetaWaylandCompositor *compositor;
   MetaWaylandSurfaceRole *role;
+  GList *frame_callback_surface_link;
   MtkRegion *input_region;
   MtkRegion *opaque_region;
   MtkRegion *background_blur_region;
diff --git a/src/wayland/meta-wayland.c b/src/wayland/meta-wayland.c
index 12031d380..cc842a806 100644
--- a/src/wayland/meta-wayland.c
+++ b/src/wayland/meta-wayland.c
@@ -238,6 +238,7 @@ emit_frame_callbacks_for_stage_view (MetaWaylandCompositor *compositor,
 
       compositor->frame_callback_surfaces =
         g_list_delete_link (compositor->frame_callback_surfaces, l_cur);
+      surface->frame_callback_surface_link = NULL;
     }
 }
 
@@ -271,6 +272,7 @@ emit_layer_shell_frame_callbacks (gpointer user_data)
 
       compositor->frame_callback_surfaces =
         g_list_delete_link (compositor->frame_callback_surfaces, l_cur);
+      surface->frame_callback_surface_link = NULL;
     }
 
   return G_SOURCE_REMOVE;
@@ -670,11 +672,12 @@ void
 meta_wayland_compositor_add_frame_callback_surface (MetaWaylandCompositor *compositor,
                                                     MetaWaylandSurface    *surface)
 {
-  if (g_list_find (compositor->frame_callback_surfaces, surface))
+  if (surface->frame_callback_surface_link)
     return;
 
-  compositor->frame_callback_surfaces =
+  surface->frame_callback_surface_link =
     g_list_prepend (compositor->frame_callback_surfaces, surface);
+  compositor->frame_callback_surfaces = surface->frame_callback_surface_link;
 
   if (meta_wayland_surface_is_layer_shell (surface))
     schedule_layer_shell_frame_callbacks (compositor);
@@ -684,8 +687,13 @@ void
 meta_wayland_compositor_remove_frame_callback_surface (MetaWaylandCompositor *compositor,
                                                        MetaWaylandSurface    *surface)
 {
+  if (!surface->frame_callback_surface_link)
+    return;
+
   compositor->frame_callback_surfaces =
-    g_list_remove (compositor->frame_callback_surfaces, surface);
+    g_list_delete_link (compositor->frame_callback_surfaces,
+                        surface->frame_callback_surface_link);
+  surface->frame_callback_surface_link = NULL;
 }
 
 void
