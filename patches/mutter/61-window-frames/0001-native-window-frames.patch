+diff --git a/src/core/events.c b/src/core/events.c
+index 567abead3d91e89a376e5050675a21fdb8d9ce20..556fd72b3c69f001d820aa0c72d86b6ccf8b00f1 100644
+--- a/src/core/events.c
++++ b/src/core/events.c
+@@ -32,6 +32,7 @@
+ #include "compositor/meta-window-actor-private.h"
+ #include "core/display-private.h"
+ #include "core/window-private.h"
++#include "core/util-private.h"
+ #include "meta/meta-backend.h"
+ 
+ #ifdef HAVE_NATIVE_BACKEND
+@@ -174,6 +175,7 @@ meta_display_handle_event (MetaDisplay        *display,
+   ClutterSeat *seat;
+   gboolean has_grab;
+   gboolean a11y_grabbed;
++  gboolean fullscreen_return_guarded = FALSE;
+   MetaTabletActionMapper *mapper;
+   MetaEventMode mode_hint;
+ #ifdef HAVE_WAYLAND
+@@ -235,13 +237,21 @@ meta_display_handle_event (MetaDisplay        *display,
+         }
+     }
+ 
++  window = get_window_for_event (display, event, event_actor);
++  if (event_type == CLUTTER_BUTTON_PRESS || event_type == CLUTTER_BUTTON_RELEASE)
++    fullscreen_return_guarded =
++      meta_gnoblin_consume_fullscreen_return_event (display, window,
++                                                    event_type == CLUTTER_BUTTON_PRESS,
++                                                    clutter_event_get_button (event));
++
+ #ifdef HAVE_WAYLAND
+   if (wayland_text_input &&
++      !fullscreen_return_guarded &&
+       !meta_compositor_get_current_window_drag (compositor) &&
+       meta_wayland_text_input_update (wayland_text_input, event))
+     return CLUTTER_EVENT_STOP;
+ 
+-  if (wayland_compositor)
++  if (wayland_compositor && !fullscreen_return_guarded)
+     meta_wayland_compositor_update (wayland_compositor, event);
+ #endif
+ 
+@@ -306,9 +316,7 @@ meta_display_handle_event (MetaDisplay        *display,
+       meta_cursor_tracker_invalidate_position (cursor_tracker);
+     }
+ 
+-  window = get_window_for_event (display, event, event_actor);
+-
+-  if (window && !window->override_redirect &&
++  if (window && !fullscreen_return_guarded && !window->override_redirect &&
+       (event_type == CLUTTER_KEY_PRESS ||
+        event_type == CLUTTER_BUTTON_PRESS ||
+        event_type == CLUTTER_TOUCH_BEGIN))
+@@ -332,7 +340,8 @@ meta_display_handle_event (MetaDisplay        *display,
+ 
+   gesture_tracker = meta_display_get_gesture_tracker (display);
+ 
+-  if (meta_gesture_tracker_handle_event (gesture_tracker,
++  if (!fullscreen_return_guarded &&
++      meta_gesture_tracker_handle_event (gesture_tracker,
+                                          stage_from_display (display),
+                                          event))
+     return CLUTTER_EVENT_PROPAGATE;
+@@ -372,7 +381,7 @@ meta_display_handle_event (MetaDisplay        *display,
+   if (stage_has_grab (display))
+     return CLUTTER_EVENT_PROPAGATE;
+ 
+-  if (window)
++  if (window && !fullscreen_return_guarded)
+     {
+       if (meta_window_handle_ungrabbed_event (window, event))
+         return CLUTTER_EVENT_STOP;
+@@ -406,11 +415,15 @@ meta_display_handle_event (MetaDisplay        *display,
+           time_ms != CLUTTER_CURRENT_TIME)
+         meta_window_check_alive_on_event (window, time_ms);
+ 
+-      if (meta_wayland_compositor_handle_event (wayland_compositor, event))
++      if (!fullscreen_return_guarded &&
++          meta_wayland_compositor_handle_event (wayland_compositor, event))
+         return CLUTTER_EVENT_STOP;
+     }
+ #endif
+ 
++  if (fullscreen_return_guarded)
++    return CLUTTER_EVENT_PROPAGATE;
++
+   return meta_compositor_handle_event (compositor, event, window, mode_hint);
+ }
+ 
+diff --git a/src/core/util-private.h b/src/core/util-private.h
+index 5f466df518ae59a783d4dd545bca4a3e0939d7c4..0723d8fd41c895fed76fe98c5a76abfc1455393e 100644
