From 538e00625701dc1d4f7314b98ab153fc55bd3951 Mon Sep 17 00:00:00 2001
From: Gnoblin <gnoblin@localhost>
Date: Sun, 13 Sep 2026 03:05:31 +0100
Subject: [PATCH] Attach native frames and isolated external renderer services

---
 src/meson.build                    | 2 ++
 src/meta/util.h                    | 2 ++
 src/wayland/meta-wayland-surface.c | 4 ++++
 3 files changed, 8 insertions(+)

diff --git a/src/meson.build b/src/meson.build
index 2c70138d7..79a2e752f 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -601,6 +601,8 @@ mutter_sources += [
   'wayland/gnoblin-glob.c',
   'wayland/meta-gnoblin-window-frame.c',
   'wayland/meta-gnoblin-window-frame.h',
+  'wayland/meta-gnoblin-frame-renderer.c',
+  'wayland/meta-gnoblin-frame-renderer.h',
   'wayland/gnoblin-config.h',
   'wayland/meta-gnoblin-protocols.c',
   'wayland/meta-gnoblin-protocols.h',
diff --git a/src/meta/util.h b/src/meta/util.h
index 758684b32..1efda07da 100644
--- a/src/meta/util.h
+++ b/src/meta/util.h
@@ -125,6 +125,8 @@ META_EXPORT
 gboolean meta_gnoblin_window_frame_set (MetaWindow *window, GVariant *policy, GError **error);
 META_EXPORT
 GVariant *meta_gnoblin_window_frame_get (MetaWindow *window);
+META_EXPORT
+void meta_gnoblin_window_frame_style (MetaWindow *window, GVariant *options);
 
 META_EXPORT
 void meta_gnoblin_fullscreen_return_guard_set (MetaDisplay *display,
diff --git a/src/wayland/meta-wayland-surface.c b/src/wayland/meta-wayland-surface.c
index 47a3de39c..98724cc5b 100644
--- a/src/wayland/meta-wayland-surface.c
+++ b/src/wayland/meta-wayland-surface.c
@@ -19,6 +19,7 @@
  */
 
 #include "config.h"
+#include "wayland/meta-gnoblin-frame-renderer.h"
 
 #include "wayland/meta-wayland-surface-private.h"
 
@@ -492,6 +493,7 @@ meta_wayland_surface_state_clear (MetaWaylandSurfaceState *state)
 {
   MetaWaylandFrameCallback *cb, *next;
 
+  g_object_set_data (G_OBJECT (state), "gnoblin-frame-commit", NULL);
   g_clear_object (&state->texture);
   g_clear_object (&state->drm_syncobj.acquire);
   g_clear_object (&state->drm_syncobj.release);
@@ -696,6 +698,8 @@ meta_wayland_surface_state_merge_into (MetaWaylandSurfaceState *from,
   g_set_object (&to->drm_syncobj.release, from->drm_syncobj.release);
   g_clear_object (&from->drm_syncobj.release);
 
+  meta_gnoblin_frame_renderer_merge_state (from, to);
+
   if (from->has_new_color_state)
     {
       g_set_object (&to->color_state, from->color_state);
-- 
2.55.0

