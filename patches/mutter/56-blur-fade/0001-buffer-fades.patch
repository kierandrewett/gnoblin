From 4954d9d828fa0a3bf05df6d225dc07b01630010f Mon Sep 17 00:00:00 2001
From: Gnoblin <gnoblin@localhost>
Date: Thu, 24 Sep 2026 21:32:57 +0100
Subject: [PATCH] Commit client blur fade metadata with surface state

---
 src/meson.build                    | 3 +++
 src/wayland/meta-wayland-surface.c | 4 ++++
 2 files changed, 7 insertions(+)

diff --git a/src/meson.build b/src/meson.build
index 525334d4b..ddaae02bd 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -599,6 +599,8 @@ mutter_sources += [
   'wayland/gnoblin-config.h',
   'wayland/meta-gnoblin-protocols.c',
   'wayland/meta-gnoblin-protocols.h',
+  'wayland/meta-wayland-blur-fade.c',
+  'wayland/meta-wayland-blur-fade.h',
   'wayland/meta-wayland-idle-notify.c',
   'wayland/meta-wayland-idle-notify.h',
   'wayland/meta-wayland-foreign-toplevel-common.c',
@@ -1087,6 +1089,7 @@ wayland_protocols = [
   ['wlr-gamma-control-unstable-v1', 'private', ],
   ['wlr-output-power-management-unstable-v1', 'private', ],
   ['ext-data-control-v1', 'private', ],
+  ['gnoblin-blur-fade-v1', 'private', ],
   ['ext-session-lock-v1', 'private', ],
 ]
 
diff --git a/src/wayland/meta-wayland-surface.c b/src/wayland/meta-wayland-surface.c
index a0bfdcaf4..47a3de39c 100644
--- a/src/wayland/meta-wayland-surface.c
+++ b/src/wayland/meta-wayland-surface.c
@@ -40,6 +40,7 @@
 #include "wayland/meta-wayland-client-private.h"
 #include "wayland/meta-wayland-color-representation.h"
 #include "wayland/meta-gnoblin-protocols.h"
+#include "wayland/meta-wayland-blur-fade.h"
 #include "wayland/meta-wayland-fractional-scale.h"
 #include "wayland/meta-wayland-gtk-shell.h"
 #include "wayland/meta-wayland-layer-shell.h"
@@ -527,6 +528,7 @@ void
 meta_wayland_surface_state_merge_into (MetaWaylandSurfaceState *from,
                                        MetaWaylandSurfaceState *to)
 {
+  meta_wayland_blur_fade_merge_state (from, to);
   if (from->newly_attached)
     {
       if (to->buffer)
@@ -1095,6 +1097,8 @@ meta_wayland_surface_apply_state (MetaWaylandSurface      *surface,
   if (state->newly_attached && surface->buffer_held)
     g_clear_object (&state->buffer);
 
+  meta_wayland_blur_fade_apply_state (surface, state);
+
   g_signal_emit (state,
                  surface_state_signals[SURFACE_STATE_SIGNAL_APPLIED],
                  0);
-- 
2.55.0

