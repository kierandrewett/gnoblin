From fb87b97820ec67d23d893d6adc74c06df4690354 Mon Sep 17 00:00:00 2001
From: Gnoblin <gnoblin@localhost>
Date: Thu, 24 Sep 2026 21:26:42 +0100
Subject: [PATCH] session-lock: embargo capture and remote input

---
 src/backends/meta-remote-desktop-session.c |  22 +++++
 src/backends/meta-screen-cast-session.c    |  49 ++++++++++++
 src/backends/meta-stream-source.c          | 127 ++++++++++++++++++++++++++++-
 3 files changed, 196 insertions(+), 2 deletions(-)

diff --git a/src/backends/meta-remote-desktop-session.c b/src/backends/meta-remote-desktop-session.c
index 242509261..b0bf24565 100644
--- a/src/backends/meta-remote-desktop-session.c
+++ b/src/backends/meta-remote-desktop-session.c
@@ -44,8 +44,10 @@
 #include "core/display-private.h"
 #include "core/meta-sealed-fd.h"
 #include "meta/meta-backend.h"
+#include "meta/meta-wayland-compositor.h"

 #include "meta-dbus-remote-desktop.h"
+#include "wayland/meta-wayland-session-lock.h"

 #define META_REMOTE_DESKTOP_SESSION_DBUS_PATH "/org/gnome/Mutter/RemoteDesktop/Session"

@@ -415,6 +417,18 @@ check_permission (MetaRemoteDesktopSession *session,
                     g_dbus_method_invocation_get_sender (invocation)) == 0;
 }

+static gboolean
+is_session_lock_active (MetaRemoteDesktopSession *session)
+{
+  MetaBackend *backend =
+    meta_dbus_session_manager_get_backend (session->session_manager);
+  MetaContext *context = meta_backend_get_context (backend);
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (context);
+
+  return compositor && meta_wayland_session_lock_is_active (compositor);
+}
+
 static gboolean
 meta_remote_desktop_session_check_can_notify (MetaRemoteDesktopSession *session,
                                               GDBusMethodInvocation    *invocation)
@@ -435,6 +449,14 @@ meta_remote_desktop_session_check_can_notify (MetaRemoteDesktopSession *session,
       return FALSE;
     }

+  if (is_session_lock_active (session))
+    {
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_ACCESS_DENIED,
+                                             "Remote input is unavailable while the session is locked");
+      return FALSE;
+    }
+
   return TRUE;
 }

diff --git a/src/backends/meta-screen-cast-session.c b/src/backends/meta-screen-cast-session.c
index 672b7fd8d..df2d37947 100644
--- a/src/backends/meta-screen-cast-session.c
+++ b/src/backends/meta-screen-cast-session.c
@@ -34,8 +34,10 @@
 #include "backends/meta-stream-window.h"
 #include "backends/meta-virtual-monitor.h"
 #include "core/display-private.h"
+#include "meta/meta-wayland-compositor.h"

 #include "meta-private-enum-types.h"
+#include "wayland/meta-wayland-session-lock.h"

 #define META_SCREEN_CAST_SESSION_DBUS_PATH "/org/gnome/Mutter/ScreenCast/Session"

@@ -82,6 +84,31 @@ struct _MetaScreenCastSession
   MetaRemoteDesktopSession *remote_desktop_session;
 };

+static gboolean
+is_session_lock_active (MetaScreenCastSession *session)
+{
+  MetaBackend *backend =
+    meta_dbus_session_manager_get_backend (session->session_manager);
+  MetaContext *context = meta_backend_get_context (backend);
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (context);
+
+  return compositor && meta_wayland_session_lock_is_active (compositor);
+}
+
+static gboolean
+check_capture_allowed (MetaScreenCastSession  *session,
+                       GDBusMethodInvocation *invocation)
+{
+  if (!is_session_lock_active (session))
+    return TRUE;
+
+  g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                         G_DBUS_ERROR_ACCESS_DENIED,
+                                         "Screen capture is unavailable while the session is locked");
+  return FALSE;
+}
+
 static void initable_init_iface (GInitableIface *iface);

 static void
@@ -143,6 +170,13 @@ meta_screen_cast_session_start (MetaScreenCastSession  *session,
 {
   GList *l;

+  if (is_session_lock_active (session))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                           "Screen capture is unavailable while the session is locked");
+      return FALSE;
+    }
+
   for (l = session->streams; l; l = l->next)
     {
       MetaScreenCastStream *screen_cast_stream = l->data;
@@ -327,6 +361,9 @@ handle_start (MetaDBusScreenCastSession *skeleton,
       return TRUE;
     }

+  if (!check_capture_allowed (session, invocation))
+    return TRUE;
+
   switch (session->session_type)
     {
     case META_SCREEN_CAST_SESSION_TYPE_NORMAL:
@@ -459,6 +496,9 @@ handle_record_monitor (MetaDBusScreenCastSession *skeleton,
       return G_DBUS_METHOD_INVOCATION_HANDLED;
     }

+  if (!check_capture_allowed (session, invocation))
+    return G_DBUS_METHOD_INVOCATION_HANDLED;
+
   interface_skeleton = G_DBUS_INTERFACE_SKELETON (skeleton);
   connection = g_dbus_interface_skeleton_get_connection (interface_skeleton);

@@ -568,6 +608,9 @@ handle_record_window (MetaDBusScreenCastSession *skeleton,
       return G_DBUS_METHOD_INVOCATION_HANDLED;
     }

+  if (!check_capture_allowed (session, invocation))
+    return G_DBUS_METHOD_INVOCATION_HANDLED;
+
   if (properties_variant)
     window_id_variant = g_variant_lookup_value (properties_variant,
                                                 "window-id",
@@ -687,6 +730,9 @@ handle_record_area (MetaDBusScreenCastSession *skeleton,
       return G_DBUS_METHOD_INVOCATION_HANDLED;
     }

+  if (!check_capture_allowed (session, invocation))
+    return G_DBUS_METHOD_INVOCATION_HANDLED;
+
   if (!g_variant_lookup (properties_variant, "cursor-mode", "u", &cursor_mode))
     {
       cursor_mode = META_SCREEN_CAST_CURSOR_MODE_HIDDEN;
@@ -860,6 +906,9 @@ handle_record_virtual (MetaDBusScreenCastSession *skeleton,
       return G_DBUS_METHOD_INVOCATION_HANDLED;
     }

+  if (!check_capture_allowed (session, invocation))
+    return G_DBUS_METHOD_INVOCATION_HANDLED;
+
   if (!g_variant_lookup (properties_variant, "cursor-mode", "u", &cursor_mode))
     {
       cursor_mode = META_SCREEN_CAST_CURSOR_MODE_HIDDEN;
diff --git a/src/backends/meta-stream-source.c b/src/backends/meta-stream-source.c
index 263a05d4e..1a2bf543d 100644
--- a/src/backends/meta-stream-source.c
+++ b/src/backends/meta-stream-source.c
@@ -43,6 +43,7 @@

 #include "backends/meta-stream.h"
 #include "core/meta-fraction.h"
+#include "meta/meta-wayland-compositor.h"

 #include "backends/native/meta-device-pool.h"
 #include "backends/native/meta-drm-buffer.h"
@@ -51,6 +52,7 @@
 #include "backends/native/meta-renderer-native-private.h"
 #include "common/meta-drm-timeline.h"
 #include "mtk/mtk.h"
+#include "wayland/meta-wayland-session-lock.h"

 #define CURSOR_META_SIZE(width, height) \
   (sizeof (struct spa_meta_cursor) + \
@@ -160,6 +162,9 @@ typedef struct _MetaStreamSourcePrivate

   gboolean must_drive;
   gboolean pending_process;
+
+  MetaWaylandCompositor *session_lock_compositor;
+  gulong session_lock_state_changed_id;
 } MetaStreamSourcePrivate;

 typedef struct _MetaStreamBuffer
@@ -1096,7 +1101,10 @@ do_record_frame (MetaStreamSource      *source,
       damage = mtk_region_create_rectangle (&full_rect);
     }

-  if (spa_data->data || spa_data->type == SPA_DATA_MemFd)
+  /* A negotiated memfd must be mapped before it can be handed to a consumer.
+   * Treat a missing mapping as a failure rather than dereferencing NULL or
+   * leaving the previous desktop frame current at the PipeWire peer. */
+  if (spa_data->type == SPA_DATA_MemFd && spa_data->data)
     {
       int width = priv->video_format.size.width;
       int height = priv->video_format.size.height;
@@ -1148,6 +1156,75 @@ do_record_frame (MetaStreamSource      *source,
   return result;
 }

+static gboolean
+is_session_lock_active (MetaStreamSource *source)
+{
+  MetaStreamSourcePrivate *priv =
+    meta_stream_source_get_instance_private (source);
+  MetaBackend *backend = meta_stream_get_backend (priv->stream);
+  MetaContext *context = meta_backend_get_context (backend);
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (context);
+
+  return compositor && meta_wayland_session_lock_is_active (compositor);
+}
+
+static void
+on_session_lock_state_changed (MetaWaylandCompositor      *compositor,
+                               MetaWaylandSessionLockState state,
+                               gpointer                     user_data)
+{
+  MetaStreamSource *source = user_data;
+
+  (void) compositor;
+
+  if (state == META_WAYLAND_SESSION_LOCK_UNLOCKED)
+    return;
+
+  /* The transition callback closes the idle-stream gap: a monitor or window
+   * that has no desktop damage still gets a black PipeWire frame as COVERING
+   * begins.  record_frame() applies the same guard for every later frame. */
+  meta_stream_source_record_frame (source,
+                                   META_STREAM_RECORD_FLAG_NONE,
+                                   META_STREAM_PAINT_PHASE_DETACHED);
+}
+
+static gboolean
+record_black_frame (MetaStreamSource *source,
+                    struct spa_buffer *spa_buffer)
+{
+  MetaStreamSourcePrivate *priv =
+    meta_stream_source_get_instance_private (source);
+  struct spa_data *spa_data = &spa_buffer->datas[0];
+
+  if (spa_data->type == SPA_DATA_MemFd && spa_data->data)
+    {
+      memset (spa_data->data, 0, spa_data->maxsize);
+      return TRUE;
+    }
+
+  if (spa_data->type == SPA_DATA_DmaBuf)
+    {
+      CoglDmaBufHandle *dmabuf_handle =
+        g_hash_table_lookup (priv->dmabuf_handles,
+                             GINT_TO_POINTER (spa_data->fd));
+      CoglFramebuffer *framebuffer;
+      CoglColor black;
+
+      if (!dmabuf_handle)
+        return FALSE;
+
+      framebuffer = cogl_dma_buf_handle_get_framebuffer (dmabuf_handle);
+      cogl_color_init_from_4f (&black, 0.f, 0.f, 0.f, 1.f);
+      cogl_framebuffer_clear (framebuffer, COGL_BUFFER_BIT_COLOR, &black);
+      cogl_framebuffer_flush (framebuffer);
+      maybe_set_sync_points (source, spa_buffer);
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
 gboolean
 meta_stream_source_is_driving (MetaStreamSource *source)
 {
@@ -1462,6 +1539,8 @@ meta_stream_source_record_frame_with_timestamp (MetaStreamSource     *source,
   struct spa_buffer *spa_buffer;
   struct spa_meta_header *header;
   struct spa_data *spa_data;
+  gboolean frame_recorded;
+  gboolean close_after_queue = FALSE;
   g_autoptr (MtkRegion) damage = NULL;
   g_autoptr (GError) error = NULL;

@@ -1482,6 +1561,8 @@ meta_stream_source_record_frame_with_timestamp (MetaStreamSource     *source,
       meta_topic (META_DEBUG_SCREEN_CAST,
                   "Couldn't dequeue a buffer from pipewire stream: %s",
                   error->message);
+      if (is_session_lock_active (source))
+        meta_stream_source_close (source);
       meta_stream_source_queue_follow_up (source, flags);
       return record_result;
     }
@@ -1500,6 +1581,11 @@ meta_stream_source_record_frame_with_timestamp (MetaStreamSource     *source,
         header->flags = SPA_META_HEADER_FLAG_CORRUPTED;

       queue_pw_buffer (source, buffer, FALSE);
+      /* An invalid PipeWire buffer cannot replace the unlocked frame. Close
+       * the stream after returning this buffer so a locked session never
+       * leaves an active capture peer showing frozen desktop content. */
+      if (is_session_lock_active (source))
+        meta_stream_source_close (source);
       return record_result;
     }

@@ -1510,7 +1596,23 @@ meta_stream_source_record_frame_with_timestamp (MetaStreamSource     *source,
       else
         damage = mtk_region_create ();

-      if (do_record_frame (source, flags, paint_phase, buffer, damage, &error))
+      if (is_session_lock_active (source))
+        {
+          frame_recorded = record_black_frame (source, spa_buffer);
+          if (!frame_recorded)
+            {
+              /* A stale PipeWire frame is safer than a failed lock only if
+               * the stream is torn down. Do not leave a peer with an active
+               * stream whose last successful frame is the unlocked desktop. */
+              g_warning ("Closing screen-cast stream: cannot produce lock cover frame");
+              close_after_queue = TRUE;
+            }
+        }
+      else
+        frame_recorded = do_record_frame (source, flags, paint_phase, buffer,
+                                          damage, &error);
+
+      if (frame_recorded)
         {
           struct spa_meta_region *spa_meta_video_crop;

@@ -1587,6 +1689,9 @@ meta_stream_source_record_frame_with_timestamp (MetaStreamSource     *source,
                    buffer,
                    !(spa_data->chunk->flags & SPA_CHUNK_FLAG_CORRUPTED));

+  if (close_after_queue)
+    meta_stream_source_close (source);
+
   return record_result;
 }

@@ -3113,6 +3218,14 @@ meta_stream_source_constructed (GObject *object)
     meta_stream_source_get_instance_private (source);

   priv->render_device = get_render_device (source);
+  priv->session_lock_compositor =
+    meta_context_get_wayland_compositor (
+      meta_backend_get_context (meta_stream_get_backend (priv->stream)));
+  if (priv->session_lock_compositor)
+    priv->session_lock_state_changed_id =
+      meta_wayland_session_lock_add_state_changed_callback (
+        priv->session_lock_compositor, on_session_lock_state_changed,
+        source, NULL);

   G_OBJECT_CLASS (meta_stream_source_parent_class)->constructed (object);
 }
@@ -3129,6 +3242,13 @@ meta_stream_source_dispose (GObject *object)
   if (meta_stream_source_is_enabled (source))
     meta_stream_source_disable (source);

+  if (priv->session_lock_state_changed_id)
+    {
+      meta_wayland_session_lock_remove_state_changed_callback (
+        priv->session_lock_compositor, priv->session_lock_state_changed_id);
+      priv->session_lock_state_changed_id = 0;
+    }
+
   g_hash_table_iter_init (&modifierIter,
                           priv->modifiers);
   while (g_hash_table_iter_next (&modifierIter, &key, &value))

