From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sun, 21 Jun 2026 14:20:00 +0100
Subject: [PATCH] window-management: constrain drags to reserved work areas

---
diff --git a/src/compositor/meta-window-drag.c b/src/compositor/meta-window-drag.c
index 85a999756..059785ab9 100644
--- a/src/compositor/meta-window-drag.c
+++ b/src/compositor/meta-window-drag.c
@@ -27,6 +27,7 @@
 #include "core/window-private.h"
 #include "meta/meta-enum-types.h"
 #include "mtk/mtk.h"
+#include "core/gnoblin-native-control.h"
 
 #ifdef HAVE_XWAYLAND
 #include "x11/meta-x11-frame.h"
@@ -1991,6 +1992,13 @@ meta_window_drag_begin (MetaWindowDrag      *window_drag,
 
   meta_window_get_frame_rect (grab_window, &window_drag->drag_rect);
 
+  /* Snapshot the supervisor-owned policy per grab so reloads do not make an
+   * in-flight pointer operation jump. */
+  window_drag->constrain_drag_to_work_area =
+    gnoblin_native_control_is_session (display) &&
+    gnoblin_native_control_get_config_bool (
+      display, "window-management", "constrain-drag-to-work-area", TRUE);
+
   if ((grab_op & META_GRAB_OP_KEYBOARD_MOVING) == META_GRAB_OP_KEYBOARD_MOVING)
     {
       warp_grab_pointer (window_drag, window, grab_op, &root_x, &root_y);
