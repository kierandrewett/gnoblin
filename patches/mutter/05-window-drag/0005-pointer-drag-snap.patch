From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 14 Sep 2026 16:33:21 +0200
Subject: [PATCH] compositor: add supervisor-owned pointer drag snap offers

---
diff --git a/src/compositor/meta-window-drag.c b/src/compositor/meta-window-drag.c
index 72b565da..b417a14b 100644
--- a/src/compositor/meta-window-drag.c
+++ b/src/compositor/meta-window-drag.c
@@ -69,6 +69,7 @@ struct _MetaWindowDrag {
   MetaWindowConfig *initial_window_config;
   int latest_motion_x;
   int latest_motion_y;
+  ClutterModifierType latest_modifier_state;
   MtkRectangle initial_window_pos;
   int initial_x, initial_y;            /* These are only relevant for */
   gboolean threshold_movement_reached; /* raise_on_click == FALSE.    */
@@ -87,6 +88,7 @@ struct _MetaWindowDrag {
   guint tile_preview_timeout_id;
   MetaTileMode preview_tile_mode;
   gboolean pos_hint_set;
+  guint64 gnoblin_snap_drag_id;
 };
 
 G_DEFINE_FINAL_TYPE (MetaWindowDrag, meta_window_drag, G_TYPE_OBJECT)
@@ -420,6 +422,15 @@ meta_window_drag_end (MetaWindowDrag *window_drag)
 
   clear_move_resize_later (window_drag);
 
+  if (window_drag->gnoblin_snap_drag_id)
+    {
+      gnoblin_native_control_window_drag_end (display,
+                                              window_drag->gnoblin_snap_drag_id,
+                                              FALSE,
+                                              "cancelled");
+      window_drag->gnoblin_snap_drag_id = 0;
+    }
+
   g_signal_emit_by_name (display, "grab-op-end", grab_window, grab_op);
 
   g_signal_emit (window_drag, signals[ENDED], 0);
@@ -1542,6 +1553,15 @@ update_move_cb (gpointer user_data)
                window_drag->latest_motion_x,
                window_drag->latest_motion_y);
 
+  if (window_drag->gnoblin_snap_drag_id)
+    gnoblin_native_control_window_drag_update (
+      meta_window_get_display (window_drag->effective_grab_window),
+      window_drag->gnoblin_snap_drag_id,
+      window_drag->effective_grab_window,
+      window_drag->latest_motion_x,
+      window_drag->latest_motion_y,
+      window_drag->latest_modifier_state);
+
   return G_SOURCE_REMOVE;
 }
 
@@ -1801,6 +1821,10 @@ end_grab_op (MetaWindowDrag     *window_drag,
   MetaEdgeResistanceFlags last_flags;
   MetaWindow *window;
   gfloat x, y;
+  gboolean gnoblin_snap_committed = FALSE;
+  g_autofree char *gnoblin_snap_target_id = NULL;
+  MtkRectangle gnoblin_snap_frame;
+  gboolean gnoblin_snap_maximize = FALSE;
 
   window = window_drag->effective_grab_window;
   if (!window)
@@ -1810,6 +1834,20 @@ end_grab_op (MetaWindowDrag     *window_drag,
   modifiers = clutter_event_get_state (event);
   check_threshold_reached (window_drag, (int) x, (int) y);
 
+  if (window_drag->gnoblin_snap_drag_id &&
+      clutter_event_type (event) == CLUTTER_BUTTON_RELEASE)
+    gnoblin_snap_committed =
+      gnoblin_native_control_take_window_drag_snap (
+        meta_window_get_display (window),
+        window_drag->gnoblin_snap_drag_id,
+        window,
+        (int) x,
+        (int) y,
+        clutter_event_get_state (event),
+        &gnoblin_snap_frame,
+        &gnoblin_snap_target_id,
+        &gnoblin_snap_maximize);
+
   /* If the user was snap moving then ignore the button
    * release because they may have let go of shift before
    * releasing the mouse button and they almost certainly do
@@ -1817,7 +1855,8 @@ end_grab_op (MetaWindowDrag     *window_drag,
    * release.
    */
   last_flags = window_drag->last_edge_resistance_flags;
-  if ((last_flags & META_EDGE_RESISTANCE_SNAP) == 0)
+  if (gnoblin_snap_committed ||
+      (last_flags & META_EDGE_RESISTANCE_SNAP) == 0)
     {
       MetaEdgeResistanceFlags flags = META_EDGE_RESISTANCE_DEFAULT;
 
@@ -1827,7 +1866,19 @@ end_grab_op (MetaWindowDrag     *window_drag,
       if (modifiers & CLUTTER_CONTROL_MASK)
         flags |= META_EDGE_RESISTANCE_WINDOWS;
 
-      if (meta_grab_op_is_moving (window_drag->grab_op))
+      if (gnoblin_snap_committed)
+        {
+          hide_tile_preview (window_drag);
+          if (gnoblin_snap_maximize)
+            meta_window_maximize (window);
+          else
+            meta_window_move_resize_frame (window, TRUE,
+                                           gnoblin_snap_frame.x,
+                                           gnoblin_snap_frame.y,
+                                           gnoblin_snap_frame.width,
+                                           gnoblin_snap_frame.height);
+        }
+      else if (meta_grab_op_is_moving (window_drag->grab_op))
         {
           if (window_drag->preview_tile_mode != META_TILE_NONE)
             {
@@ -1860,6 +1911,15 @@ end_grab_op (MetaWindowDrag     *window_drag,
         }
     }
   window_drag->preview_tile_mode = META_TILE_NONE;
+  if (window_drag->gnoblin_snap_drag_id)
+    {
+      gnoblin_native_control_window_drag_end (
+        meta_window_get_display (window),
+        window_drag->gnoblin_snap_drag_id,
+        gnoblin_snap_committed,
+        gnoblin_snap_committed ? "committed" : "released");
+      window_drag->gnoblin_snap_drag_id = 0;
+    }
   meta_window_drag_end (window_drag);
 }
 
@@ -1912,6 +1972,7 @@ process_pointer_event (MetaWindowDrag     *window_drag,
       G_GNUC_FALLTHROUGH;
     case CLUTTER_MOTION:
       modifier_state = clutter_event_get_state (event);
+      window_drag->latest_modifier_state = modifier_state;
       clutter_event_get_coords (event, &x, &y);
       flags = META_EDGE_RESISTANCE_DEFAULT;
 
@@ -1981,6 +2042,7 @@ meta_window_drag_begin (MetaWindowDrag      *window_drag,
   MetaBackend *backend = meta_context_get_backend (context);
   MetaGrabOp grab_op = window_drag->grab_op;
   ClutterStage *stage;
+  ClutterModifierType modifier_state = 0;
   int root_x, root_y;
 
   grab_window = window;
@@ -2015,7 +2077,7 @@ meta_window_drag_begin (MetaWindowDrag      *window_drag,
       ClutterSeat *seat = clutter_backend_get_default_seat (clutter_backend);
       graphene_point_t pos;
 
-      clutter_seat_query_state (seat, sprite, &pos, NULL);
+      clutter_seat_query_state (seat, sprite, &pos, &modifier_state);
       root_x = (int) pos.x;
       root_y = (int) pos.y;
     }
@@ -2069,6 +2131,7 @@ meta_window_drag_begin (MetaWindowDrag      *window_drag,
   window_drag->anchor_root_y = root_y;
   window_drag->latest_motion_x = root_x;
   window_drag->latest_motion_y = root_y;
+  window_drag->latest_modifier_state = modifier_state;
   window_drag->last_edge_resistance_flags = META_EDGE_RESISTANCE_DEFAULT;
 
   meta_window_drag_update_cursor (window_drag);
@@ -2081,6 +2144,13 @@ meta_window_drag_begin (MetaWindowDrag      *window_drag,
 
   window_drag->initial_window_pos = window_drag->drag_rect;
 
+  if (meta_grab_op_is_mouse (grab_op) &&
+      meta_grab_op_is_moving (grab_op) &&
+      gnoblin_native_control_is_session (display))
+    window_drag->gnoblin_snap_drag_id =
+      gnoblin_native_control_window_drag_begin (display, grab_window,
+                                                root_x, root_y, modifier_state);
+
   window_drag->anchor_rel_x =
     CLAMP ((double) (root_x - window_drag->initial_window_pos.x) /
            window_drag->initial_window_pos.width,
