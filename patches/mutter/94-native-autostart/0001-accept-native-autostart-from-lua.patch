From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sun, 27 Sep 2026 19:00:00 +0100
Subject: [PATCH] Accept native autostart from Lua

---
diff --git a/src/core/mutter.c b/src/core/mutter.c
index f1856b6e7..59864819f 100644
--- a/src/core/mutter.c
+++ b/src/core/mutter.c
@@ -99,7 +99,8 @@ GOptionEntry mutter_options[] = {
 };
 
 static gboolean
-load_native_config (GError **error)
+load_native_config (GVariant **native_document,
+                    GError   **error)
 {
   if (!gnoblin_config)
     return TRUE;
@@ -142,12 +143,13 @@ load_native_config (GError **error)
                            g_str_equal (key, "layer-shell") ||
                            g_str_equal (key, "workspaces") ||
                            g_str_equal (key, "window-management") ||
-                           g_str_equal (key, "compositor");
+                           g_str_equal (key, "compositor") ||
+                           g_str_equal (key, "autostart");
       g_variant_unref (value);
       if (!supported)
         {
           g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
-                       "%s: native compositor cannot apply '%s'; use compositor-owned settings such as protocols, layer-shell, workspaces, window-management, or compositor",
+                       "%s: native compositor cannot apply '%s'; use supported settings such as protocols, layer-shell, workspaces, window-management, compositor, or autostart",
                        path, key);
           goto reject;
         }
@@ -156,6 +158,7 @@ load_native_config (GError **error)
   g_setenv ("GNOBLIN_CONFIG", path, TRUE);
   g_setenv ("GNOME_SHELL_SESSION_MODE", "gnoblin", TRUE);
   meta_gnoblin_finish_config_load (TRUE);
+  *native_document = g_steal_pointer (&document);
   return TRUE;
 
 reject:
@@ -229,6 +232,7 @@ main (int argc, char **argv)
   g_autoptr (MetaContext) context = NULL;
   g_autoptr (GError) error = NULL;
   g_auto (GStrv) command_argv = NULL;
+  g_autoptr (GVariant) native_document = NULL;
   GnoblinNativeControl *native_control = NULL;
 
   context = meta_create_context ("Mutter");
@@ -240,7 +244,7 @@ main (int argc, char **argv)
       return EXIT_FAILURE;
     }
 
-  if (!load_native_config (&error))
+  if (!load_native_config (&native_document, &error))
     {
       g_printerr ("Failed to load Gnoblin config: %s\n", error->message);
       return EXIT_FAILURE;
@@ -266,7 +270,7 @@ main (int argc, char **argv)
 
   if (gnoblin_config)
     {
-      native_control = gnoblin_native_control_start (context, &error);
+      native_control = gnoblin_native_control_start (context, native_document, &error);
       if (!native_control)
         {
           g_printerr ("Failed to start Gnoblin control: %s\n", error->message);
