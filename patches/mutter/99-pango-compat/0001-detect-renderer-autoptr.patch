From: Gnoblin <gnoblin@localhost>
Subject: [PATCH] build: detect PangoRenderer cleanup supplied by newer Pango

Keep the fallback for older distributions without redefining helpers on
rolling distributions with newer Pango headers.

diff --git a/config.h.meson b/config.h.meson
--- a/config.h.meson
+++ b/config.h.meson
@@ -144,2 +144,3 @@
 #mesondefine HAVE_FONTS
+#mesondefine HAVE_PANGO_RENDERER_AUTOPTR
 
diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -629,2 +629,8 @@
 cdata.set('HAVE_FONTS', have_fonts)
+if have_fonts
+  cdata.set('HAVE_PANGO_RENDERER_AUTOPTR',
+    cc.has_type('PangoRenderer_autoptr',
+      prefix: '#include <pango/pango.h>',
+      dependencies: pango_dep))
+endif
 cdata.set('HAVE_DRM_PLANE_SIZE_HINT', have_drm_plane_size_hint)
diff --git a/clutter/clutter/pango/clutter-pango-private.h b/clutter/clutter/pango/clutter-pango-private.h
--- a/clutter/clutter/pango/clutter-pango-private.h
+++ b/clutter/clutter/pango/clutter-pango-private.h
@@ -36,3 +36,4 @@
 #pragma once
 
+#include "config.h"
 #include <pango/pango.h>
@@ -82,3 +83,5 @@
+#ifndef HAVE_PANGO_RENDERER_AUTOPTR
 G_DEFINE_AUTOPTR_CLEANUP_FUNC (PangoRenderer, g_object_unref)
+#endif
 
 static inline PangoDirection
