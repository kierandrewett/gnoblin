From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sun, 27 Sep 2026 19:00:00 +0100
Subject: [PATCH] Accept native input settings from Lua

---
diff --git a/src/core/mutter.c b/src/core/mutter.c
index 555f471f8..d750140cb 100644
--- a/src/core/mutter.c
+++ b/src/core/mutter.c
@@ -145,12 +145,13 @@ load_native_config (GVariant **native_document,
                            g_str_equal (key, "window-management") ||
                            g_str_equal (key, "compositor") ||
                            g_str_equal (key, "autostart") ||
-                           g_str_equal (key, "shortcuts");
+                           g_str_equal (key, "shortcuts") ||
+                           g_str_equal (key, "input");
       g_variant_unref (value);
       if (!supported)
         {
           g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
-                       "%s: native compositor cannot apply '%s'; use supported settings such as protocols, layer-shell, workspaces, window-management, compositor, autostart, or shortcuts",
+                       "%s: native compositor cannot apply '%s'; use supported settings such as protocols, layer-shell, workspaces, window-management, compositor, autostart, shortcuts, or input",
                        path, key);
           goto reject;
         }
