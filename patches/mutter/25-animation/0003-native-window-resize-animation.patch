From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Fri, 2 Oct 2026 04:59:28 +0100
Subject: [PATCH] mutter: animate configured window size changes

Animate configured window size changes, including the typed window resize operations.
---
 src/compositor/compositor.c                | 3 ++-
 src/compositor/meta-window-actor-private.h | 2 ++
 src/compositor/meta-window-actor.c         | 9 +++++++++
 src/meta/compositor.h                      | 1 +
 4 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/compositor/compositor.c b/src/compositor/compositor.c
index 4c7cc173..71ece744 100644
--- a/src/compositor/compositor.c
+++ b/src/compositor/compositor.c
@@ -845,7 +845,8 @@ meta_compositor_sync_window_geometry (MetaCompositor *compositor,
 
   changes = meta_window_actor_sync_actor_geometry (window_actor, did_placement);
 
-  if (changes & META_WINDOW_ACTOR_CHANGE_SIZE)
+  if ((changes & META_WINDOW_ACTOR_CHANGE_SIZE) ||
+      meta_window_actor_size_change_in_progress (window_actor))
     meta_plugin_manager_event_size_changed (priv->plugin_mgr, window_actor);
 }
 
diff --git a/src/compositor/meta-window-actor-private.h b/src/compositor/meta-window-actor-private.h
index 1b937190..a8283a62 100644
--- a/src/compositor/meta-window-actor-private.h
+++ b/src/compositor/meta-window-actor-private.h
@@ -69,6 +69,8 @@ void meta_window_actor_frame_complete (MetaWindowActor    *self,
 META_EXPORT_TEST
 gboolean meta_window_actor_effect_in_progress  (MetaWindowActor *self);
 
+gboolean meta_window_actor_size_change_in_progress (MetaWindowActor *self);
+
 MetaWindowActorChanges meta_window_actor_sync_actor_geometry (MetaWindowActor *self,
                                                               gboolean         did_placement);
 
diff --git a/src/compositor/meta-window-actor.c b/src/compositor/meta-window-actor.c
index 6ba370dc..9eae07f8 100644
--- a/src/compositor/meta-window-actor.c
+++ b/src/compositor/meta-window-actor.c
@@ -849,6 +849,15 @@ meta_window_actor_effect_in_progress (MetaWindowActor *self)
           priv->destroy_in_progress);
 }
 
+gboolean
+meta_window_actor_size_change_in_progress (MetaWindowActor *self)
+{
+  MetaWindowActorPrivate *priv =
+    meta_window_actor_get_instance_private (self);
+
+  return priv->size_change_in_progress > 0;
+}
+
 static gboolean
 is_freeze_thaw_effect (MetaPluginEffect event)
 {
diff --git a/src/meta/compositor.h b/src/meta/compositor.h
index 98be9e15..68596167 100644
--- a/src/meta/compositor.h
+++ b/src/meta/compositor.h
@@ -64,6 +64,7 @@ typedef enum
   META_SIZE_CHANGE_FULLSCREEN,
   META_SIZE_CHANGE_UNFULLSCREEN,
   META_SIZE_CHANGE_MONITOR_MOVE,
+  META_SIZE_CHANGE_RESIZE,
 } MetaSizeChange;
 
 META_EXPORT
-- 
2.55.0

