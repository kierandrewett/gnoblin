From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 28 Sep 2026 13:22:48 +0100
Subject: [PATCH] mutter: add native animation preview runtime

---
diff --git a/src/core/display.c b/src/core/display.c
index 7f45e61bd..b9931eafb 100644
--- a/src/core/display.c
+++ b/src/core/display.c
@@ -161,6 +161,7 @@ enum
   ACCELERATOR_DEACTIVATED,
   MODIFIERS_ACCELERATOR_ACTIVATED,
   FOCUS_WINDOW,
+  GNOBLIN_NATIVE_EVENT,
   WINDOW_CREATED,
   WINDOW_DEMANDS_ATTENTION,
   WINDOW_MARKED_URGENT,
@@ -354,6 +355,14 @@ meta_display_class_init (MetaDisplayClass *klass)
                   NULL, NULL, NULL,
                   G_TYPE_NONE, 2, META_TYPE_WINDOW, G_TYPE_INT64);
 
+  display_signals[GNOBLIN_NATIVE_EVENT] =
+    g_signal_new ("gnoblin-native-event",
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0,
+                  NULL, NULL, NULL,
+                  G_TYPE_NONE, 2, G_TYPE_STRING, G_TYPE_VARIANT);
+
   display_signals[WINDOW_CREATED] =
     g_signal_new ("window-created",
                   G_TYPE_FROM_CLASS (klass),
diff --git a/src/core/util.c b/src/core/util.c
index 03c8e284e..415de1062 100644
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -25,6 +25,7 @@
 #include "core/meta-workspace-manager-private.h"
 #include "core/util-private.h"
 #include "core/gnoblin-native-control.h"
+#include "core/gnoblin-animation.h"
 
 #include <gio/gunixinputstream.h>
 #include <glib/gstdio.h>
@@ -753,6 +754,17 @@ meta_display_dispatch_gnoblin_shortcut_event (MetaDisplay *display,
 }
 
 
+void
+meta_display_dispatch_gnoblin_native_event (MetaDisplay *display,
+                                            const char  *event,
+                                            GVariant    *payload)
+{
+  g_return_if_fail (META_IS_DISPLAY (display));
+  g_return_if_fail (event != NULL && *event != '\0');
+  g_return_if_fail (payload != NULL && g_variant_is_of_type (payload, G_VARIANT_TYPE_VARDICT));
+  g_signal_emit_by_name (display, "gnoblin-native-event", event, payload);
+}
+
 #define GNOBLIN_WORKSPACE_ID "gnoblin-native-id"
 #define GNOBLIN_WORKSPACE_NAME "gnoblin-native-name"
 #define GNOBLIN_WORKSPACE_PERSISTENT "gnoblin-native-persistent"
@@ -2348,6 +2360,8 @@ meta_gnoblin_dispatch_native_api (MetaDisplay *display,
       return NULL;
     }
 
+  if (g_str_has_prefix (method, "animation."))
+    return meta_gnoblin_animation_dispatch (display, method, arguments, error);
   if (g_strcmp0 (method, "window.action") == 0)
     return gnoblin_native_window_action (display, arguments, error);
   if (g_strcmp0 (method, "window.list") == 0)
diff --git a/src/meson.build b/src/meson.build
index 383f02c46..1625da510 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -368,6 +368,7 @@ mutter_sources = [
   'core/startup-notification.c',
   'core/startup-notification-private.h',
   'core/util.c',
+  'core/gnoblin-animation.c',
   'core/util-private.h',
   'core/window.c',
   'core/window-private.h',
diff --git a/src/meta/util.h b/src/meta/util.h
index 139e36ca2..af598c959 100644
--- a/src/meta/util.h
+++ b/src/meta/util.h
@@ -137,3 +137,8 @@ GVariant *meta_gnoblin_dispatch_native_api (MetaDisplay *display,
 META_EXPORT
 gboolean meta_gnoblin_initialize_native_workspaces (MetaDisplay *display,
                                                      GError     **error);
+
+META_EXPORT
+void meta_display_dispatch_gnoblin_native_event (MetaDisplay *display,
+                                                 const char  *event,
+                                                 GVariant    *payload);
