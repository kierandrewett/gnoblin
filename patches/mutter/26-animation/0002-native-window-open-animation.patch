From b4445ab3845b57ebd81eafaa77ae2d61c8c6b6c0 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 28 Sep 2026 13:22:48 +0100
Subject: [PATCH] mutter: animate explicitly configured normal windows on first
 map

---
 src/compositor/meta-window-actor.c | 2 ++
 src/core/util.c                    | 6 ++++++
 src/meta/util.h                    | 3 +++
 3 files changed, 11 insertions(+)

diff --git a/src/compositor/meta-window-actor.c b/src/compositor/meta-window-actor.c
index 5e2f15fdc..4a733e958 100644
--- a/src/compositor/meta-window-actor.c
+++ b/src/compositor/meta-window-actor.c
@@ -34,6 +34,7 @@
 #include "compositor/meta-window-actor-private.h"
 #include "compositor/meta-surface-actor-wayland.h"
 #include "core/boxes-private.h"
+#include "core/gnoblin-animation.h"
 #include "core/window-private.h"
 #include "meta/window.h"
 #include "wayland/meta-wayland-surface-private.h"
@@ -185,6 +186,7 @@ meta_window_actor_map (ClutterActor *actor)
 {
   MetaWindowActor *window_actor = META_WINDOW_ACTOR (actor);
 
+  meta_gnoblin_animation_window_mapped (window_actor);
   CLUTTER_ACTOR_CLASS (meta_window_actor_parent_class)->map (actor);
 
   update_is_effectively_visible (window_actor);
diff --git a/src/core/util.c b/src/core/util.c
index d22fd92a8..7821bb78d 100644
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -979,6 +979,12 @@ gnoblin_native_workspace_id (MetaWorkspace *workspace)
   return id;
 }
 
+const char *
+meta_gnoblin_workspace_id (MetaWorkspace *workspace)
+{
+  return gnoblin_native_workspace_id (workspace);
+}
+
 gboolean
 meta_gnoblin_initialize_native_workspaces (MetaDisplay *display,
                                            GError     **error)
diff --git a/src/meta/util.h b/src/meta/util.h
index 6e6fa635f..328762acf 100644
--- a/src/meta/util.h
+++ b/src/meta/util.h
@@ -131,6 +131,9 @@ gboolean meta_gnoblin_window_pattern_match (const char *pattern,
                                             const char *value,
                                             GError **error);
 
+META_EXPORT
+const char *meta_gnoblin_workspace_id (MetaWorkspace *workspace);
+
 META_EXPORT
 gboolean meta_gnoblin_window_frame_set (MetaWindow *window, GVariant *policy, GError **error);
 META_EXPORT
-- 
2.55.0

