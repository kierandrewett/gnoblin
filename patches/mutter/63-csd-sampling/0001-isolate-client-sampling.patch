-    return NULL;
+    {
+      g_autoptr (GError) error = NULL;
+      g_autoptr (GBytes) bytes = NULL;
+      const uint8_t *rgba;
+      int width, height;
+      MtkRectangle bounds;
+      uint8_t *data;
+      int stride;
