From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 14 Sep 2026 16:33:21 +0200
Subject: [PATCH] mutter: bound CSD readback and retain tightly packed host pixels

---
diff --git a/src/compositor/meta-shaped-texture.c b/src/compositor/meta-shaped-texture.c
index 5ae0da4297..6aaf42d17d 100644
--- a/src/compositor/meta-shaped-texture.c
+++ b/src/compositor/meta-shaped-texture.c
@@ -1708,10 +1708,30 @@ meta_shaped_texture_get_pixels (MetaShapedTexture *stex,
   const uint8_t *source;
   g_autofree uint8_t *pixels = NULL;
   int rowstride;
+  int sample_width, sample_height;
   gsize size;
 
   *width = 0;
   *height = 0;
+  meta_shaped_texture_ensure_size_valid (stex);
+  sample_width = stex->dst_width;
+  sample_height = stex->dst_height;
+  if (stex->texture && sample_width > 0 && sample_height > 0 &&
+      !meta_shaped_texture_should_get_via_offscreen (stex))
+    {
+      CoglTexture *texture = meta_multi_texture_get_plane (stex->texture, 0);
+
+      sample_width = cogl_texture_get_width (texture);
+      sample_height = cogl_texture_get_height (texture);
+    }
+  if (sample_width <= 0 || sample_height <= 0 ||
+      (gint64) sample_width * sample_height > 16000000)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                           "Client dimensions are empty or exceed sampling limit");
+      return NULL;
+    }
+
   bitmap = meta_shaped_texture_paint_to_bitmap (
     stex, NULL, COGL_PIXEL_FORMAT_RGBA_8888_PRE);
   if (!bitmap)
@@ -1738,6 +1758,19 @@ meta_shaped_texture_get_pixels (MetaShapedTexture *stex,
 
   rowstride = cogl_bitmap_get_rowstride (bitmap);
   size = (gsize) *width * *height * 4;
+  if (rowstride == *width * 4 && !cogl_bitmap_get_buffer (bitmap))
+    {
+      /* Both readback paths produce private malloc-backed RGBA_PRE bitmaps.
+       * For host memory unmap only clears Cogl's mapped flag: the pixels stay
+       * valid until the bitmap is destroyed. Retain it for the GBytes lifetime,
+       * without retaining a mapping or GPU buffer. The CSD caller consumes and
+       * releases these bytes on the compositor thread. Keep copying padded or
+       * buffer-backed bitmaps so the public result always has a tight stride. */
+      cogl_bitmap_unmap (bitmap);
+      return g_bytes_new_with_free_func (source, size, g_object_unref,
+                                         g_steal_pointer (&bitmap));
+    }
+
   pixels = g_malloc (size);
   for (int y = 0; y < *height; y++)
     memcpy (pixels + (gsize) y * *width * 4,
