From 1b251739fb37244d938782ea3b60009bb8f6e221 Mon Sep 17 00:00:00 2001
From: Gnoblin Developers <gnoblin@example.invalid>
Date: Wed, 17 Jun 2026 16:10:00 +0100
Subject: [PATCH] tooling: expose feature variables in uninstalled pkg-config

gnome-shell reads Mutter's typelibdir and have_* pkg-config variables
while configuring. Meson's generated uninstalled .pc files only include
variables listed in uninstalled_variables, so local builds that point
gnome-shell at a patched, uninstalled Mutter fail during regeneration.
---
 src/meson.build                              |   7 +
 src/wayland/meta-wayland-background-effect.c | 304 ++++++++-----------
 src/wayland/meta-wayland-background-effect.h |  25 +-
 3 files changed, 132 insertions(+), 204 deletions(-)

diff --git a/src/meson.build b/src/meson.build
index 60970cefe..cc6de4e9a 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -1215,6 +1215,13 @@ pkg.generate(libmutter,
     'have_xwayland=@0@'.format(have_xwayland),
     'have_fonts=@0@'.format(have_fonts),
   ],
+  uninstalled_variables: [
+    'apiversion=' + libmutter_api_version,
+    'girdir=${prefix}/src',
+    'typelibdir=${prefix}/src',
+    'have_xwayland=@0@'.format(have_xwayland),
+    'have_fonts=@0@'.format(have_fonts),
+  ],
   install_dir: pcdir,
 )
 
diff --git a/src/wayland/meta-wayland-background-effect.c b/src/wayland/meta-wayland-background-effect.c
index bcfec89f7..41fb2a276 100644
--- a/src/wayland/meta-wayland-background-effect.c
+++ b/src/wayland/meta-wayland-background-effect.c
@@ -1,218 +1,152 @@
