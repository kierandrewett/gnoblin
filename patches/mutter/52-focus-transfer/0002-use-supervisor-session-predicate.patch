From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sat, 19 Sep 2026 22:02:01 +0100
Subject: [PATCH] focus: use the supervisor session predicate

---
diff --git a/src/core/util.c b/src/core/util.c
index 226e7e94a..5aa8c6f3e 100644
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -23,6 +23,7 @@
 
 #include "core/display-private.h"
 #include "core/util-private.h"
+#include "core/gnoblin-native-control.h"
 
 #include <gio/gunixinputstream.h>
 #include <glib/gstdio.h>
@@ -169,7 +170,7 @@ meta_gnoblin_layer_namespace (MetaWindow *window)
 gboolean
 meta_is_gnoblin_session (void)
 {
-  return g_strcmp0 (g_getenv ("GNOME_SHELL_SESSION_MODE"), "gnoblin") == 0;
+  return gnoblin_native_control_is_session (NULL);
 }
 
 gboolean
