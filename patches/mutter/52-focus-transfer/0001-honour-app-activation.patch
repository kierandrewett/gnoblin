From d5828d8c7f5f90a265882debeef786334fc8bfa8 Mon Sep 17 00:00:00 2001
From: Kieran Drewett <kieran@drewett.dev>
Date: Sat, 19 Sep 2026 22:02:01 +0100
Subject: [PATCH] focus: make activation policy configurable in Gnoblin

---
 src/core/util-private.h               |  3 +++
 src/core/util.c                       |  9 ++++++++-
 src/core/window.c                     | 13 ++++++++++++-
 src/wayland/meta-wayland-activation.c | 17 ++++++++++++-----
 4 files changed, 35 insertions(+), 7 deletions(-)

diff --git a/src/core/util-private.h b/src/core/util-private.h
index 7c176884c..c32af71e3 100644
--- a/src/core/util-private.h
+++ b/src/core/util-private.h
@@ -48,5 +48,8 @@ meta_timeval_to_microseconds (const struct timeval *tv)
 #define META_CONTAINER_OF(ptr, type, member) \
   (type *) ((uint8_t *) (ptr) - G_STRUCT_OFFSET (type, member))
 
+/* Whether Mutter is running in the Gnoblin session. */
+gboolean meta_is_gnoblin_session (void);
+
 char * meta_encode_hex (gpointer data,
                         size_t   size);
diff --git a/src/core/util.c b/src/core/util.c
index 12a90879e..226e7e94a 100644
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -139,6 +139,8 @@ ensure_logfile (void)
     }
 }
 
+#endif
+
 /**
  * meta_gnoblin_layer_anchor:
  * @window: window to inspect
@@ -163,7 +165,12 @@ meta_gnoblin_layer_namespace (MetaWindow *window)
 {
   return g_object_get_data (G_OBJECT (window), "gnoblin-layer-namespace");
 }
-#endif
+
+gboolean
+meta_is_gnoblin_session (void)
+{
+  return g_strcmp0 (g_getenv ("GNOME_SHELL_SESSION_MODE"), "gnoblin") == 0;
+}
 
 gboolean
 meta_is_verbose (void)
diff --git a/src/core/window.c b/src/core/window.c
index 4c45cb73a..bb1ac07f1 100644
--- a/src/core/window.c
+++ b/src/core/window.c
@@ -2056,6 +2056,10 @@ intervening_user_event_occurred (MetaWindow *window)
       return TRUE;
     }
 
+  if (meta_is_gnoblin_session () &&
+      meta_prefs_get_focus_new_windows () == G_DESKTOP_FOCUS_NEW_WINDOWS_SMART)
+    return FALSE;
+
   if (!(window->net_wm_user_time_set) && !(window->initial_timestamp_set))
     {
       meta_topic (META_DEBUG_STARTUP,
@@ -3977,6 +3981,12 @@ meta_window_activate_full (MetaWindow     *window,
               "by client type %u.",
               window->desc, timestamp, source_indication);
 
+  /* Smart mode honours activation requests, including after other input or
+   * from another workspace. Strict mode keeps Mutter's timestamp checks. */
+  if (meta_is_gnoblin_session () &&
+      meta_prefs_get_focus_new_windows () == G_DESKTOP_FOCUS_NEW_WINDOWS_SMART)
+    timestamp = meta_display_get_current_time_roundtrip (window->display);
+
   allow_workspace_switch = (timestamp != 0);
   if (timestamp != 0 &&
       XSERVER_TIME_IS_BEFORE (timestamp, window->display->last_user_time))
@@ -4021,7 +4031,8 @@ meta_window_activate_full (MetaWindow     *window,
 
   unminimize_window_and_all_transient_parents (window);
 
-  if (meta_prefs_get_raise_on_click () ||
+  if (meta_is_gnoblin_session () ||
+      meta_prefs_get_raise_on_click () ||
       source_indication == META_CLIENT_TYPE_PAGER)
     meta_window_raise (window);
 
diff --git a/src/wayland/meta-wayland-activation.c b/src/wayland/meta-wayland-activation.c
index 435a9992d..9c2bca6b8 100644
--- a/src/wayland/meta-wayland-activation.c
+++ b/src/wayland/meta-wayland-activation.c
@@ -20,6 +20,8 @@
 #include "config.h"
 
 #include "wayland/meta-wayland-activation.h"
+#include "core/util-private.h"
+#include "meta/prefs.h"
 
 #include <glib.h>
 #include <wayland-server.h>
@@ -348,17 +350,21 @@ maybe_activate (MetaWaylandActivation *activation,
                                                             token_str);
     }
 
-  if (!sequence)
+  if (!sequence &&
+      !(meta_is_gnoblin_session () &&
+        meta_prefs_get_focus_new_windows () == G_DESKTOP_FOCUS_NEW_WINDOWS_SMART))
     return TRUE;
 
-  if ((token && token_can_activate (token)) ||
+  if ((meta_is_gnoblin_session () &&
+       meta_prefs_get_focus_new_windows () == G_DESKTOP_FOCUS_NEW_WINDOWS_SMART) ||
+      (token && token_can_activate (token)) ||
       (!token && startup_sequence_is_recent (display, sequence)))
     {
       uint32_t timestamp;
       int32_t workspace_idx;
 
-      workspace_idx = meta_startup_sequence_get_workspace (sequence);
-      timestamp = meta_startup_sequence_get_timestamp (sequence);
+      workspace_idx = sequence ? meta_startup_sequence_get_workspace (sequence) : -1;
+      timestamp = sequence ? meta_startup_sequence_get_timestamp (sequence) : 0;
 
       if (workspace_idx >= 0)
         meta_window_change_workspace_by_index (window, workspace_idx, TRUE);
@@ -371,7 +377,8 @@ maybe_activate (MetaWaylandActivation *activation,
       meta_window_set_demands_attention (window);
     }
 
-  meta_startup_sequence_complete (sequence);
+  if (sequence)
+    meta_startup_sequence_complete (sequence);
 
   return TRUE;
 }
-- 
2.55.0
