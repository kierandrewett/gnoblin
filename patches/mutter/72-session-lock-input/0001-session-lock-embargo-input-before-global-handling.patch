From 85cf142e65f3c8ac38a3528a34e4745a21acfe41 Mon Sep 17 00:00:00 2001
From: Gnoblin <gnoblin@localhost>
Date: Thu, 24 Sep 2026 21:40:08 +0100
Subject: [PATCH] session-lock: embargo input before global handling

---
 src/core/events.c               | 11 +++++++++++
 src/wayland/meta-wayland-seat.c | 11 +++++++++++
 src/wayland/meta-wayland-seat.h |  8 ++++++++
 3 files changed, 30 insertions(+)

diff --git a/src/core/events.c b/src/core/events.c
index e877435e4..2fa7b83fa 100644
--- a/src/core/events.c
+++ b/src/core/events.c
@@ -35,6 +35,7 @@
 #include "core/window-private.h"
 #include "meta/meta-backend.h"
 #include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-session-lock.h"
 
 #include "backends/native/meta-backend-native.h"
 
@@ -147,6 +148,16 @@ meta_display_handle_event (MetaDisplay        *display,
 
   event_type = clutter_event_type (event);
 
+#ifdef HAVE_WAYLAND
+  /* A stage grab is not early enough for a session lock: by then input has
+   * already reached captured-input hooks, IM, accessibility, gestures, and
+   * global keybindings.  The lock filter is an embargo and must remain ahead
+   * of every normal-session consumer below. */
+  if (wayland_compositor &&
+      meta_wayland_session_lock_filter_event (wayland_compositor, event))
+    return CLUTTER_EVENT_STOP;
+#endif
+
   if (meta_display_process_captured_input (display, event))
     return CLUTTER_EVENT_STOP;
 
diff --git a/src/wayland/meta-wayland-seat.c b/src/wayland/meta-wayland-seat.c
index 7b7dff8df..5ae5b853e 100644
--- a/src/wayland/meta-wayland-seat.c
+++ b/src/wayland/meta-wayland-seat.c
@@ -686,6 +686,17 @@ meta_wayland_seat_handle_event (MetaWaylandSeat *seat,
   return meta_wayland_input_handle_event (seat->input_handler, event);
 }
 
+gboolean
+meta_wayland_seat_handle_session_lock_event (MetaWaylandSeat    *seat,
+                                             const ClutterEvent *event)
+{
+  /* A lock route must not chain into normal-session event handlers.  In
+   * particular, a PROPAGATE result could otherwise reach DnD, constraints,
+   * popups, or an Xwayland keyboard grab.  The session-lock controller sets
+   * focus only to a mapped lock role before calling this entry point. */
+  return meta_wayland_seat_handle_event_internal (seat, event);
+}
+
 MetaWaylandInput *
 meta_wayland_seat_get_input (MetaWaylandSeat *seat)
 {
diff --git a/src/wayland/meta-wayland-seat.h b/src/wayland/meta-wayland-seat.h
index 27bee9f8e..1d3b89ea8 100644
--- a/src/wayland/meta-wayland-seat.h
+++ b/src/wayland/meta-wayland-seat.h
@@ -73,6 +73,14 @@ void meta_wayland_seat_update (MetaWaylandSeat    *seat,
 gboolean meta_wayland_seat_handle_event (MetaWaylandSeat *seat,
                                          const ClutterEvent *event);
 
+/* Bypass the normal MetaWaylandInput handler chain for a compositor-owned
+ * session-lock route.  The caller must have validated a mapped lock role and
+ * installed its focus first; this function must never be used for ordinary
+ * session input because it intentionally skips DnD, popup, and grab handlers.
+ */
+gboolean meta_wayland_seat_handle_session_lock_event (MetaWaylandSeat    *seat,
+                                                      const ClutterEvent *event);
+
 void meta_wayland_seat_set_input_focus (MetaWaylandSeat    *seat,
                                         MetaWaylandSurface *surface);
 
