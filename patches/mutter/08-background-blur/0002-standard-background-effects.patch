From da7405ff51eb48bd57dc76f87825655495222687 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Wed, 21 Oct 2026 02:30:28 +0100
Subject: [PATCH] Wire ext-background-effect-v1 into surface transactions

Build the standard background effect protocol and carry its state through
synchronised subsurface transactions. Expose committed regions to the shell.
---
 src/wayland/meta-wayland-background-effect.c | 59 ++++++++++++++++++++
 src/wayland/meta-wayland-background-effect.h |  2 +
 src/wayland/meta-wayland-surface.c           |  2 +
 3 files changed, 63 insertions(+)

diff --git a/src/wayland/meta-wayland-background-effect.c b/src/wayland/meta-wayland-background-effect.c
index bcfec89f7..33e408edc 100644
--- a/src/wayland/meta-wayland-background-effect.c
+++ b/src/wayland/meta-wayland-background-effect.c
@@ -23,12 +23,17 @@
 #include <wayland-server.h>
 
 #include "ext-background-effect-v1-server-protocol.h"
+#include "compositor/meta-surface-actor-wayland.h"
+#include "meta/display.h"
+#include "meta/meta-context.h"
+#include "meta/util.h"
 #include "wayland/meta-wayland-private.h"
 #include "wayland/meta-wayland-region.h"
 #include "wayland/meta-wayland-surface-private.h"
 #include "wayland/meta-wayland-versions.h"
 
 #define BACKGROUND_EFFECT_SURFACE_DATA "-meta-wayland-background-effect-surface"
+#define GNOBLIN_BACKGROUND_EFFECT_REGION "gnoblin-background-effect-region"
 
 typedef struct _MetaWaylandBackgroundEffectSurface
 {
@@ -209,6 +214,13 @@ background_effect_manager_bind (struct wl_client *client,
 void
 meta_wayland_init_background_effect (MetaWaylandCompositor *compositor)
 {
+  if (g_signal_lookup ("gnoblin-background-effect-changed", META_TYPE_DISPLAY) == 0)
+    g_signal_new ("gnoblin-background-effect-changed",
+                  META_TYPE_DISPLAY,
+                  G_SIGNAL_RUN_LAST,
+                  0, NULL, NULL, NULL,
+                  G_TYPE_NONE, 1, CLUTTER_TYPE_ACTOR);
+
   if (!wl_global_create (compositor->wayland_display,
                          &ext_background_effect_manager_v1_interface,
                          META_EXT_BACKGROUND_EFFECT_V1_VERSION,
@@ -216,3 +228,50 @@ meta_wayland_init_background_effect (MetaWaylandCompositor *compositor)
                          background_effect_manager_bind))
     g_warning ("Failed to create ext_background_effect_manager_v1 global");
 }
+
+void
+meta_wayland_background_effect_apply_state (MetaWaylandSurface      *surface,
+                                            MetaWaylandSurfaceState *state)
+{
+  MetaSurfaceActor *surface_actor;
+  ClutterActor *actor;
+  MtkRegion *region;
+  MtkRegion *previous;
+  MetaDisplay *display;
+
+  if (!state->background_blur_region_set)
+    return;
+
+  surface_actor = meta_wayland_surface_get_actor (surface);
+  if (!surface_actor)
+    return;
+
+  actor = CLUTTER_ACTOR (surface_actor);
+  region = state->background_blur_region
+    ? mtk_region_copy (state->background_blur_region)
+    : mtk_region_create ();
+  previous = g_object_get_data (G_OBJECT (actor),
+                                GNOBLIN_BACKGROUND_EFFECT_REGION);
+  if (previous && mtk_region_equal (previous, region))
+    {
+      mtk_region_unref (region);
+      return;
+    }
+
+  g_object_set_data_full (G_OBJECT (actor),
+                          GNOBLIN_BACKGROUND_EFFECT_REGION,
+                          region,
+                          (GDestroyNotify) mtk_region_unref);
+  display = meta_context_get_display (surface->compositor->context);
+  g_signal_emit_by_name (display, "gnoblin-background-effect-changed", actor);
+  clutter_actor_queue_redraw (actor);
+}
+
+MtkRegion *
+meta_gnoblin_background_effect_get_region (ClutterActor *actor)
+{
+  MtkRegion *region = g_object_get_data (G_OBJECT (actor),
+                                         GNOBLIN_BACKGROUND_EFFECT_REGION);
+
+  return region ? mtk_region_copy (region) : NULL;
+}
diff --git a/src/wayland/meta-wayland-background-effect.h b/src/wayland/meta-wayland-background-effect.h
index d83fae9d8..75a96392e 100644
--- a/src/wayland/meta-wayland-background-effect.h
+++ b/src/wayland/meta-wayland-background-effect.h
@@ -20,3 +20,5 @@
 #include "wayland/meta-wayland-types.h"
 
 void meta_wayland_init_background_effect (MetaWaylandCompositor *compositor);
+void meta_wayland_background_effect_apply_state (MetaWaylandSurface      *surface,
+                                                 MetaWaylandSurfaceState *state);
diff --git a/src/wayland/meta-wayland-surface.c b/src/wayland/meta-wayland-surface.c
index d9a9e0649..34f0209ca 100644
--- a/src/wayland/meta-wayland-surface.c
+++ b/src/wayland/meta-wayland-surface.c
@@ -42,6 +42,7 @@
 #include "wayland/meta-wayland-client-private.h"
 #include "wayland/meta-wayland-color-representation.h"
 #include "wayland/meta-gnoblin-protocols.h"
+#include "wayland/meta-wayland-background-effect.h"
 #include "wayland/meta-wayland-blur-fade.h"
 #include "wayland/meta-wayland-fractional-scale.h"
 #include "wayland/meta-wayland-gtk-shell.h"
@@ -1103,6 +1104,7 @@ meta_wayland_surface_apply_state (MetaWaylandSurface      *surface,
     g_clear_object (&state->buffer);
 
   meta_wayland_blur_fade_apply_state (surface, state);
+  meta_wayland_background_effect_apply_state (surface, state);
 
   g_signal_emit (state,
                  surface_state_signals[SURFACE_STATE_SIGNAL_APPLIED],
-- 
2.55.0

