From: kierandrewett <kieran@drewett.dev>
Subject: [PATCH] config: expose shared TOML parsing to GNOME Shell

diff --git a/src/meson.build b/src/meson.build
--- a/src/meson.build
+++ b/src/meson.build
@@ -696,6 +696,8 @@
     # gnoblin: extra wlr-/ext- protocols (sources copied from gnoblin overlays
     # at build time; registered via meta_gnoblin_init_protocols)
     'wayland/gnoblin-config.c',
+    'wayland/gnoblin-toml.c',
+    'wayland/tomlc99/toml.c',
     'wayland/gnoblin-config.h',
     'wayland/meta-gnoblin-protocols.c',
     'wayland/meta-gnoblin-protocols.h',
@@ -1352,7 +1354,7 @@
 if have_introspection
   mutter_introspected_sources = []
   foreach source : mutter_sources
-    if source.endswith('.c')
+    if source.endswith('.c') and not source.endswith('tomlc99/toml.c')
       mutter_introspected_sources += source
     endif
   endforeach
diff --git a/src/meta/util.h b/src/meta/util.h
--- a/src/meta/util.h
+++ b/src/meta/util.h
@@ -115,3 +115,6 @@
 META_EXPORT
 char * meta_accelerator_name (ClutterModifierType accelerator_mods,
                               unsigned int        accelerator_key);
+
+META_EXPORT
+GVariant *meta_gnoblin_parse_toml (const char *contents, GError **error);
diff --git a/src/core/util.c b/src/core/util.c
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -624,3 +624,26 @@
   g_logv (G_LOG_DOMAIN, mutter_log_level, format, args);
   va_end (args);
 }
+
+#ifdef HAVE_WAYLAND
+#include "wayland/gnoblin-config.h"
+#endif
+
+/**
+ * meta_gnoblin_parse_toml:
+ * @contents: UTF-8 TOML document
+ * @error: return location for a parse error
+ *
+ * Returns: (transfer full): parsed document as nested variant dictionaries
+ */
+GVariant *
+meta_gnoblin_parse_toml (const char *contents, GError **error)
+{
+#ifdef HAVE_WAYLAND
+  return gnoblin_config_parse_toml (contents, error);
+#else
+  g_set_error_literal (error, G_FILE_ERROR, G_FILE_ERROR_INVAL,
+                       "Gnoblin config requires Wayland support");
+  return NULL;
+#endif
+}
