 src/x11/events.c                   |  57 +-----
 src/x11/meta-x11-display-private.h |   3 -
 src/x11/meta-x11-display.c         |  64 -------
 src/x11/meta-x11-frame.c           | 292 -----------------------------
 src/x11/meta-x11-frame.h           |   6 -
 src/x11/window-props.c             |  20 +-
 src/x11/window-x11-private.h       |   3 -
 src/x11/window-x11.c               |  77 +++-----
 9 files changed, 49 insertions(+), 506 deletions(-)

diff --git a/src/core/window.c b/src/core/window.c
index b8f59d597c..9205f7b8f8 100644
--- a/src/core/window.c
+++ b/src/core/window.c
@@ -73,6 +73,7 @@
 #include "core/constraints.h"
 #include "core/keybindings-private.h"
 #include "core/gnoblin-native-control.h"
+#include "wayland/meta-gnoblin-window-frame.h"
 #include "core/meta-window-config-private.h"
 #include "core/meta-workspace-manager-private.h"
 #include "core/place.h"
@@ -950,12 +951,6 @@ client_window_should_be_mapped (MetaWindow *window)
         return FALSE;
     }
 
-#ifdef HAVE_XWAYLAND
-  if (window->client_type == META_WINDOW_CLIENT_TYPE_X11 &&
-      window->decorated && !meta_window_x11_is_ssd (window))
-    return FALSE;
-#endif
-
   return TRUE;
 }
 
@@ -1872,12 +1867,6 @@ meta_window_is_showable (MetaWindow *window)
       !window_has_buffer (window))
     return FALSE;
 
-#ifdef HAVE_XWAYLAND
-  if (window->client_type == META_WINDOW_CLIENT_TYPE_X11 &&
-      window->decorated && !meta_window_x11_is_ssd (window))
-    return FALSE;
-#endif
-
   return TRUE;
 }
 
@@ -3805,6 +3794,11 @@ fullscreen_window (MetaWindow       *window,
                                           &old_frame_rect, &old_buffer_rect);
 
       set_fullscreen_state (window);
+#ifdef HAVE_XWAYLAND
+      /* A fullscreen window has no server frame. */
+      if (window->client_type == META_WINDOW_CLIENT_TYPE_X11)
+        meta_gnoblin_window_frame_x11_update (window);
+#endif
 
       flags = (META_MOVE_RESIZE_MOVE_ACTION |
                META_MOVE_RESIZE_RESIZE_ACTION |
@@ -3836,7 +3830,11 @@ unfullscreen_window (MetaWindow       *window,
                   "Unfullscreening %s", window->desc);
 
       meta_window_config_set_is_fullscreen (window->config, FALSE);
-
+#ifdef HAVE_XWAYLAND
+      /* The server frame comes back before the window returns to its size. */
+      if (window->client_type == META_WINDOW_CLIENT_TYPE_X11)
+        meta_gnoblin_window_frame_x11_update (window);
+#endif
 
       if (!window->placed &&
           !mtk_rectangle_is_empty (&window->unconstrained_rect))
@@ -5945,14 +5943,9 @@ meta_window_type_changed (MetaWindow *window)
     set_net_wm_state (window);
 
 #ifdef HAVE_XWAYLAND
+  /* The decorations a type has changed the frame layout of an X11 window. */
   if (window->client_type == META_WINDOW_CLIENT_TYPE_X11)
-    {
-      /* Update frame */
-      if (window->decorated)
-        meta_window_ensure_frame (window);
-      else
-        meta_window_destroy_frame (window);
-    }
+    meta_gnoblin_window_frame_x11_update (window);
 #endif
 
   /* update stacking constraints */
diff --git a/src/x11/events.c b/src/x11/events.c
index 4777e8ba77..64f7b75001 100644
--- a/src/x11/events.c
+++ b/src/x11/events.c
@@ -1359,18 +1359,9 @@ handle_other_xevent (MetaX11Display *x11_display,
           guint32 timestamp;
           timestamp = meta_display_get_current_time_roundtrip (display);
 
-          if (frame_was_receiver)
-            {
-              mtk_x11_error_trap_push (x11_display->xdisplay);
-              meta_window_destroy_frame (frame->window);
-              mtk_x11_error_trap_pop (x11_display->xdisplay);
-            }
-          else
-            {
-              /* Unmanage destroyed window */
-              meta_window_unmanage (window, timestamp);
-              window = NULL;
-            }
+          /* Unmanage destroyed window */
+          meta_window_unmanage (window, timestamp);
+          window = NULL;
         }
       break;
     case UnmapNotify:
@@ -1428,48 +1419,6 @@ handle_other_xevent (MetaX11Display *x11_display,
     case MapRequest:
       if (window == NULL)
         {
-          Atom type;
-          int format;
-          unsigned long nitems, bytes_after, *data;
-
-          /* Check whether the new window is a frame for another window */
-          mtk_x11_error_trap_push (x11_display->xdisplay);
-
-          if (XGetWindowProperty (x11_display->xdisplay,
-                                  event->xmaprequest.window,
-                                  x11_display->atom__MUTTER_FRAME_FOR,
-                                  0, 32, False, XA_WINDOW,
-                                  &type, &format, &nitems, &bytes_after,
-                                  (guchar **) &data) != Success)
-            {
-              mtk_x11_error_trap_pop (x11_display->xdisplay);
-              break;
-            }
-
-          if (mtk_x11_error_trap_pop_with_return (x11_display->xdisplay) != Success)
-            break;
-
-          if (nitems == 1)
-            {
-              Window client_window;
-
-              client_window = data[0];
-              XFree (data);
-
-              window = meta_x11_display_lookup_x_window (x11_display,
-                                                         client_window);
-
-              if (window != NULL && window->decorated && !meta_window_x11_is_ssd (window))
-                {
-                  meta_window_x11_set_frame_xwindow (window,
-                                                     event->xmaprequest.window);
-                  meta_window_x11_initialize_state (window);
-                  meta_window_update_visibility (window);
-                }
-
-              break;
-            }
-
           window = meta_window_x11_new (display, event->xmaprequest.window,
                                         FALSE, META_COMP_EFFECT_CREATE);
           if (window)
