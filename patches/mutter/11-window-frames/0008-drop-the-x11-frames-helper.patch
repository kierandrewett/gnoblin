From 1f20c122b820fc9790da855980055ac8b4a86a8e Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Wed, 4 Nov 2026 18:41:44 +0000
Subject: [PATCH] build: drop the mutter-x11-frames helper

X11 windows are framed by the compositor, so nothing launches the GTK4 frames
client any more. Remove it and the tests' dependency on it.
---
 src/frames/main.c                | 128 ------
 src/frames/meson.build           |  25 --
 src/frames/meta-frame-content.c  | 132 ------
 src/frames/meta-frame-content.h  |  32 --
 src/frames/meta-frame-header.c   | 129 ------
 src/frames/meta-frame-header.h   |  29 --
 src/frames/meta-frame.c          | 670 -------------------------------
 src/frames/meta-frame.h          |  32 --
 src/frames/meta-frames-client.h  |  22 -
 src/frames/meta-window-tracker.c | 497 -----------------------
 src/frames/meta-window-tracker.h |  30 --
 src/meson.build                  |   3 -
 src/tests/meson.build            |   4 -
 13 files changed, 1733 deletions(-)
 delete mode 100644 src/frames/main.c
 delete mode 100644 src/frames/meson.build
 delete mode 100644 src/frames/meta-frame-content.c
 delete mode 100644 src/frames/meta-frame-content.h
 delete mode 100644 src/frames/meta-frame-header.c
 delete mode 100644 src/frames/meta-frame-header.h
 delete mode 100644 src/frames/meta-frame.c
 delete mode 100644 src/frames/meta-frame.h
 delete mode 100644 src/frames/meta-frames-client.h
 delete mode 100644 src/frames/meta-window-tracker.c
 delete mode 100644 src/frames/meta-window-tracker.h

