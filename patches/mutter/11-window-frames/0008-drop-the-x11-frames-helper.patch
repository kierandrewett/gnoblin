-  if (!is_frame && !is_content)
-    return;
-
-  if (is_content && xevent->type == PropertyNotify)
-    {
-      if (xevent->xproperty.atom == frame->atom__NET_WM_VISIBLE_NAME)
-        frame_sync_net_wm_visible_name (GTK_WINDOW (frame), xevent->xproperty.window);
