From 212f2c5f4a3e33afccc901928a1959d383bf622f Mon Sep 17 00:00:00 2001
From: Gnoblin <gnoblin@localhost>
Date: Sun, 13 Sep 2026 03:04:43 +0100
Subject: [PATCH] Contain outside click while search is open

---
 src/core/events.c       | 18 ++++++++++++--
 src/core/util-private.h |  5 ++++
 src/core/util.c         | 55 +++++++++++++++++++++++++++++++++++++++++
 src/meta/util.h         |  4 +++
 4 files changed, 80 insertions(+), 2 deletions(-)

diff --git a/src/core/events.c b/src/core/events.c
index f90f5ba51..2a512fe81 100644
--- a/src/core/events.c
+++ b/src/core/events.c
@@ -31,6 +31,7 @@
 #include "compositor/compositor-private.h"
 #include "compositor/meta-window-actor-private.h"
 #include "core/display-private.h"
+#include "core/util-private.h"
 #include "core/window-private.h"
 #include "meta/meta-backend.h"
 #include "wayland/meta-wayland-private.h"
@@ -127,6 +128,7 @@ meta_display_handle_event (MetaDisplay        *display,
   ClutterEventType event_type;
   gboolean has_grab;
   gboolean a11y_grabbed;
+  gboolean fullscreen_return_guarded = FALSE;
   MetaTabletActionMapper *mapper;
   MetaWaylandCompositor *wayland_compositor;
   MetaWaylandTextInput *wayland_text_input = NULL;
@@ -174,7 +176,17 @@ meta_display_handle_event (MetaDisplay        *display,
   source_device = clutter_event_get_source_device (event);
   clutter_seat_a11y_update (seat, event);
 
+  window = get_window_for_event (display, event, event_actor);
+  if (event_type == CLUTTER_BUTTON_PRESS ||
+      event_type == CLUTTER_BUTTON_RELEASE)
+    fullscreen_return_guarded =
+      meta_gnoblin_consume_fullscreen_return_event (
+        display, window,
+        event_type == CLUTTER_BUTTON_PRESS,
+        clutter_event_get_button (event));
+
   if (wayland_text_input &&
+      !fullscreen_return_guarded &&
       !meta_compositor_get_current_window_drag (compositor) &&
       meta_wayland_text_input_update (wayland_text_input, event))
     return CLUTTER_EVENT_STOP;
@@ -183,7 +195,8 @@ meta_display_handle_event (MetaDisplay        *display,
       !clutter_event_get_device_tool (event))
     meta_display_handle_sticky_mouse_focus_event (display, event);
 
-  meta_wayland_compositor_update (wayland_compositor, event);
+  if (!fullscreen_return_guarded)
+    meta_wayland_compositor_update (wayland_compositor, event);
 
   if (event_type == CLUTTER_PAD_BUTTON_PRESS ||
       event_type == CLUTTER_PAD_BUTTON_RELEASE ||
@@ -238,7 +251,8 @@ meta_display_handle_event (MetaDisplay        *display,
       meta_tablet_action_mapper_handle_event (mapper, event);
     }
 
-  window = get_window_for_event (display, event, event_actor);
+  if (fullscreen_return_guarded)
+    return CLUTTER_EVENT_PROPAGATE;
 
   if (window && !window->override_redirect &&
       (event_type == CLUTTER_KEY_PRESS ||
diff --git a/src/core/util-private.h b/src/core/util-private.h
index c32af71e3..96278e846 100644
--- a/src/core/util-private.h
+++ b/src/core/util-private.h
@@ -51,5 +51,10 @@ meta_timeval_to_microseconds (const struct timeval *tv)
 /* Gnoblin honours application focus requests instead of focus prevention. */
 gboolean meta_is_gnoblin_session (void);
 
+gboolean meta_gnoblin_consume_fullscreen_return_event (MetaDisplay *display,
+                                                       MetaWindow  *window,
+                                                       gboolean     press,
+                                                       guint        button);
+
 char * meta_encode_hex (gpointer data,
                         size_t   size);
diff --git a/src/core/util.c b/src/core/util.c
index 226e7e94a..e8d3ae372 100644
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -172,6 +172,61 @@ meta_is_gnoblin_session (void)
   return g_strcmp0 (g_getenv ("GNOME_SHELL_SESSION_MODE"), "gnoblin") == 0;
 }
 
+typedef struct
+{
+  gboolean armed;
+  guint blocked_button;
+} GnoblinFullscreenReturnGuard;
+
+void
+meta_gnoblin_fullscreen_return_guard_set (MetaDisplay *display,
+                                          gboolean     armed)
+{
+  GnoblinFullscreenReturnGuard *guard;
+
+  guard = g_object_get_data (G_OBJECT (display),
+                             "gnoblin-fullscreen-return-guard");
+  if (!guard)
+    {
+      guard = g_new0 (GnoblinFullscreenReturnGuard, 1);
+      g_object_set_data_full (G_OBJECT (display),
+                              "gnoblin-fullscreen-return-guard",
+                              guard, g_free);
+    }
+
+  guard->armed = armed;
+  if (armed)
+    guard->blocked_button = 0;
+}
+
+gboolean
+meta_gnoblin_consume_fullscreen_return_event (MetaDisplay *display,
+                                              MetaWindow  *window,
+                                              gboolean     press,
+                                              guint        button)
+{
+  GnoblinFullscreenReturnGuard *guard;
+
+  guard = g_object_get_data (G_OBJECT (display),
+                             "gnoblin-fullscreen-return-guard");
+  if (!guard)
+    return FALSE;
+
+  if (!press && button == guard->blocked_button)
+    {
+      guard->blocked_button = 0;
+      return TRUE;
+    }
+
+  if (!guard->armed || !press || button != 1 || !window ||
+      !meta_window_is_fullscreen (window))
+    return FALSE;
+
+  guard->armed = FALSE;
+  guard->blocked_button = button;
+  return TRUE;
+}
+
 gboolean
 meta_is_verbose (void)
 {
diff --git a/src/meta/util.h b/src/meta/util.h
index 09072adda..0acdcfd5b 100644
--- a/src/meta/util.h
+++ b/src/meta/util.h
@@ -114,3 +114,7 @@ int meta_gnoblin_layer_anchor (MetaWindow *window);
 
 META_EXPORT
 const char *meta_gnoblin_layer_namespace (MetaWindow *window);
+
+META_EXPORT
+void meta_gnoblin_fullscreen_return_guard_set (MetaDisplay *display,
+                                                gboolean     armed);
