From 67b59bc52790a5bc4418ce16f49e44d85956bcbf Mon Sep 17 00:00:00 2001
From: Gnoblin <gnoblin@localhost>
Date: Fri, 25 Sep 2026 00:30:00 +0000
Subject: [PATCH] core: expose live Gnoblin cursor preferences

Allow Shell configuration reloads to apply the validated cursor theme and size
through Mutter's preference notifications.
---
 src/core/prefs.c | 36 ++++++++++++++++++++++++++++++++++++
 src/meta/prefs.h |  5 +++++
 2 files changed, 41 insertions(+)

diff --git a/src/core/prefs.c b/src/core/prefs.c
index 4b43d21cb..28f349d6b 100644
--- a/src/core/prefs.c
+++ b/src/core/prefs.c
@@ -985,0 +986,18 @@ is_gnoblin_session (void)
+static void
+set_gnoblin_cursor_config (const char *theme,
+                           int         size)
+{
+  if (g_strcmp0 (cursor_theme, theme) != 0)
+    {
+      g_free (cursor_theme);
+      cursor_theme = g_strdup (theme);
+      queue_changed (META_PREF_CURSOR_THEME);
+    }
+
+  if (cursor_size != size)
+    {
+      cursor_size = size;
+      queue_changed (META_PREF_CURSOR_SIZE);
+    }
+}
+
@@ -1538,0 +1557,18 @@ meta_prefs_get_cursor_theme (void)
+/**
+ * meta_prefs_set_gnoblin_cursor_config:
+ * @theme: installed cursor theme name
+ * @size: cursor size in logical pixels
+ *
+ * Apply Gnoblin's cursor settings in a live Gnoblin session.
+ */
+void
+meta_prefs_set_gnoblin_cursor_config (const char *theme,
+                                      int         size)
+{
+  g_return_if_fail (is_gnoblin_session ());
+  g_return_if_fail (theme != NULL && theme[0] != '\0');
+  g_return_if_fail (size >= 1 && size <= 256);
+
+  set_gnoblin_cursor_config (theme, size);
+}
+
diff --git a/src/meta/prefs.h b/src/meta/prefs.h
index b16405b38..590bac807 100644
--- a/src/meta/prefs.h
+++ b/src/meta/prefs.h
@@ -222,0 +223,5 @@ int         meta_prefs_get_cursor_size       (void);
+/* Update live cursor preferences for Gnoblin sessions. */
+META_EXPORT
+void        meta_prefs_set_gnoblin_cursor_config (const char *theme,
+                                                  int         size);
+
