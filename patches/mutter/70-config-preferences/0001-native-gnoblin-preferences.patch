+/**
+ * meta_prefs_apply_gnoblin_keybindings:
+ * @keybindings: an a{sv} of groups containing a{sv} action-to-string-array maps
+ *
+ * Rebuild native grabs from the Lua document. User GSettings values are never
+ * changed; an omitted action returns to its schema default on the next reload.
+ */
+void
+meta_prefs_apply_gnoblin_keybindings (GVariant *keybindings)
+{
+  GHashTable *next;
+  GVariantIter groups;
+  const char *group;
+  GVariant *entries;
+  GHashTableIter prefs;
+  gpointer value;
+  gboolean changed = FALSE;
+
+  if (!is_gnoblin_session ())
+    return;
+  g_return_if_fail (keybindings && g_variant_is_of_type (keybindings, G_VARIANT_TYPE_VARDICT));
+
+  next = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, (GDestroyNotify) g_strfreev);
+  g_variant_iter_init (&groups, keybindings);
+  while (g_variant_iter_next (&groups, "{&sv}", &group, &entries))
+    {
+      GVariantIter actions;
+      const char *name;
+      GVariant *bindings;
+
+      if (!g_variant_is_of_type (entries, G_VARIANT_TYPE_VARDICT))
+        { g_variant_unref (entries); continue; }
+      g_variant_iter_init (&actions, entries);
+      while (g_variant_iter_next (&actions, "{&sv}", &name, &bindings))
+        {
+          if (g_variant_is_of_type (bindings, G_VARIANT_TYPE_STRING_ARRAY))
+            g_hash_table_replace (next, g_strdup (name), g_variant_dup_strv (bindings, NULL));
+          g_variant_unref (bindings);
+        }
+      g_variant_unref (entries);
+    }
+
+  g_clear_pointer (&gnoblin_keybinding_overrides, g_hash_table_unref);
+  gnoblin_keybinding_overrides = next;
+  if (!key_bindings)
+    return;
+  g_hash_table_iter_init (&prefs, key_bindings);
+  while (g_hash_table_iter_next (&prefs, NULL, &value))
+    {
+      MetaKeyPref *pref = value;
+      char **configured;
+      g_autoptr (GVariant) default_value = NULL;
+      g_auto (GStrv) strokes = NULL;
+
+      if (!pref->settings || !gnoblin_owns_keybinding_settings (pref->settings))
+        continue;
+      configured = g_hash_table_lookup (next, pref->name);
+      if (configured)
+        strokes = g_strdupv (configured);
+      else
+        {
+          default_value = g_settings_get_default_value (pref->settings, pref->name);
+          strokes = default_value ? g_variant_dup_strv (default_value, NULL)
+                                  : g_settings_get_strv (pref->settings, pref->name);
+        }
+      changed |= update_binding (pref, strokes);
+    }
+  if (changed)
+    queue_changed (META_PREF_KEYBINDINGS);
+}
+
