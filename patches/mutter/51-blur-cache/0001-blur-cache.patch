+struct _ClutterBlurCache
+{
+  GObject parent_instance;
+  ClutterBlurCache *resources;
+  unsigned int builds;
+  CoglFramebuffer *offscreen;
+  CoglPipeline *pipeline;
+  ClutterBlur *blur;
+  unsigned int width;
