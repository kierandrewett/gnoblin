+{
+}
+
+ClutterBlurCache *
+clutter_blur_cache_new (void)
+{
+  return g_object_new (CLUTTER_TYPE_BLUR_CACHE, NULL);
+}
+
+unsigned int
+clutter_blur_cache_get_build_count (ClutterBlurCache *cache)
+{
+  return cache->builds;
+}
