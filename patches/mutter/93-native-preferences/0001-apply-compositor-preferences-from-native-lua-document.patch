From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sun, 27 Sep 2026 19:00:00 +0100
Subject: [PATCH] Apply compositor preferences from native Lua document

---
diff --git a/src/core/mutter.c b/src/core/mutter.c
index 474957c89..f1856b6e7 100644
--- a/src/core/mutter.c
+++ b/src/core/mutter.c
@@ -140,12 +140,14 @@ load_native_config (GError **error)
     {
       gboolean supported = g_str_equal (key, "protocols") ||
                            g_str_equal (key, "layer-shell") ||
-                           g_str_equal (key, "workspaces");
+                           g_str_equal (key, "workspaces") ||
+                           g_str_equal (key, "window-management") ||
+                           g_str_equal (key, "compositor");
       g_variant_unref (value);
       if (!supported)
         {
           g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
-                       "%s: native compositor cannot apply '%s'; use a config with only protocols, layer-shell, and workspaces",
+                       "%s: native compositor cannot apply '%s'; use compositor-owned settings such as protocols, layer-shell, workspaces, window-management, or compositor",
                        path, key);
           goto reject;
         }
diff --git a/src/core/prefs.c b/src/core/prefs.c
index f3e52a3f1..3f388a25c 100644
--- a/src/core/prefs.c
+++ b/src/core/prefs.c
@@ -1321,9 +1321,13 @@ meta_prefs_init (void)
   if (is_gnoblin_session ())
     {
 #ifdef HAVE_WAYLAND
-      g_autofree char *path = gnoblin_config_path ();
       g_autoptr (GError) error = NULL;
-      g_autoptr (GVariant) document = gnoblin_config_load_document (path, NULL, NULL, &error);
+      g_autoptr (GVariant) document = gnoblin_config_current_document ();
+      if (!document)
+        {
+          g_autofree char *path = gnoblin_config_path ();
+          document = gnoblin_config_load_document (path, NULL, NULL, &error);
+        }
       g_autoptr (GVariant) window_management = document
         ? g_variant_lookup_value (document, "window-management", G_VARIANT_TYPE_VARDICT)
         : NULL;
