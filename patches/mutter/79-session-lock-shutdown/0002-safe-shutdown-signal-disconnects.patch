From d4aafac327b56dc142983974e0f34ad1514ea587 Mon Sep 17 00:00:00 2001
From: Gnoblin contributors <gnoblin@localhost>
Date: Fri, 25 Sep 2026 21:05:00 +0100
Subject: [PATCH] wayland: tolerate dependencies gone during shutdown

Disconnect shutdown signal handlers only while their source object is still
alive. Wayland and shell teardown can finalize these objects after the stage or
color manager has already been released.

---
 src/compositor/meta-later.c                 | 5 ++++-
 src/wayland/meta-wayland-color-management.c | 7 +++++--
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/compositor/meta-later.c b/src/compositor/meta-later.c
index 2812e66d7f..f72a50af1a 100644
--- a/src/compositor/meta-later.c
+++ b/src/compositor/meta-later.c
@@ -229,7 +229,10 @@ meta_laters_finalize (GObject *object)
   for (i = 0; i < G_N_ELEMENTS (laters->laters); i++)
     g_slist_free_full (laters->laters[i], (GDestroyNotify) meta_later_unref);
 
-  g_clear_signal_handler (&laters->before_update_handler_id, stage);
+  if (stage)
+    g_clear_signal_handler (&laters->before_update_handler_id, stage);
+  else
+    laters->before_update_handler_id = 0;
 
   G_OBJECT_CLASS (meta_laters_parent_class)->finalize (object);
 }
diff --git a/src/wayland/meta-wayland-color-management.c b/src/wayland/meta-wayland-color-management.c
index 555881369b..00168e2c3b 100644
--- a/src/wayland/meta-wayland-color-management.c
+++ b/src/wayland/meta-wayland-color-management.c
@@ -1971,8 +1971,11 @@ meta_wayland_color_manager_dispose (GObject *object)
   MetaWaylandColorManager *color_manager = META_WAYLAND_COLOR_MANAGER (object);
   MetaColorManager *meta_color_manager = get_meta_color_manager (color_manager);
 
-  g_clear_signal_handler (&color_manager->color_state_changed_handler_id,
-                          meta_color_manager);
+  if (meta_color_manager)
+    g_clear_signal_handler (&color_manager->color_state_changed_handler_id,
+                            meta_color_manager);
+  else
+    color_manager->color_state_changed_handler_id = 0;
 
   g_clear_pointer (&color_manager->outputs, g_hash_table_destroy);
   g_clear_pointer (&color_manager->surfaces, g_hash_table_destroy);
