From: Kieran <kieran@drewett.dev>
Subject: [PATCH] cursor: load Hyprcursor themes and support global launch feedback

diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -119,6 +119,12 @@
 graphene_dep = dependency('graphene-gobject-1.0', version: graphene_req)
 glycin_dep = dependency('glycin-2', version: glycin_req)
 cairo_dep = dependency('cairo', version: cairo_req)
+hyprcursor_dep = dependency('hyprcursor', version: '>= 0.1.13', required: get_option('hyprcursor'))
+have_hyprcursor = hyprcursor_dep.found()
+if have_hyprcursor
+  add_languages('cpp')
+  add_project_arguments('-std=c++20', language: 'cpp')
+endif
 pixman_dep = dependency('pixman-1', version: pixman_req)
 gsettings_desktop_schemas_dep = dependency('gsettings-desktop-schemas',
                                            version: gsettings_desktop_schemas_req)
@@ -588,6 +594,7 @@
 have_eventfd = cc.has_header('sys/eventfd.h')
 
 cdata = configuration_data()
+cdata.set('HAVE_HYPRCURSOR', have_hyprcursor)
 cdata.set_quoted('GETTEXT_PACKAGE', gettext_package)
 cdata.set_quoted('VERSION', meson.project_version())
 cdata.set_quoted('PACKAGE_NAME', meson.project_name())
diff --git a/meson.options b/meson.options
--- a/meson.options
+++ b/meson.options
@@ -1,3 +1,9 @@
+option('hyprcursor',
+  type: 'feature',
+  value: 'auto',
+  description: 'Enable Gnoblin Hyprcursor themes with Xcursor fallback'
+)
+
 option('opengl',
   type: 'boolean',
   value: true,
diff --git a/config.h.meson b/config.h.meson
--- a/config.h.meson
+++ b/config.h.meson
@@ -35,6 +35,7 @@
 
 /* Have GL for rendering */
 #mesondefine HAVE_GL
+#mesondefine HAVE_HYPRCURSOR
 
 /* Have GLES 2.0 for rendering */
 #mesondefine HAVE_GLES2
diff --git a/src/meson.build b/src/meson.build
--- a/src/meson.build
+++ b/src/meson.build
@@ -11,6 +11,9 @@
 mutter_lib_deps = [
   m_dep,
 ]
+if have_hyprcursor
+  mutter_lib_deps += hyprcursor_dep
+endif
 
 mutter_pkg_deps = [
   cairo_dep,
@@ -401,6 +404,10 @@
   'core/workspace-private.h',
 ]
 
+if have_hyprcursor
+  mutter_sources += 'backends/gnoblin-hyprcursor.cpp'
+endif
+
 if have_x11
   mutter_sources += [
     'backends/x11/cm/meta-backend-x11-cm.c',
diff --git a/src/backends/meta-cursor-sprite-xcursor.c b/src/backends/meta-cursor-sprite-xcursor.c
--- a/src/backends/meta-cursor-sprite-xcursor.c
+++ b/src/backends/meta-cursor-sprite-xcursor.c
@@ -19,6 +19,9 @@
 #include "config.h"
 
 #include "backends/meta-cursor-sprite-xcursor.h"
+#ifdef HAVE_HYPRCURSOR
+#include "backends/gnoblin-hyprcursor.h"
+#endif
 
 #include "backends/meta-backend-private.h"
 #include "backends/meta-cursor.h"
@@ -107,6 +110,9 @@
   GHashTable *cache = ensure_cache (sprite_xcursor);
 
   g_hash_table_remove_all (cache);
+#ifdef HAVE_HYPRCURSOR
+  gnoblin_hyprcursor_invalidate ();
+#endif
 }
 
 const char *
@@ -316,6 +322,17 @@
   cursor_names[0] = meta_cursor_get_name (cursor);
   cursor_names[1] = meta_cursor_get_legacy_name (cursor);
 
+#ifdef HAVE_HYPRCURSOR
+  for (i = 0; i < G_N_ELEMENTS (cursor_names); i++)
+    {
+      xcursor_images = gnoblin_hyprcursor_load (meta_prefs_get_cursor_theme (),
+                                               cursor_names[i],
+                                               meta_prefs_get_cursor_size () * scale);
+      if (xcursor_images)
+        return xcursor_images;
+    }
+#endif
+
   for (i = 0; i < G_N_ELEMENTS (cursor_names); i++)
     {
       xcursor_images =
diff --git a/src/backends/meta-cursor-tracker.c b/src/backends/meta-cursor-tracker.c
--- a/src/backends/meta-cursor-tracker.c
+++ b/src/backends/meta-cursor-tracker.c
@@ -39,6 +39,7 @@
 #include "clutter/clutter.h"
 #include "meta/main.h"
 #include "meta/util.h"
+#include "backends/meta-cursor-sprite-xcursor.h"
 
 enum
 {
@@ -76,6 +77,7 @@
   MetaCursorSprite *window_cursor;
 
   MetaCursorSprite *root_cursor;
+  MetaCursorSprite *gnoblin_launch_cursor;
 } MetaCursorTrackerPrivate;
 
 G_DEFINE_TYPE_WITH_PRIVATE (MetaCursorTracker, meta_cursor_tracker,
@@ -114,7 +116,9 @@
   MetaDisplay *display = meta_context_get_display (context);
   MetaCursorSprite *cursor = NULL;
 
-  if (display && !meta_display_is_grabbed (display) && priv->has_window_cursor)
+  if (priv->gnoblin_launch_cursor)
+    cursor = priv->gnoblin_launch_cursor;
+  else if (display && !meta_display_is_grabbed (display) && priv->has_window_cursor)
     cursor = priv->window_cursor;
   else
     cursor = priv->root_cursor;
@@ -289,6 +293,7 @@
   g_clear_object (&priv->displayed_cursor);
   g_clear_object (&priv->window_cursor);
   g_clear_object (&priv->root_cursor);
+  g_clear_object (&priv->gnoblin_launch_cursor);
 
   G_OBJECT_CLASS (meta_cursor_tracker_parent_class)->dispose (object);
 }
@@ -607,3 +612,38 @@
 
   return priv->backend;
 }
+
+/**
+ * meta_cursor_tracker_set_gnoblin_launch_cursor:
+ * @tracker: the cursor tracker
+ * @active: whether to show the themed wait cursor over client cursors
+ *
+ * Changes cursor rendering without a pointer grab or focus change.
+ */
+void
+meta_cursor_tracker_set_gnoblin_launch_cursor (MetaCursorTracker *tracker,
+                                              gboolean           active)
+{
+  MetaCursorTrackerPrivate *priv =
+    meta_cursor_tracker_get_instance_private (tracker);
+
+  if (active && g_strcmp0 (g_getenv ("GNOME_SHELL_SESSION_MODE"), "gnoblin") != 0)
+    return;
+
+  if (active && !priv->gnoblin_launch_cursor)
+    priv->gnoblin_launch_cursor = META_CURSOR_SPRITE (
+      meta_cursor_sprite_xcursor_new (META_CURSOR_WAIT, tracker));
+  else if (!active)
+    g_clear_object (&priv->gnoblin_launch_cursor);
+
+  sync_cursor (tracker);
+}
+
+gboolean
+meta_cursor_tracker_get_gnoblin_launch_cursor (MetaCursorTracker *tracker)
+{
+  MetaCursorTrackerPrivate *priv =
+    meta_cursor_tracker_get_instance_private (tracker);
+
+  return priv->gnoblin_launch_cursor != NULL;
+}
diff --git a/src/meta/meta-cursor-tracker.h b/src/meta/meta-cursor-tracker.h
--- a/src/meta/meta-cursor-tracker.h
+++ b/src/meta/meta-cursor-tracker.h
@@ -60,3 +60,10 @@
 
 META_EXPORT
 void           meta_cursor_tracker_uninhibit_cursor_visibility (MetaCursorTracker *tracker);
+
+META_EXPORT
+void meta_cursor_tracker_set_gnoblin_launch_cursor (MetaCursorTracker *tracker,
+                                                   gboolean           active);
+
+META_EXPORT
+gboolean meta_cursor_tracker_get_gnoblin_launch_cursor (MetaCursorTracker *tracker);
