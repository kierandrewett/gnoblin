From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gnoblin <gnoblin@localhost>
Date: Fri, 25 Sep 2026 17:00:00 +0100
Subject: [PATCH] gnoblin: expose the shared Lua runtime API to Shell

Expose narrow Mutter entry points for Lua API invocation and queued runtime
operation draining. Gnoblin owns these additions and applies them as an overlay
patch to the pinned Mutter source.

This Mutter build always requires Wayland support, but its generated config
does not define HAVE_WAYLAND. Call the Gnoblin runtime directly instead of
building an unsupported fallback into the API wrapper.
---
diff --git a/src/core/util.c b/src/core/util.c
index 06accd2fb..5692d954f 100644
--- a/src/core/util.c
+++ b/src/core/util.c
@@ -833,5 +833,19 @@
 void
 meta_gnoblin_finish_config_event (gboolean commit)
 {
   gnoblin_config_finish_event (commit);
 }
+
+GVariant *
+meta_gnoblin_call_config_api (const char *method,
+                              GVariant   *arguments,
+                              GError    **error)
+{
+  return gnoblin_config_call_api (method, arguments, error);
+}
+
+GVariant *
+meta_gnoblin_drain_config_runtime_operations (void)
+{
+  return gnoblin_config_drain_runtime_operations ();
+}
+
diff --git a/src/meta/util.h b/src/meta/util.h
index b522e30d2..d2d1334e4 100644
--- a/src/meta/util.h
+++ b/src/meta/util.h
@@ -120,0 +121,6 @@ void meta_gnoblin_finish_config_event (gboolean commit);
+META_EXPORT
+GVariant *meta_gnoblin_call_config_api (const char *method,
+                                        GVariant *arguments,
+                                        GError **error);
+META_EXPORT
+GVariant *meta_gnoblin_drain_config_runtime_operations (void);
