From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Subject: [PATCH] Link compositor diagnostics into Gnoblin with installed library paths

---
diff --git a/src/core/mutter.c b/src/core/mutter.c
--- a/src/core/mutter.c
+++ b/src/core/mutter.c
@@ -66,7 +66,7 @@
     }
 }
 
-static const char *plugin = "libdefault";
+GType meta_gnoblin_plugin_get_type (void);
 static gint gnoblin_runtime_fd = -1;
 static char **argv_ignored = NULL;
 
@@ -76,12 +76,6 @@
     print_version,
     N_("Print version"),
     NULL
-  },
-  {
-    "mutter-plugin", 0, 0, G_OPTION_ARG_STRING,
-    &plugin,
-    N_("Mutter plugin to use"),
-    "PLUGIN",
   },
   {
     "gnoblin-runtime-fd", 0, G_OPTION_FLAG_HIDDEN, G_OPTION_ARG_INT,
@@ -194,7 +188,7 @@
 
   command_argv = g_steal_pointer (&argv_ignored);
 
-  meta_context_set_plugin_name (context, plugin);
+  meta_context_set_plugin_gtype (context, meta_gnoblin_plugin_get_type ());
 
   init_signal_handlers (context);
 
