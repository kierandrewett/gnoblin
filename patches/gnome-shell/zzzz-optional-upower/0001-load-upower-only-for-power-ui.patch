From 15a0f9c78bdd4f473c484fa92725b190608729e4 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sun, 27 Sep 2026 07:28:02 +0100
Subject: [PATCH] shell: resolve early session dependencies without GNOME power
 UI

---
 js/misc/dependencies.js | 18 ++++++++++++++----
 js/ui/panel.js          |  3 ++-
 2 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/js/misc/dependencies.js b/js/misc/dependencies.js
index 753730a40..f26ea78d0 100644
--- a/js/misc/dependencies.js
+++ b/js/misc/dependencies.js
@@ -1,4 +1,5 @@
 import gi from 'gi';
+import GLib from 'gi://GLib';
 
 /**
  * Required dependencies
@@ -21,23 +22,32 @@ import 'gi://Polkit?version=1.0';
 import 'gi://PolkitAgent?version=1.0';
 import 'gi://Rsvg?version=2.0';
 import 'gi://Soup?version=3.0';
-import 'gi://UPowerGlib?version=1.0';
 
 import * as Config from './config.js';
 
+// main.c sets this from the effective --mode before loading JavaScript.
+// Shell.Global becomes available later, in environment.js.
+const isGnoblinSession = GLib.getenv('GNOME_SHELL_SESSION_MODE') === 'gnoblin';
+
 // Gnoblin does not show GNOME's greeter or unlock dialog. Other session modes
 // still need GDM's typelib before their UI modules are loaded.
-if (global.session_mode !== 'gnoblin')
+if (!isGnoblinSession)
     gi.require('Gdm', '1.0');
 
 // Gnoblin has no date menu or weather client. Keep GNOME's version checks
 // for sessions that still create them.
-if (global.session_mode !== 'gnoblin') {
+if (!isGnoblinSession) {
     gi.require('Geoclue', '2.0');
     gi.require('GWeather', '4.0');
     gi.require('GnomeDesktop', '4.0');
 }
 
+// The direct Gnoblin session has no GNOME power menu or end-session dialog.
+// GNOME sessions and the optional GNOME Session path still use UPower.
+if (!isGnoblinSession ||
+    GLib.getenv('GNOBLIN_STANDALONE_SESSION') !== '1')
+    gi.require('UPowerGlib', '1.0');
+
 // Meta-related dependencies use a shared version
 // from the compile-time config.
 gi.require('Meta', Config.LIBMUTTER_API_VERSION);
@@ -60,7 +70,7 @@ if (Config.HAVE_NETWORKMANAGER) {
     gi.require('NM', '1.0');
     // Gnoblin has no Quick Settings network menu. Its secret agent uses NM
     // without the libnma GTK widgets required by GNOME's panel.
-    if (global.session_mode !== 'gnoblin')
+    if (!isGnoblinSession)
         gi.require('NMA4', '1.0');
 } else {
     console.debug('GNOME Shell was compiled without Network Manager support');
diff --git a/js/ui/panel.js b/js/ui/panel.js
index f5ef1712c..b2c14a907 100644
--- a/js/ui/panel.js
+++ b/js/ui/panel.js
@@ -21,7 +21,6 @@ import * as RFKillStatus from './status/rfkill.js';
 import * as CameraStatus from './status/camera.js';
 import * as VolumeStatus from './status/volume.js';
 import * as BrightnessStatus from './status/brightness.js';
-import * as SystemStatus from './status/system.js';
 import * as LocationStatus from './status/location.js';
 import * as NightLightStatus from './status/nightLight.js';
 import * as DarkModeStatus from './status/darkMode.js';
@@ -314,6 +313,8 @@ class QuickSettings extends PanelMenu.Button {
     }
 
     async _setupIndicators() {
+        const SystemStatus = await import('./status/system.js');
+
         if (Config.HAVE_NETWORKMANAGER) {
             /** @type {import('./status/network.js')} */
             const NetworkStatus = await import('./status/network.js');
-- 
