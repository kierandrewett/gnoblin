diff --git a/js/ui/osdWindow.js b/js/ui/osdWindow.js
--- a/js/ui/osdWindow.js
+++ b/js/ui/osdWindow.js
@@ -144,12 +144,19 @@
 export class OsdWindowManager {
     constructor() {
         this._osdWindows = [];
+        // Gnoblin forwards OSD requests to external chrome without actors.
+        if (global.session_mode === 'gnoblin')
+            return;
+
         Main.layoutManager.connect('monitors-changed',
             this._monitorsChanged.bind(this));
         this._monitorsChanged();
     }
 
     _monitorsChanged() {
+        if (global.session_mode === 'gnoblin')
+            return;
+
         for (let i = 0; i < Main.layoutManager.monitors.length; i++) {
             if (this._osdWindows[i] === undefined)
                 this._osdWindows[i] = new OsdWindow(i);
@@ -164,6 +171,10 @@
     }
 
     _showOsdWindow(monitorIndex, icon, label, level, maxLevel) {
+        // gnoblinControl installs the external OSD transport on this method.
+        if (global.session_mode === 'gnoblin')
+            return;
+
         this._osdWindows[monitorIndex].setIcon(icon);
         this._osdWindows[monitorIndex].setLabel(label);
         this._osdWindows[monitorIndex].setMaxLevel(maxLevel);
@@ -172,12 +183,12 @@
     }
 
     show(icon, label, levels) {
-        for (let i = 0; i < this._osdWindows.length; i++) {
+        for (let i = 0; i < Main.layoutManager.monitors.length; i++) {
             if (levels[i]) {
                 const {level, maxLevel = -1} = levels[i];
                 this._showOsdWindow(i, icon, label, level, maxLevel);
             } else {
-                this._osdWindows[i].cancel();
+                this._osdWindows[i]?.cancel();
             }
         }
     }
@@ -189,7 +200,7 @@
     }
 
     showAll(icon, label, level, maxLevel) {
-        for (let i = 0; i < this._osdWindows.length; i++)
+        for (let i = 0; i < Main.layoutManager.monitors.length; i++)
             this._showOsdWindow(i, icon, label, level, maxLevel);
     }
 
diff --git a/js/ui/padOsd.js b/js/ui/padOsd.js
