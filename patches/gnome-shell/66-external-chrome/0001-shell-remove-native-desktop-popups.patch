-
-let gnoblinSettings = null;
-let gnoblinSettingsResolved = false;
-
-// Tablet-pad requests do not use OsdWindowManager. This shared predicate lets
-// the Gnoblin feature contract cover the dedicated PadOsd path as well.
+// The external shell owns tablet-pad controls throughout the Gnoblin session.
 export function isPadOsdEnabled() {
-    if (Main.sessionMode?.currentMode !== 'gnoblin')
-        return true;
-
-    if (!gnoblinSettingsResolved) {
-        try {
-            gnoblinSettings = new Gio.Settings({
-                schema_id: GNOBLIN_SETTINGS_SCHEMA,
-            });
-        } catch (error) {
-            log(`pad-osd: unable to load Gnoblin settings: ${error.message}`);
-        }
-        gnoblinSettingsResolved = true;
-    }
-
-    if (!gnoblinSettings)
-        return true;
-
-    const disabled = gnoblinSettings.get_strv(GNOBLIN_DISABLED_FEATURES_KEY);
-    return !disabled.includes('osd') && !disabled.includes('osd-pad');
+    return global.session_mode !== 'gnoblin';
 }
 
