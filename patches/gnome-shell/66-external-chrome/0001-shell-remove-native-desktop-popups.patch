From 8e9975d367d1f35a49d806cb7650ae169ade68fb Mon Sep 17 00:00:00 2001
From: Kieran Drewett <kieran@drewett.dev>
Date: Sat, 19 Sep 2026 21:55:24 +0100
Subject: [PATCH] shell: remove native desktop popups from Gnoblin

Keep window, capture and desktop recovery services while external chrome owns desktop controls.
OSD requests use the existing transport without allocating native widgets.
Stock GNOME retains its UI.
---
 js/ui/main.js                | 15 ++++++++++++---
 js/ui/osdMonitorLabeler.js   |  3 +++
 js/ui/osdWindow.js           | 17 ++++++++++++++---
 js/ui/padOsd.js              | 29 ++---------------------------
 js/ui/screenshot.js          | 12 ++++++++++++
 js/ui/status/remoteAccess.js |  9 ++++++---
 js/ui/status/system.js       |  6 ++++--
 js/ui/windowManager.js       |  2 +-
 8 files changed, 54 insertions(+), 39 deletions(-)

diff --git a/js/ui/main.js b/js/ui/main.js
index c7e2862..c44f75d 100644
--- a/js/ui/main.js
+++ b/js/ui/main.js
@@ -242,7 +242,8 @@ async function _initializeUI() {
     global.connect('shutdown',
         () => global.stage.context.get_backend().set_input_method(null));
 
-    screenshotUI = new Screenshot.ScreenshotUI();
+    if (global.session_mode !== 'gnoblin')
+        screenshotUI = new Screenshot.ScreenshotUI();
 
     brightnessManager = new BrightnessManager.BrightnessManager();
     brightnessDBus = new ShellDBus.BrightnessDBus(brightnessManager);
@@ -260,8 +261,10 @@ async function _initializeUI() {
     breakManager = new BreakManager.BreakManager();
     timeLimitsManager = new TimeLimitsManager.TimeLimitsManager();
     screenTimeDBus = new ShellDBus.ScreenTimeDBus(breakManager);
-    breakManagerDispatcher = new BreakManager.BreakDispatcher(breakManager);
-    timeLimitsDispatcher = new TimeLimitsManager.TimeLimitsDispatcher(timeLimitsManager);
+    if (global.session_mode !== 'gnoblin') {
+        breakManagerDispatcher = new BreakManager.BreakDispatcher(breakManager);
+        timeLimitsDispatcher = new TimeLimitsManager.TimeLimitsDispatcher(timeLimitsManager);
+    }
 
     global.connect('shutdown', () => {
         // Block shutdown until the session history file has been written
@@ -818,6 +821,9 @@ export function createLookingGlass() {
  * Opens the run dialog
  */
 export function openRunDialog() {
+    if (!sessionMode.hasRunDialog)
+        return;
+
     if (runDialog == null)
         runDialog = new RunDialog.RunDialog();
 
@@ -825,6 +831,9 @@ export function openRunDialog() {
 }
 
 export function openWelcomeDialog() {
+    if (!sessionMode.showWelcomeDialog)
+        return;
+
     if (welcomeDialog === null)
         welcomeDialog = new WelcomeDialog.WelcomeDialog();
 
diff --git a/js/ui/osdMonitorLabeler.js b/js/ui/osdMonitorLabeler.js
index f27d06c..89f51ac 100644
--- a/js/ui/osdMonitorLabeler.js
+++ b/js/ui/osdMonitorLabeler.js
@@ -92,6 +92,9 @@ export class OsdMonitorLabeler {
     }
 
     show(client, params) {
+        if (global.session_mode === 'gnoblin')
+            return;
+
         if (!this._trackClient(client))
             return;
 
diff --git a/js/ui/osdWindow.js b/js/ui/osdWindow.js
index 47c840a..dd9f8fd 100644
--- a/js/ui/osdWindow.js
+++ b/js/ui/osdWindow.js
@@ -143,12 +143,19 @@ class OsdWindow extends Clutter.Actor {
 export class OsdWindowManager {
     constructor() {
         this._osdWindows = [];
+        // Gnoblin forwards OSD requests to external chrome without actors.
+        if (global.session_mode === 'gnoblin')
+            return;
+
         Main.layoutManager.connect('monitors-changed',
             this._monitorsChanged.bind(this));
         this._monitorsChanged();
     }
 
     _monitorsChanged() {
+        if (global.session_mode === 'gnoblin')
+            return;
+
         for (let i = 0; i < Main.layoutManager.monitors.length; i++) {
             if (this._osdWindows[i] === undefined)
                 this._osdWindows[i] = new OsdWindow(i);
@@ -163,6 +170,10 @@ export class OsdWindowManager {
     }
 
     _showOsdWindow(monitorIndex, icon, label, level, maxLevel) {
+        // gnoblinControl installs the external OSD transport on this method.
+        if (global.session_mode === 'gnoblin')
+            return;
+
         this._osdWindows[monitorIndex].setIcon(icon);
         this._osdWindows[monitorIndex].setLabel(label);
         this._osdWindows[monitorIndex].setMaxLevel(maxLevel);
@@ -171,12 +182,12 @@ export class OsdWindowManager {
     }
 
     show(icon, label, levels) {
-        for (let i = 0; i < this._osdWindows.length; i++) {
+        for (let i = 0; i < Main.layoutManager.monitors.length; i++) {
             if (levels[i]) {
                 const {level, maxLevel = -1} = levels[i];
                 this._showOsdWindow(i, icon, label, level, maxLevel);
             } else {
-                this._osdWindows[i].cancel();
+                this._osdWindows[i]?.cancel();
             }
         }
     }
@@ -188,7 +199,7 @@ export class OsdWindowManager {
     }
 
     showAll(icon, label, level, maxLevel) {
-        for (let i = 0; i < this._osdWindows.length; i++)
+        for (let i = 0; i < Main.layoutManager.monitors.length; i++)
             this._showOsdWindow(i, icon, label, level, maxLevel);
     }
 
diff --git a/js/ui/padOsd.js b/js/ui/padOsd.js
index 6e9abbe..e9173d9 100644
--- a/js/ui/padOsd.js
+++ b/js/ui/padOsd.js
@@ -19,34 +19,9 @@ import {loadInterfaceXML} from '../misc/fileUtils.js';
 
 const ACTIVE_COLOR = 'st-lighten(-st-accent-color, 15%)';
 
-const GNOBLIN_SETTINGS_SCHEMA = 'org.gnoblin.shell';
-const GNOBLIN_DISABLED_FEATURES_KEY = 'disabled-features';
-
-let gnoblinSettings = null;
-let gnoblinSettingsResolved = false;
-
-// Tablet-pad requests do not use OsdWindowManager. This shared predicate lets
-// the Gnoblin feature contract cover the dedicated PadOsd path as well.
+// The external shell owns tablet-pad controls throughout the Gnoblin session.
 export function isPadOsdEnabled() {
-    if (Main.sessionMode?.currentMode !== 'gnoblin')
-        return true;
-
-    if (!gnoblinSettingsResolved) {
-        try {
-            gnoblinSettings = new Gio.Settings({
-                schema_id: GNOBLIN_SETTINGS_SCHEMA,
-            });
-        } catch (error) {
-            log(`pad-osd: unable to load Gnoblin settings: ${error.message}`);
-        }
-        gnoblinSettingsResolved = true;
-    }
-
-    if (!gnoblinSettings)
-        return true;
-
-    const disabled = gnoblinSettings.get_strv(GNOBLIN_DISABLED_FEATURES_KEY);
-    return !disabled.includes('osd') && !disabled.includes('osd-pad');
+    return global.session_mode !== 'gnoblin';
 }
 
 const LTR = 0;
diff --git a/js/ui/screenshot.js b/js/ui/screenshot.js
index 02560b9..709316d 100644
