  */
 export function showScreenRecordingUI() {
+    if (!Main.screenshotUI)
+        return;
+
     Main.screenshotUI.open(UIMode.SCREENCAST).catch(err => {
         logError(err, 'Error opening the screenshot UI');
     });
@@ -3087,6 +3093,12 @@ export class ScreenshotService {
     }
 
     async InteractiveScreenshotAsync(params, invocation) {
+        if (!Main.screenshotUI) {
+            invocation.return_error_literal(Gio.IOErrorEnum, Gio.IOErrorEnum.NOT_SUPPORTED,
+                'Gnoblin delegates interactive screenshots to the external shell');
+            return;
+        }
+
         try {
             await this._senderChecker.checkInvocation(invocation);
         } catch (e) {
diff --git a/js/ui/status/remoteAccess.js b/js/ui/status/remoteAccess.js
index 3bcdcbb..4b45257 100644
--- a/js/ui/status/remoteAccess.js
+++ b/js/ui/status/remoteAccess.js
@@ -36,7 +36,7 @@ class RemoteAccessApplet extends SystemIndicator {
     _isRecording() {
         // Screenshot UI screencasts have their own panel, so don't show this
         // indicator if there's only a screenshot UI screencast.
-        if (Main.screenshotUI.screencast_in_progress)
+        if (Main.screenshotUI?.screencast_in_progress)
             return this._handles.size > 1;
 
         return this._handles.size > 0;
@@ -88,14 +88,14 @@ export const ScreenRecordingIndicator = GObject.registerClass({
         this._box.add_child(this._icon);
 
         this.hide();
-        Main.screenshotUI.connect(
+        Main.screenshotUI?.connect(
             'notify::screencast-in-progress',
             this._onScreencastInProgressChanged.bind(this));
 
         this._clickGesture = new Clutter.ClickGesture();
         this._clickGesture.set_recognize_on_press(true);
         this._clickGesture.connect(
-            'recognize', () => Main.screenshotUI.stopScreencast());
+            'recognize', () => Main.screenshotUI?.stopScreencast());
         this.add_action(this._clickGesture);
     }
 
@@ -106,6 +106,9 @@ export const ScreenRecordingIndicator = GObject.registerClass({
     }
 
     _onScreencastInProgressChanged() {
+        if (!Main.screenshotUI)
+            return;
+
         if (Main.screenshotUI.screencast_in_progress) {
             this.show();
 
diff --git a/js/ui/status/system.js b/js/ui/status/system.js
index 64d2a5e..cbd8848 100644
--- a/js/ui/status/system.js
+++ b/js/ui/status/system.js
@@ -278,8 +278,10 @@ class SystemItem extends QuickSettingsItem {
             GObject.BindingFlags.SYNC_CREATE);
         this.child.add_child(this._laptopSpacer);
 
