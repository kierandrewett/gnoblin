 import * as LoginManager from '../misc/loginManager.js';
@@ -838,44 +838,97 @@ class BackgroundSource {
     }
 }
 
-const Animation = GObject.registerClass(
-class Animation extends GnomeBG.BGSlideShow {
-    _init(params) {
-        super._init(params);
-
+class Animation {
+    constructor({file}) {
+        this.file = file;
         this.keyFrameFiles = [];
-        this.transitionProgress = 0.0;
-        this.transitionDuration = 0.0;
+        this.transitionProgress = 0;
+        this.transitionDuration = 0;
         this.loaded = false;
+        this._schedule = null;
     }
 
     load_async(cancellable, callback) {
-        super.load_async(cancellable, () => {
-            this.loaded = true;
-
-            callback?.();
+        this.file.load_contents_async(cancellable, (file, result) => {
+            try {
+                const [loaded, contents] = file.load_contents_finish(result);
+                if (loaded) {
+                    const xml = new TextDecoder().decode(contents);
+                    this._schedule = JSON.parse(Shell.util_parse_wallpaper_slideshow(xml));
+                    if (this._schedule.slides.length === 1)
+                        this._schedule.slides[0].duration = GLib.MAXUINT32;
+                    this._schedule.totalDuration = this._schedule.slides.reduce(
+                        (sum, slide) => sum + slide.duration, 0);
+                }
+            } catch (error) {
+                if (!error.matches?.(Gio.IOErrorEnum, Gio.IOErrorEnum.CANCELLED))
+                    logError(error, 'Failed to load wallpaper slideshow');
+            } finally {
+                this.loaded = true;
+                callback?.();
+            }
         });
     }
 
     update(monitor) {
         this.keyFrameFiles = [];
-
-        if (this.get_num_slides() < 1)
+        this.transitionDuration = 0;
+        this.transitionProgress = 0;
+        const schedule = this._schedule;
+        if (!schedule?.totalDuration)
             return;
 
-        const [progress, duration, isFixed_, filename1, filename2] =
-            this.get_current_slide(monitor.width, monitor.height);
-
-        this.transitionDuration = duration;
-        this.transitionProgress = progress;
-
-        if (filename1)
-            this.keyFrameFiles.push(Gio.File.new_for_path(filename1));
+        const now = GLib.get_real_time() / 1_000_000;
+        const elapsed = ((now - schedule.startTime) % schedule.totalDuration +
+            schedule.totalDuration) % schedule.totalDuration;
+        let slideStart = 0;
+        for (const slide of schedule.slides) {
+            if (elapsed >= slideStart + slide.duration) {
+                slideStart += slide.duration;
+                continue;
+            }
+            this.transitionDuration = slide.duration;
+            this.transitionProgress = (elapsed - slideStart) / slide.duration;
+            for (const candidates of [slide.from, slide.to]) {
+                const path = this._bestFile(candidates, monitor);
+                if (path)
+                    this.keyFrameFiles.push(Gio.File.new_for_path(path));
+            }
+            return;
+        }
+    }
 
-        if (filename2)
-            this.keyFrameFiles.push(Gio.File.new_for_path(filename2));
+    _bestFile(candidates, monitor) {
+        if (!candidates?.length)
+            return null;
+        const ratio = monitor.width / monitor.height;
+        for (const requireLarge of [true, false]) {
+            let best = null;
+            let distance = Infinity;
+            // GNOME's size list prefers the last declared variant on ties.
+            for (let i = candidates.length - 1; i >= 0; i--) {
+                const candidate = candidates[i];
+                if (requireLarge &&
+                    (candidate.width < monitor.width || candidate.height < monitor.height))
+                    continue;
+                const candidateRatio = candidate.height !== 0
+                    ? candidate.width / candidate.height
+                    : ratio;
+                const difference = Math.abs(ratio - candidateRatio);
+                if (difference < distance ||
+                    (difference === distance && best &&
+                     Math.abs(candidate.width - monitor.width) <
+                     Math.abs(best.width - monitor.width))) {
+                    best = candidate;
+                    distance = difference;
+                }
+            }
+            if (best)
+                return best.path;
+        }
+        return candidates[0].path;
     }
-});
+}
 
