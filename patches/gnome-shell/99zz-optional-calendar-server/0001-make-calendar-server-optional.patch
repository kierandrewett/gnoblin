From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Fri, 25 Sep 2026 05:21:17 +0100
Subject: [PATCH] shell: make calendar server optional

---
diff --git a/meson.build b/meson.build
index 130702c9c..109433374 100644
--- a/meson.build
+++ b/meson.build
@@ -75,8 +75,10 @@ endif
 
 atk_bridge_dep = dependency('atk-bridge-2.0')
 cairo_dep = dependency('cairo')
-ecal_dep = dependency('libecal-2.0', version: ecal_req)
-eds_dep = dependency('libedataserver-1.2', version: eds_req)
+if get_option('calendar_server')
+  ecal_dep = dependency('libecal-2.0', version: ecal_req)
+  eds_dep = dependency('libedataserver-1.2', version: eds_req)
+endif
 gcr_dep = dependency('gcr-4', version: gcr_req)
 gdk_pixbuf_dep = dependency('gdk-pixbuf-2.0')
 gi_dep = dependency('girepository-2.0', version: gio_req)
diff --git a/meson.options b/meson.options
index 7b5d804b8..d07d41c11 100644
--- a/meson.options
+++ b/meson.options
@@ -10,6 +10,12 @@ option('extensions_tool',
   description: 'Build gnome-extensions CLI tool'
 )
 
+option('calendar_server',
+  type: 'boolean',
+  value: true,
+  description: 'Build calendar event integration'
+)
+
 option('gtk_doc',
   type: 'boolean',
   value: false,
diff --git a/src/meson.build b/src/meson.build
index 63e96afae..5cc3f9cf1 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -10,7 +10,9 @@ introspection_common = {
   'fatal_warnings': get_option('werror'),
 }
 
-subdir('calendar-server')
+if get_option('calendar_server')
+  subdir('calendar-server')
+endif
 subdir('hotplug-sniffer')
 subdir('st')
 if have_xwayland
