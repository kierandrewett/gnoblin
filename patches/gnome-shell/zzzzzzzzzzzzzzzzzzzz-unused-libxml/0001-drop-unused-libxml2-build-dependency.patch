From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sun, 27 Sep 2026 07:28:02 +0100
Subject: [PATCH] build: drop unused libxml2 dependency

---
diff --git a/meson.build b/meson.build
index 7e876f221..23f3ffd3f 100644
--- a/meson.build
+++ b/meson.build
@@ -85,7 +85,6 @@ gio_dep = dependency('gio-2.0', version: gio_req)
 gio_unix_dep = dependency('gio-unix-2.0', version: gio_req)
 gjs_dep = dependency('gjs-1.0', version: gjs_req)
 gtk_dep = dependency('gtk4', version: gtk_req)
-libxml_dep = dependency('libxml-2.0')
 clutter_dep = dependency(clutter_pc, version: mutter_req)
 mtk_dep = dependency(mtk_pc, version: mutter_req)
 cogl_dep = dependency(cogl_pc, version: mutter_req)
diff --git a/src/meson.build b/src/meson.build
index 6ece774b0..e80ee7c45 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -69,7 +69,6 @@ install_rpath = ':'.join([mutter_typelibdir, pkglibdir])
 
 gnome_shell_deps = [
   gio_unix_dep,
-  libxml_dep,
   json_glib_dep,
   atk_bridge_dep,
   gdk_pixbuf_dep,
diff --git a/src/st/meson.build b/src/st/meson.build
index bc905a52d..70f64f46b 100644
--- a/src/st/meson.build
+++ b/src/st/meson.build
@@ -184,7 +184,6 @@ libst = shared_library('st-' + mutter_api_version,
   sources: st_gir_sources + st_nogir_sources + croco_sources + cursor_theme_resource,
   c_args: st_cflags,
   dependencies: st_deps + [
-    libxml_dep,
     m_dep,
     schemas_dep,
     json_glib_dep,
@@ -208,7 +207,7 @@ if get_option('tests') and have_xwayland
   test_theme = executable('test-theme',
     sources: 'test-theme.c',
     c_args: st_cflags,
-    dependencies: [mutter_test_dep, mtk_dep, libxml_dep, pango_dep],
+    dependencies: [mutter_test_dep, mtk_dep, pango_dep],
     build_rpath: mutter_typelibdir,
     link_with: libst
   )
