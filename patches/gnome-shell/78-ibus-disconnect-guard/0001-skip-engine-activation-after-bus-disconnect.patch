From be9cb4f2dddda8320f20dada05efd7c4ed0d75b0 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sun, 27 Sep 2026 06:47:33 +0100
Subject: [PATCH] ibusManager: Skip engine activation after bus disconnect

---
 js/misc/ibusManager.js | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/js/misc/ibusManager.js b/js/misc/ibusManager.js
index b3279d5fc..7e9261015 100644
--- a/js/misc/ibusManager.js
+++ b/js/misc/ibusManager.js
@@ -275,7 +275,9 @@ class IBusManager extends Signals.EventEmitter {
         // Send id even if id == this._currentEngineName
         // because 'properties-registered' signal can be emitted
         // while this._ibusSources == null on a lock screen.
-        if (!this._ready)
+        // The connection can close before the `disconnected` signal clears
+        // `_ready`; never call IBus while the bus is already disconnected.
+        if (!this._ready || !this._ibus.is_connected())
             return;
 
         const cancellable = this._cancellable;
