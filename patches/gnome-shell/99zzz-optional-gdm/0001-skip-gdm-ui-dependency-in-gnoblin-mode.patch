From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Fri, 25 Sep 2026 05:21:17 +0100
Subject: [PATCH] shell: allow Gnoblin mode without GDM UI libraries

---
diff --git a/js/misc/dependencies.js b/js/misc/dependencies.js
index cbe1e4275..f70f2d986 100644
--- a/js/misc/dependencies.js
+++ b/js/misc/dependencies.js
@@ -9,7 +9,6 @@ import 'gi://Atk?version=1.0';
 import 'gi://Atspi?version=2.0';
 import 'gi://Gcr?version=4';
 import 'gi://Gdk?version=4.0';
-import 'gi://Gdm?version=1.0';
 import 'gi://Gio?version=2.0';
 import 'gi://GioUnix?version=2.0';
 import 'gi://GDesktopEnums?version=3.0';
@@ -28,6 +27,11 @@ import 'gi://UPowerGlib?version=1.0';
 
 import * as Config from './config.js';
 
+// Gnoblin does not show GNOME's greeter or unlock dialog. Other session modes
+// still need GDM's typelib before their UI modules are loaded.
+if (global.session_mode !== 'gnoblin')
+    gi.require('Gdm', '1.0');
+
 // Gnoblin has no date menu or weather client. Keep GNOME's version checks
 // for sessions that still create them.
 if (global.session_mode !== 'gnoblin') {
diff --git a/js/misc/systemActions.js b/js/misc/systemActions.js
index c06b94f1f..7aacc85ab 100644
--- a/js/misc/systemActions.js
+++ b/js/misc/systemActions.js
@@ -1,6 +1,5 @@
 import AccountsService from 'gi://AccountsService';
 import Clutter from 'gi://Clutter';
-import Gdm from 'gi://Gdm';
 import Gio from 'gi://Gio';
 import GLib from 'gi://GLib';
 import GObject from 'gi://GObject';
@@ -12,6 +11,14 @@ import * as Main from '../ui/main.js';
 import * as Screenshot from '../ui/screenshot.js';
 import * as GnoblinSessionLock from '../ui/components/gnoblinSessionLock.js';
 
+let Gdm = null;
+try {
+    ({default: Gdm} = await import('gi://Gdm?version=1.0'));
+} catch (error) {
+    if (global.session_mode !== 'gnoblin')
+        throw error;
+}
+
 const LOCKDOWN_SCHEMA = 'org.gnome.desktop.lockdown';
 const LOGIN_SCREEN_SCHEMA = 'org.gnome.login-screen';
 const SCREENSAVER_SCHEMA = 'org.gnome.desktop.screensaver';
@@ -454,7 +461,7 @@ const SystemActions = GObject.registerClass({
         const multiUser = this._userManager.can_switch() && this._userManager.has_multiple_users;
         const shouldShowInMode = !Main.sessionMode.isLocked && !Main.sessionMode.isGreeter;
 
-        const visible = allowSwitch && multiUser && shouldShowInMode;
+        const visible = Gdm !== null && allowSwitch && multiUser && shouldShowInMode;
         this._actions.get(SWITCH_USER_ACTION_ID).available = visible;
         this.notify('can-switch-user');
 
@@ -466,7 +473,7 @@ const SystemActions = GObject.registerClass({
         const alwaysShow = global.settings.get_boolean(ALWAYS_SHOW_LOG_OUT_KEY);
         const {systemAccount, localAccount} = this._user;
         const multiUser = this._userManager.has_multiple_users;
-        const multiSession = Gdm.get_session_ids().length > 1;
+        const multiSession = Gdm !== null && Gdm.get_session_ids().length > 1;
         const shouldShowInMode = !Main.sessionMode.isLocked && !Main.sessionMode.isGreeter;
 
         const visible = allowLogout && (alwaysShow || multiUser || multiSession || systemAccount || !localAccount) && shouldShowInMode;
diff --git a/js/ui/sessionMode.js b/js/ui/sessionMode.js
index b4f2437c6..07bcdf360 100644
--- a/js/ui/sessionMode.js
+++ b/js/ui/sessionMode.js
@@ -3,11 +3,15 @@ import * as Signals from '../misc/signals.js';
 
 import * as FileUtils from '../misc/fileUtils.js';
 
-import {LoginDialog}  from '../gdm/loginDialog.js';
-import {UnlockDialog} from '../ui/unlockDialog.js';
-
 import * as Config from '../misc/config.js';
 
+let LoginDialog = null;
+let UnlockDialog = null;
+if (global.session_mode !== 'gnoblin') {
+    ({LoginDialog} = await import('../gdm/loginDialog.js'));
+    ({UnlockDialog} = await import('../ui/unlockDialog.js'));
+}
+
 const DEFAULT_MODE = 'restrictive';
 
 const USER_SESSION_COMPONENTS = [
