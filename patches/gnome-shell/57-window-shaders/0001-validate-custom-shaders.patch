From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gnoblin <gnoblin@localhost>
Date: Fri, 12 Sep 2026 05:00:00 +0100
Subject: [PATCH] shell: build native custom shader support

--- a/src/meson.build
+++ b/src/meson.build
@@ -116,4 +116,5 @@
   'shell-edge-drag-gesture.h',
   'shell-glsl-effect.h',
+  'shell-gnoblin-shader.h',
   'shell-global.h',
   'shell-invert-lightness-effect.h',
@@ -168,4 +169,5 @@
   'shell-global.c',
   'shell-glsl-effect.c',
+  'shell-gnoblin-shader.c',
   'shell-invert-lightness-effect.c',
   'shell-keyring-prompt.c',
@@ -239,5 +241,5 @@
 libshell = library('shell-' + mutter_api_version,
   sources: libshell_gir_sources + libshell_no_gir_sources,
-  dependencies: gnome_shell_deps + [libshell_menu_dep, libst_dep, mutter_dep, gnome_desktop_dep, m_dep],
+  dependencies: gnome_shell_deps + [dependency('epoxy'), libshell_menu_dep, libst_dep, mutter_dep, gnome_desktop_dep, m_dep],
   include_directories: [conf_inc, include_directories('tray')],
   c_args: gnome_shell_cflags,
