From 603daab5d84df00c3a20e81dc835dff8f67bd075 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Fri, 25 Sep 2026 14:16:06 +0100
Subject: [PATCH] shell: anchor wallpaper behavior inside LayoutManager

The original zero-context hunks were applied at end of file, outside the class. Add unique surrounding lines so the state, setter, and background guard remain in LayoutManager and the JavaScript resource parses.
---
 js/ui/layout.js | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/js/ui/layout.js b/js/ui/layout.js
index 47cf50cf7..4eb802bc8 100644
--- a/js/ui/layout.js
+++ b/js/ui/layout.js
@@ -313,6 +313,7 @@ export const LayoutManager = GObject.registerClass({
         global.window_group.add_child(this._backgroundGroup);
         global.window_group.set_child_below_sibling(this._backgroundGroup, null);
         this._bgManagers = [];
+        this._gnoblinWallpaperEnabled = true;
 
         this._interfaceSettings = new Gio.Settings({
             schema_id: 'org.gnome.desktop.interface',
@@ -501,6 +502,12 @@ export const LayoutManager = GObject.registerClass({
         return bgManager;
     }
 
+    setGnoblinWallpaperEnabled(enabled) {
+        this._gnoblinWallpaperEnabled = Boolean(enabled);
+        if (Main.sessionMode.currentMode === 'gnoblin')
+            this._updateBackgrounds().catch(logError);
+    }
+
     _showSecondaryBackgrounds() {
         for (let i = 0; i < this.monitors.length; i++) {
             if (i !== this.primaryIndex) {
@@ -540,6 +547,9 @@ export const LayoutManager = GObject.registerClass({
 
         this._bgManagers = [];
 
+        if (Main.sessionMode.currentMode === 'gnoblin' && !this._gnoblinWallpaperEnabled)
+            return Promise.resolve();
+
         if (Main.sessionMode.isGreeter)
             return Promise.resolve();
 
-- 
