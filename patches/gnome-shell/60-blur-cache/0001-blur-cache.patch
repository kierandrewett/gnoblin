+
+unsigned int
+shell_blur_effect_get_cache_build_count (ShellBlurEffect *self)
+{
+  return self->blur_cache ? clutter_blur_cache_get_build_count (self->blur_cache) : 0;
+}
+
+void
+shell_blur_effect_set_region (ShellBlurEffect *self,
+                              float x, float y, float width, float height)
+{
+  g_return_if_fail (isfinite (x) && isfinite (y) && isfinite (width) && isfinite (height));
+  g_return_if_fail (width >= 0 && height >= 0);
+  ClutterActorBox region = {x, y, x + width, y + height};
+  if (self->has_region && clutter_actor_box_equal (&self->region, &region))
+    return;
+  self->region = region;
+  self->has_region = TRUE;
+  self->background_dirty = TRUE;
+  self->cache_flags &= ~BLUR_APPLIED;
+  if (self->actor) clutter_actor_queue_redraw (self->actor);
+}
+
+void
+shell_blur_effect_clear_region (ShellBlurEffect *self)
+{
+  if (!self->has_region) return;
+  self->has_region = FALSE;
+  self->background_dirty = TRUE;
+  self->cache_flags &= ~BLUR_APPLIED;
+  if (self->actor) clutter_actor_queue_redraw (self->actor);
+}
+
+gboolean
+shell_blur_effect_uses_damage_tracking (ShellBlurEffect *self)
+{
+  return TRUE;
+}
+
+unsigned int
+shell_blur_effect_get_repaint_count (ShellBlurEffect *self)
+{
+  return self->repaint_count;
+}
+
+gboolean
+shell_blur_effect_uses_surface_fade (ShellBlurEffect *self)
+{
+  return TRUE;
+}
