 static GParamSpec *properties [N_PROPS] = { NULL, };
+
+/* Blur dependencies are evaluated once before each view is painted. Expanding
+ * the queued scene damage preserves backdrop pixels without forcing a full
+ * monitor redraw. Buffer-age repair does not invalidate an unchanged cache. */
+static GSList *backdrop_effects;
+static gulong backdrop_handler;
+
+static void
+get_blur_box (ShellBlurEffect *self,
+              ClutterActorBox *box)
+{
+  float width, height;
+  clutter_actor_get_size (self->actor, &width, &height);
+  *box = (ClutterActorBox) {0, 0, width, height};
+  if (self->has_region)
+    {
+      float margin = ceilf (self->radius * 2.f);
+      box->x1 = MAX (0, self->region.x1 - margin);
+      box->y1 = MAX (0, self->region.y1 - margin);
+      box->x2 = MIN (width, self->region.x2 + margin);
+      box->y2 = MIN (height, self->region.y2 + margin);
+    }
+}
+
+static MtkRectangle
+get_stage_blur_box (ShellBlurEffect *self)
+{
+  ClutterActorBox box;
+  float x, y, width, height, actor_width, actor_height;
+  clutter_actor_get_transformed_position (self->actor, &x, &y);
+  clutter_actor_get_transformed_size (self->actor, &width, &height);
+  clutter_actor_get_size (self->actor, &actor_width, &actor_height);
+  get_blur_box (self, &box);
+  float sx = actor_width > 0 ? width / actor_width : 1;
+  float sy = actor_height > 0 ? height / actor_height : 1;
+  int left = floorf (x + box.x1 * sx);
+  int top = floorf (y + box.y1 * sy);
+  return (MtkRectangle) {left, top,
+    MAX (0, (int) ceilf (x + box.x2 * sx) - left),
+    MAX (0, (int) ceilf (y + box.y2 * sy) - top)};
+}
+
+static void
+prepare_backdrops (ClutterStage *stage,
+                   ClutterStageView *view,
+                   ClutterFrame *frame,
+                   gpointer user_data)
+{
+  g_autoptr (MtkRegion) damage = clutter_stage_view_copy_redraw_clip (view);
+  g_autoptr (GHashTable) affected = g_hash_table_new (g_direct_hash, g_direct_equal);
+  MtkRectangle layout;
+  gboolean changed;
+  clutter_stage_view_get_layout (view, &layout);
+
+  /* Reach a fixed point when translucent surfaces overlap: refreshing a lower
+   * backdrop can change the pixels sampled by another backdrop above it. */
+  do
+    {
+      changed = FALSE;
+      for (GSList *l = backdrop_effects; l; l = l->next)
+        {
+          ShellBlurEffect *self = l->data;
+          MtkRectangle box, clipped;
+          if (!self->actor || self->mode == SHELL_BLUR_MODE_ACTOR ||
+              self->radius == 0 || !clutter_actor_is_mapped (self->actor) ||
+              !clutter_actor_meta_get_enabled (CLUTTER_ACTOR_META (self)))
+            continue;
+          box = get_stage_blur_box (self);
+          if (!mtk_rectangle_intersect (&box, &layout, &clipped))
+            continue;
+          if (self->last_view != view || !mtk_rectangle_equal (&box, &self->last_source))
+            self->background_dirty = TRUE;
+          if (g_hash_table_contains (affected, self))
+            continue;
+          if (self->background_dirty ||
+              mtk_region_contains_rectangle (damage, &clipped) != MTK_REGION_OVERLAP_OUT)
+            {
+              self->background_dirty = TRUE;
+              g_hash_table_add (affected, self);
+              mtk_region_union_rectangle (damage, &clipped);
+              clutter_stage_view_add_redraw_clip (view, &clipped);
+              changed = TRUE;
+            }
+        }
+    }
+  while (changed);
+}
+
+static void
+track_backdrop (ShellBlurEffect *self, gboolean enabled)
+{
+  ClutterStage *stage = shell_global_get_stage (shell_global_get ());
+  backdrop_effects = g_slist_remove (backdrop_effects, self);
+  if (enabled)
+    backdrop_effects = g_slist_prepend (backdrop_effects, self);
+  if (backdrop_effects && !backdrop_handler)
+    backdrop_handler = g_signal_connect (stage, "before-paint", G_CALLBACK (prepare_backdrops), NULL);
+  else if (!backdrop_effects && backdrop_handler)
+    {
+      g_signal_handler_disconnect (stage, backdrop_handler);
+      backdrop_handler = 0;
+    }
+}
 
