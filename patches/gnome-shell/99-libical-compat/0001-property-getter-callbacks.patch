From 7e19b8d1414eda97c877e175aab1769f04066dec Mon Sep 17 00:00:00 2001
From: Gnoblin <gnoblin@localhost>
Date: Sat, 19 Sep 2026 21:56:36 +0100
Subject: [PATCH] calendar: accept both libical property getter signatures

---
 .../gnome-shell-calendar-server.c             | 33 ++++++++++++++++++++++++++++---
 1 file changed, 30 insertions(+), 3 deletions(-)

diff --git a/src/calendar-server/gnome-shell-calendar-server.c b/src/calendar-server/gnome-shell-calendar-server.c
index 8a09b2f..0c77877 100644
--- a/src/calendar-server/gnome-shell-calendar-server.c
+++ b/src/calendar-server/gnome-shell-calendar-server.c
@@ -117,6 +117,33 @@ typedef ICalTime * (* GetICalPropFunc) (const ICalProperty *prop);
 typedef ICalTime * (* GetICalPropFunc) (ICalProperty *prop);
 #endif
 
+/* Keep the callback signature stable across libical's const API change. */
+#if ICAL_CHECK_VERSION(4, 0, 0)
+static ICalTime *
+get_dtstart (const ICalProperty *prop)
+{
+  return i_cal_property_get_dtstart (prop);
+}
+
+static ICalTime *
+get_dtend (const ICalProperty *prop)
+{
+  return i_cal_property_get_dtend (prop);
+}
+#else
+static ICalTime *
+get_dtstart (ICalProperty *prop)
+{
+  return i_cal_property_get_dtstart (prop);
+}
+
+static ICalTime *
+get_dtend (ICalProperty *prop)
+{
+  return i_cal_property_get_dtend (prop);
+}
+#endif
+
 static gboolean
 get_time_from_property (ECalClient            *cal,
                         ICalComponent         *icomp,
@@ -174,7 +201,7 @@ get_ical_start_time (ECalClient    *cal,
   if (!get_time_from_property (cal,
                                icomp,
                                I_CAL_DTSTART_PROPERTY,
-                               i_cal_property_get_dtstart,
+                               get_dtstart,
                                default_zone,
                                &itt,
                                &timezone))
@@ -201,7 +228,7 @@ get_ical_end_time (ECalClient    *cal,
   if (!get_time_from_property (cal,
                                icomp,
                                I_CAL_DTEND_PROPERTY,
-                               i_cal_property_get_dtend,
+                               get_dtend,
                                default_zone,
                                &itt,
                                &timezone))
@@ -209,7 +236,7 @@ get_ical_end_time (ECalClient    *cal,
       if (!get_time_from_property (cal,
                                    icomp,
                                    I_CAL_DTSTART_PROPERTY,
-                                   i_cal_property_get_dtstart,
+                                   get_dtstart,
                                    default_zone,
                                    &itt,
                                    &timezone))
-- 
