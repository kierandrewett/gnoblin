From 184ebf52bfd102e0729134f01494e52b11b56146 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sat, 18 Jul 2026 23:16:30 +0100
Subject: [PATCH] backgroundMenu: add Open Terminal entry in Gnoblin mode

Add an Open Terminal action at the top of the desktop background menu,
shown only in the Gnoblin session mode so stock GNOME keeps its upstream
menu. The default terminal from
org.gnome.desktop.default-applications.terminal is honoured first (the
same mechanism the run dialog uses); if the configured exec does not
resolve in PATH the launcher falls back to a fixed candidate list of
desktop IDs (Ptyxis, Console, GNOME Terminal, foot, kitty, Alacritty),
and a notification is raised when no terminal exists at all.
---
 js/ui/backgroundMenu.js | 47 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/js/ui/backgroundMenu.js b/js/ui/backgroundMenu.js
index 26fd41e..37fd75c 100644
--- a/js/ui/backgroundMenu.js
+++ b/js/ui/backgroundMenu.js
@@ -1,15 +1,62 @@
 import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
 import St from 'gi://St';
 
 import * as BoxPointer from './boxpointer.js';
 import * as PopupMenu from './popupMenu.js';
+import * as Util from '../misc/util.js';
 
 import * as Main from './main.js';
 
+const TERMINAL_SCHEMA = 'org.gnome.desktop.default-applications.terminal';
+const TERMINAL_EXEC_KEY = 'exec';
+
+// Fallback when the configured default terminal does not resolve in PATH
+// (e.g. the schema default points at an uninstalled xdg-terminal-exec).
+const FALLBACK_TERMINAL_APP_IDS = [
+    'org.gnome.Ptyxis.desktop',
+    'org.gnome.Console.desktop',
+    'org.gnome.Terminal.desktop',
+    'foot.desktop',
+    'kitty.desktop',
+    'Alacritty.desktop',
+];
+
+function openTerminal() {
+    const settings = new Gio.Settings({schema_id: TERMINAL_SCHEMA});
+    const exec = settings.get_string(TERMINAL_EXEC_KEY);
+    if (exec && GLib.find_program_in_path(exec.split(' ')[0])) {
+        Util.trySpawnCommandLine(exec);
+        return;
+    }
+
+    for (const id of FALLBACK_TERMINAL_APP_IDS) {
+        const app = Gio.DesktopAppInfo.new(id);
+        if (app) {
+            app.launch([], global.create_app_launch_context(0, -1));
+            return;
+        }
+    }
+
+    Main.notifyError(_('No terminal emulator found'));
+}
+
 export class BackgroundMenu extends PopupMenu.PopupMenu {
     constructor(layoutManager) {
         super(layoutManager.dummyCursor, 0, St.Side.TOP);
 
+        if (global.session_mode === 'gnoblin') {
+            this.addAction(_('Open Terminal'), () => {
+                try {
+                    openTerminal();
+                } catch (e) {
+                    logError(e, 'Failed to launch terminal');
+                }
+            });
+            this.addMenuItem(new PopupMenu.PopupSeparatorMenuItem());
+        }
+
         this.addSettingsAction(_('Change Background…'), 'gnome-background-panel.desktop');
         this.addMenuItem(new PopupMenu.PopupSeparatorMenuItem());
         this.addSettingsAction(_('Display Settings'), 'gnome-display-panel.desktop');
