From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sun, 27 Sep 2026 07:28:02 +0100
Subject: [PATCH] shell: make removable-media hotplug sniffer optional

---
diff --git a/meson.options b/meson.options
index d07d41c11..e1a61b3ea 100644
--- a/meson.options
+++ b/meson.options
@@ -16,6 +16,12 @@ option('calendar_server',
   description: 'Build calendar event integration'
 )
 
+option('hotplug_sniffer',
+  type: 'boolean',
+  value: true,
+  description: 'Build removable-media autorun content sniffer'
+)
+
 option('gtk_doc',
   type: 'boolean',
   value: false,
diff --git a/src/meson.build b/src/meson.build
index 10ab3a883..6ece774b0 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -13,7 +13,9 @@ introspection_common = {
 if get_option('calendar_server')
   subdir('calendar-server')
 endif
-subdir('hotplug-sniffer')
+if get_option('hotplug_sniffer')
+  subdir('hotplug-sniffer')
+endif
 subdir('st')
 if have_xwayland
   subdir('tray')
