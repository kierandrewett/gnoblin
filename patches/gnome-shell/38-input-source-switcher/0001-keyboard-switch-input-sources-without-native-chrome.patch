From 2f86824ccd4a4e31feb672e22ac4f7f7c00f6630 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 24 Aug 2026 14:07:00 +0100
Subject: [PATCH] keyboard: let external chrome own the input-source switcher

Gnoblin has no visible Shell chrome. Its default feature setting disables the
native input-source popup, leaving external chrome free to provide its own
selector. Switching still uses GNOME Shell's InputSourceManager. Re-enabling
the feature restores the upstream popup without affecting stock sessions.
---
 js/ui/status/keyboard.js | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/js/ui/status/keyboard.js b/js/ui/status/keyboard.js
index d5c4167..2dcc634 100644
--- a/js/ui/status/keyboard.js
+++ b/js/ui/status/keyboard.js
@@ -440,6 +440,13 @@ export class InputSourceManager extends Signals.EventEmitter {
             return;
         }
 
+        // External Gnoblin chrome owns the presentation. Keep the source
+        // activation in this manager, which preserves layouts and IBus state.
+        if (externalInputSourceSwitcher()) {
+            this._modifiersSwitcher();
+            return;
+        }
+
         this._switcherPopup = new InputSourcePopup(
             this._mruSources, this._keybindingAction, this._keybindingActionBackward);
         this._switcherPopup.connect('destroy', () => {
@@ -1183,3 +1190,19 @@ class InputSourceIndicator extends PanelMenu.Button {
         app?.activate();
     }
 });
+// This schema is installed by Gnoblin's settings patch. Keep lookup lazy so
+// stock GNOME modes continue to have no dependency on it.
+let gnoblinSettings = null;
+
+function externalInputSourceSwitcher() {
+    if (Main.sessionMode.currentMode !== 'gnoblin')
+        return false;
+
+    try {
+        gnoblinSettings ??= new Gio.Settings({schema_id: 'org.gnoblin.shell'});
+        return gnoblinSettings.get_strv('disabled-features').includes('input-source-switcher');
+    } catch (error) {
+        console.warn(`keyboard: cannot read Gnoblin input-source setting: ${error.message}`);
+        return false;
+    }
+}
