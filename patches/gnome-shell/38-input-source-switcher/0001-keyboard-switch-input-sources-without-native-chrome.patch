From 6547d0a7b11c4824386ec236372fb5e2be98be8f Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 24 Aug 2026 14:07:00 +0100
Subject: [PATCH] keyboard: switch input sources without native chrome

Gnoblin has no visible Shell chrome. Switch the selected input source directly
in Gnoblin mode and keep the upstream popup flow in other session modes.
---
 js/ui/status/keyboard.js | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/js/ui/status/keyboard.js b/js/ui/status/keyboard.js
index 3ddc675..33087d2 100644
--- a/js/ui/status/keyboard.js
+++ b/js/ui/status/keyboard.js
@@ -434,1 +434,8 @@ export class InputSourceManager extends Signals.EventEmitter {
+        // Gnoblin owns no visible Shell chrome. Switch immediately instead of
+        // opening the native input-source popup.
+        if (Main.sessionMode.currentMode === 'gnoblin') {
+            this._modifiersSwitcher();
+            return;
+        }
+
         // HACK: Fall back on simple input source switching since we
