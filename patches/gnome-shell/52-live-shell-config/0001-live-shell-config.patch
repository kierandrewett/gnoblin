From: kierandrewett <kieran@drewett.dev>
Subject: [PATCH] shell: use live Gnoblin window behaviour settings

diff --git a/js/ui/windowManager.js b/js/ui/windowManager.js
--- a/js/ui/windowManager.js
+++ b/js/ui/windowManager.js
@@ -9,6 +9,7 @@
 import St from 'gi://St';
 
 import * as AltTab from './altTab.js';
+import * as GnoblinConfig from './components/gnoblinConfig.js';
 import * as AppFavorites from './appFavorites.js';
 import * as Dialog from './dialog.js';
 import * as WorkspaceSwitcherPopup from './workspaceSwitcherPopup.js';
@@ -1134,12 +1135,16 @@
     }
 
     _minimizeWindow(shellwm, actor) {
+        const animation = global.session_mode === 'gnoblin'
+            ? GnoblinConfig.settings['minimize-animation'] : 'gnome';
+        const duration = global.session_mode === 'gnoblin'
+            ? GnoblinConfig.settings['minimize-duration'] : MINIMIZE_WINDOW_ANIMATION_TIME;
         const types = [
             Meta.WindowType.NORMAL,
             Meta.WindowType.MODAL_DIALOG,
             Meta.WindowType.DIALOG,
         ];
-        if (!this._shouldAnimateActor(actor, types)) {
+        if (!this._shouldAnimateActor(actor, types) || animation === 'none') {
             shellwm.completed_minimize(actor);
             return;
         }
@@ -1148,16 +1153,20 @@
 
         this._minimizing.add(actor);
 
-        if (actor.meta_window.is_monitor_sized()) {
+        if (animation === 'fade' ||
+            (animation === 'gnome' && actor.meta_window.is_monitor_sized())) {
             actor.ease({
                 opacity: 0,
-                duration: MINIMIZE_WINDOW_ANIMATION_TIME,
+                duration,
                 mode: MINIMIZE_WINDOW_ANIMATION_MODE,
                 onStopped: () => this._minimizeWindowDone(shellwm, actor),
             });
         } else {
             let xDest, yDest, xScale, yScale;
-            let [success, geom] = actor.meta_window.get_icon_geometry();
+            let [success, geom] = animation === 'zoom'
+                ? GnoblinConfig.minimizeTarget(actor.meta_window,
+                    Main.layoutManager.monitors[actor.meta_window.get_monitor()])
+                : actor.meta_window.get_icon_geometry();
             if (success) {
                 xDest = geom.x;
                 yDest = geom.y;
@@ -1183,7 +1192,7 @@
                 scale_y: yScale,
                 x: xDest,
                 y: yDest,
-                duration: MINIMIZE_WINDOW_ANIMATION_TIME,
+                duration,
                 mode: MINIMIZE_WINDOW_ANIMATION_MODE,
                 onStopped: () => this._minimizeWindowDone(shellwm, actor),
             });
@@ -1202,29 +1211,38 @@
     }
 
     _unminimizeWindow(shellwm, actor) {
+        const animation = global.session_mode === 'gnoblin'
+            ? GnoblinConfig.settings['minimize-animation'] : 'gnome';
+        const duration = global.session_mode === 'gnoblin'
+            ? GnoblinConfig.settings['minimize-duration'] : MINIMIZE_WINDOW_ANIMATION_TIME;
         const types = [
             Meta.WindowType.NORMAL,
             Meta.WindowType.MODAL_DIALOG,
             Meta.WindowType.DIALOG,
         ];
-        if (!this._shouldAnimateActor(actor, types)) {
+        if (!this._shouldAnimateActor(actor, types) || animation === 'none') {
             shellwm.completed_unminimize(actor);
             return;
         }
 
         this._unminimizing.add(actor);
 
-        if (actor.meta_window.is_monitor_sized()) {
+        if (animation === 'fade' ||
+            (animation === 'gnome' && actor.meta_window.is_monitor_sized())) {
+            actor.show();
             actor.opacity = 0;
             actor.set_scale(1.0, 1.0);
             actor.ease({
                 opacity: 255,
-                duration: MINIMIZE_WINDOW_ANIMATION_TIME,
+                duration,
                 mode: MINIMIZE_WINDOW_ANIMATION_MODE,
                 onStopped: () => this._unminimizeWindowDone(shellwm, actor),
             });
         } else {
-            let [success, geom] = actor.meta_window.get_icon_geometry();
+            let [success, geom] = animation === 'zoom'
+                ? GnoblinConfig.minimizeTarget(actor.meta_window,
+                    Main.layoutManager.monitors[actor.meta_window.get_monitor()])
+                : actor.meta_window.get_icon_geometry();
             if (success) {
                 actor.set_position(geom.x, geom.y);
                 actor.set_scale(
@@ -1252,7 +1270,7 @@
                 scale_y: 1,
                 x: xDest,
                 y: yDest,
-                duration: MINIMIZE_WINDOW_ANIMATION_TIME,
+                duration,
                 mode: MINIMIZE_WINDOW_ANIMATION_MODE,
                 onStopped: () => this._unminimizeWindowDone(shellwm, actor),
             });
@@ -1648,6 +1666,11 @@
     }
 
     _startSwitcher(display, window, event, binding) {
+        if (global.session_mode === 'gnoblin' &&
+            !GnoblinConfig.settings['window-switcher'] &&
+            binding.get_name() !== 'switch-monitor')
+            return;
+
         let constructor = null;
         switch (binding.get_name()) {
         case 'switch-applications':
