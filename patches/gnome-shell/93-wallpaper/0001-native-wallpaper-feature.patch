From 7a527924a91f384514d857f87d6495d8d2d7387f Mon Sep 17 00:00:00 2001
From: Gnoblin contributors <gnoblin@localhost>
Date: Fri, 25 Sep 2026 02:49:39 +0100
Subject: [PATCH] gnoblin: add a toggle for native wallpaper rendering

---
 js/ui/layout.js             | 11 +++++++++++
 js/ui/workspaceAnimation.js |  6 +++++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/js/ui/layout.js b/js/ui/layout.js
index 9871e0635..a8c1f04c6 100644
--- a/js/ui/layout.js
+++ b/js/ui/layout.js
@@ -205,6 +205,7 @@ export const LayoutManager = GObject.registerClass({
         this._trackedActors = [];
         this._topActors = [];
         this._startingUp = true;
+        this._gnoblinWallpaperEnabled = true;
 
         // Set up stage hierarchy to group all UI actors under one container.
         this.uiGroup = new UiActor({name: 'uiGroup'});
@@ -532,6 +533,12 @@ export const LayoutManager = GObject.registerClass({
         return promise;
     }
 
+    setGnoblinWallpaperEnabled(enabled) {
+        this._gnoblinWallpaperEnabled = Boolean(enabled);
+        if (Main.sessionMode.currentMode === 'gnoblin')
+            this._updateBackgrounds().catch(logError);
+    }
+
     async _updateBackgrounds() {
         this._bgLoadCancellable?.cancel();
         this._bgLoadCancellable = null;
@@ -541,6 +548,10 @@ export const LayoutManager = GObject.registerClass({
 
         this._bgManagers = [];
 
+        // Gnoblin uses GNOME's background renderer as a built-in feature.
+        if (Main.sessionMode.currentMode === 'gnoblin' && !this._gnoblinWallpaperEnabled)
+            return;
+
         if (Main.sessionMode.isGreeter)
             return Promise.resolve();
 
diff --git a/js/ui/workspaceAnimation.js b/js/ui/workspaceAnimation.js
index fcfda8a57..a3b86f6bc 100644
--- a/js/ui/workspaceAnimation.js
+++ b/js/ui/workspaceAnimation.js
@@ -174,6 +174,10 @@ class WorkspaceBackground extends BaseWorkspaceGroup {
     }
 
     _createBackground() {
+        if (Main.sessionMode.currentMode === 'gnoblin' &&
+            !Main.layoutManager._gnoblinWallpaperEnabled)
+            return;
+
         const background = new Meta.BackgroundGroup();
         this.add_child(background);
 
@@ -187,7 +191,7 @@ class WorkspaceBackground extends BaseWorkspaceGroup {
     _onDestroy() {
         super._onDestroy();
 
-        this._bgManager.destroy();
+        this._bgManager?.destroy();
     }
 });
 
-- 
