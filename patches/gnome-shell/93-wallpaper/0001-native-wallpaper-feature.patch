From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gnoblin contributors <gnoblin@localhost>
Date: Thu, 24 Sep 2026 12:00:00 +0000
Subject: [PATCH] gnoblin: add a toggle for native wallpaper rendering

Keep GNOME's native per-monitor wallpaper renderer enabled in Gnoblin by
default, and allow Gnoblin to toggle those background actors at runtime.

---
diff --git a/js/ui/layout.js b/js/ui/layout.js
index 7a9e14b40..41407d5d7 100644
--- a/js/ui/layout.js
+++ b/js/ui/layout.js
@@ -218,1 +218,2 @@ export const LayoutManager = GObject.registerClass({
         this._pendingLoadBackground = false;
+        this._gnoblinWallpaperEnabled = true;
@@ -532,0 +533,6 @@ export const LayoutManager = GObject.registerClass({
+    setGnoblinWallpaperEnabled(enabled) {
+        this._gnoblinWallpaperEnabled = Boolean(enabled);
+        if (Main.sessionMode.currentMode === 'gnoblin')
+            this._updateBackgrounds().catch(logError);
+    }
+
@@ -536,1 +547,5 @@ export const LayoutManager = GObject.registerClass({
         this._bgManagers = [];
+        // Gnoblin uses GNOME's background renderer as a built-in feature.
+        if (Main.sessionMode.currentMode === 'gnoblin' && !this._gnoblinWallpaperEnabled)
+            return Promise.resolve();
+
diff --git a/js/ui/workspaceAnimation.js b/js/ui/workspaceAnimation.js
index 06c599728..712b30061 100644
--- a/js/ui/workspaceAnimation.js
+++ b/js/ui/workspaceAnimation.js
@@ -162,1 +162,5 @@ class WorkspaceBackground extends BaseWorkspaceGroup {
     _createBackground() {
+        if (Main.sessionMode.currentMode === 'gnoblin' &&
+            !Main.layoutManager._gnoblinWallpaperEnabled)
+            return;
+
@@ -175,1 +179,1 @@ class WorkspaceBackground extends BaseWorkspaceGroup {
-        this._bgManager.destroy();
+        this._bgManager?.destroy();
-- 
2.45.0
