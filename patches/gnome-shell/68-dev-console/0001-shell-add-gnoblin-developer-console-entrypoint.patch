From c3ac21d34c4dbeae60e91d3d83787d9ba82a3ef2 Mon Sep 17 00:00:00 2001
From: Gnoblin contributors <gnoblin@example.invalid>
Date: Sat, 12 Sep 2026 05:30:00 +0100
Subject: [PATCH] shell: add Gnoblin developer console entrypoint

Use the existing panel-run-dialog keybinding as the Gnoblin developer-console
entrypoint while keeping the stock Run dialog and Looking Glass unchanged.
Create the console lazily, close it on a mode or lock transition, and expose
its module through the Shell JavaScript resource bundle.
---
 data/theme/gnome-shell-sass/_widgets.scss |  1 +
 js/js-resources.gresource.xml             |  3 ++
 js/ui/main.js                             | 35 ++++++++++++++++++++++-
 3 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/data/theme/gnome-shell-sass/_widgets.scss b/data/theme/gnome-shell-sass/_widgets.scss
index 1e3fefa..b4fce35 100644
--- a/data/theme/gnome-shell-sass/_widgets.scss
+++ b/data/theme/gnome-shell-sass/_widgets.scss
@@ -46,5 +46,6 @@
 @import 'widgets/keyboard';
 @import 'widgets/looking-glass';
 @import 'widgets/qr-code';
+@import 'widgets/dev-console';
 // Lock / login screen
 @import 'widgets/login-lock';
diff --git a/js/js-resources.gresource.xml b/js/js-resources.gresource.xml
index a360b91..a56bc84 100644
--- a/js/js-resources.gresource.xml
+++ b/js/js-resources.gresource.xml
@@ -153,7 +153,10 @@
     <file>ui/components/gnoblinCornerGeometry.js</file>
     <file>ui/components/gnoblinCorners.js</file>
     <file>ui/components/gnoblinControl.js</file>
     <file>ui/components/gnoblinMutterEvents.js</file>
+    <file>ui/components/gnoblinConsole.js</file>
+    <file>ui/components/gnoblinConsoleEvaluator.js</file>
+    <file>ui/components/gnoblinConsoleIntrospection.js</file>
     <file>ui/components/keyring.js</file>
     <file>ui/components/networkAgent.js</file>
     <file>ui/components/polkitAgent.js</file>
diff --git a/js/ui/main.js b/js/ui/main.js
index c44f75d..b86a6f0 100644
--- a/js/ui/main.js
+++ b/js/ui/main.js
@@ -30,6 +30,7 @@ import * as WelcomeDialog from './welcomeDialog.js';
 import * as Layout from './layout.js';
 import * as LoginManager from '../misc/loginManager.js';
 import * as LookingGlass from './lookingGlass.js';
+import * as DevConsole from './components/gnoblinConsole.js';
 import * as NotificationDaemon from './notificationDaemon.js';
 import * as WindowAttentionHandler from './windowAttentionHandler.js';
 import * as Screenshot from './screenshot.js';
@@ -61,6 +62,7 @@ export let panel = null;
 export let overview = null;
 export let runDialog = null;
 export let lookingGlass = null;
+export let devConsole = null;
 export let welcomeDialog = null;
 export let wm = null;
 export let messageTray = null;
@@ -124,7 +126,7 @@ function _sessionUpdated() {
 
     wm.setCustomKeybindingHandler('panel-run-dialog',
         Shell.ActionMode.NORMAL | Shell.ActionMode.OVERVIEW,
-        sessionMode.hasRunDialog ? openRunDialog : null);
+        _devConsoleAllowed() ? openDevConsole : (sessionMode.hasRunDialog ? openRunDialog : null));
 
     if (!sessionMode.hasRunDialog) {
         if (runDialog)
@@ -134,6 +136,8 @@ function _sessionUpdated() {
         if (welcomeDialog)
             welcomeDialog.close();
     }
+    if (!_devConsoleAllowed() && devConsole)
+        devConsole.close(true);
 
     const remoteAccessController = global.backend.get_remote_access_controller();
     if (remoteAccessController && !global.backend.is_headless()) {
@@ -811,16 +815,45 @@ export function popModal(grab) {
  * @returns {LookingGlass.LookingGlass}
  */
 export function createLookingGlass() {
+    if (global.session_mode === 'gnoblin')
+        return createDevConsole();
+
     if (lookingGlass == null)
         lookingGlass = new LookingGlass.LookingGlass();
 
     return lookingGlass;
 }
 
+function _devConsoleAllowed() {
+    return global.session_mode === 'gnoblin' && sessionMode?.isPrimary && !sessionMode?.isLocked;
+}
+
+/**
+ * Creates the Gnoblin developer console.
+ *
+ * The console is only available in the primary, unlocked Gnoblin session.
+ */
+export function createDevConsole() {
+    if (devConsole == null)
+        devConsole = new DevConsole.DeveloperConsole();
+
+    return devConsole;
+}
+
+export function openDevConsole() {
+    if (!_devConsoleAllowed())
+        return false;
+
+    return createDevConsole().open();
+}
+
 /**
  * Opens the run dialog
  */
 export function openRunDialog() {
+    if (global.session_mode === 'gnoblin')
+        return openDevConsole();
+
     if (!sessionMode.hasRunDialog)
         return;
 
-- 
2.55.0
