From: Kieran <kieran@drewett.dev>
Subject: [PATCH] shell: share layer entry and destruction animations

diff --git a/js/ui/windowManager.js b/js/ui/windowManager.js
--- a/js/ui/windowManager.js
+++ b/js/ui/windowManager.js
@@ -10,6 +10,7 @@
 
 import * as AltTab from './altTab.js';
 import * as GnoblinConfig from './components/gnoblinConfig.js';
+import * as GnoblinLayerAnimation from './components/gnoblinLayerAnimation.js';
 import * as AppFavorites from './appFavorites.js';
 import * as Dialog from './dialog.js';
 import * as WorkspaceSwitcherPopup from './workspaceSwitcherPopup.js';
@@ -1483,42 +1484,8 @@
         if (actor.meta_window.is_attached_dialog())
             this._checkDimming(actor.get_meta_window().get_transient_for());
 
-        const anchor = global.session_mode === 'gnoblin'
-            ? Meta.gnoblin_layer_anchor(actor.meta_window) : -1;
-        if (anchor >= 0) {
-            const animation = GnoblinConfig.windowEffects(
-                GnoblinConfig.windowProperties(actor.meta_window)).animation;
-            const duration = GnoblinConfig.settings['layer-duration'];
-            if (animation === 'none' || duration === 0 ||
-                !this._shouldAnimateActor(actor, [Meta.WindowType.DOCK, Meta.WindowType.DESKTOP])) {
-                shellwm.completed_map(actor);
-                return;
-            }
-            const monitor = Main.layoutManager.monitors[actor.meta_window.get_monitor()];
-            const offset = animation === 'slide'
-                ? GnoblinConfig.layerOffset(anchor, actor.meta_window.get_frame_rect(), monitor)
-                : [0, 0];
-            const modes = {
-                'ease-out-cubic': Clutter.AnimationMode.EASE_OUT_CUBIC,
-                'ease-out-quad': Clutter.AnimationMode.EASE_OUT_QUAD,
-                'ease-in-out-cubic': Clutter.AnimationMode.EASE_IN_OUT_CUBIC,
-                linear: Clutter.AnimationMode.LINEAR,
-            };
-            actor.translation_x = offset[0];
-            actor.translation_y = offset[1];
-            actor.opacity = 0;
-            actor.show();
-            this._mapping.add(actor);
-            actor.ease({
-                translation_x: 0,
-                translation_y: 0,
-                opacity: 255,
-                duration,
-                mode: modes[GnoblinConfig.settings['layer-easing']],
-                onStopped: () => this._mapWindowDone(shellwm, actor),
-            });
-            return;
-        }
+        if (GnoblinLayerAnimation.animate(this, shellwm, actor, true))
+            return;
 
         const types = [
             Meta.WindowType.NORMAL,
@@ -1591,6 +1558,9 @@
 
         if (window.is_attached_dialog())
             this._checkDimming(window.get_transient_for());
+
+        if (GnoblinLayerAnimation.animate(this, shellwm, actor, false))
+            return;
 
         const types = [
             Meta.WindowType.NORMAL,
diff --git a/js/js-resources.gresource.xml b/js/js-resources.gresource.xml
--- a/js/js-resources.gresource.xml
+++ b/js/js-resources.gresource.xml
@@ -135,6 +135,7 @@
     <file>ui/components/automountManager.js</file>
     <file>ui/components/autorunManager.js</file>
     <file>ui/components/gnoblinConfig.js</file>
+    <file>ui/components/gnoblinLayerAnimation.js</file>
     <file>ui/components/gnoblinRules.js</file>
     <file>ui/components/gnoblinControl.js</file>
     <file>ui/components/keyring.js</file>
