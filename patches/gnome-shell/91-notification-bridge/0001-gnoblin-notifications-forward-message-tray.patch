From fa7e21a5a8507dcf92d1764dc4412849fe303eee Mon Sep 17 00:00:00 2001
From: Gnoblin <gnoblin@localhost>
Date: Sat, 19 Sep 2026 21:56:35 +0100
Subject: [PATCH] gnoblin: bundle the MessageTray notification bridge

The bridge is enabled by the gnoblin session mode and forwards GNOME-created
MessageTray notifications to the standard notification API consumed by the
external shell.
Apply after the frame, recovery, and console resource patches.
---
 js/js-resources.gresource.xml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/js/js-resources.gresource.xml b/js/js-resources.gresource.xml
index da691f3..276bc2b 100644
--- a/js/js-resources.gresource.xml
+++ b/js/js-resources.gresource.xml
@@ -156,6 +156,7 @@
     <file>ui/components/gnoblinFrames.js</file>
     <file>ui/components/gnoblinFramePolicy.js</file>
     <file>ui/components/gnoblinControl.js</file>
     <file>ui/components/gnoblinSessionLock.js</file>
+    <file>ui/components/gnoblinNotificationBridge.js</file>
     <file>ui/components/gnoblinRecovery.js</file>
     <file>ui/components/gnoblinConsole.js</file>
     <file>ui/components/gnoblinConsoleEvaluator.js</file>
-- 
