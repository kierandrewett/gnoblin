+            const name = (typeof windowRule === 'string' ? windowRule : windowRule?.name) ??
+                eventSelection ?? registered?.name ??
+                (typeof minimizeSetting === 'string' ? minimizeSetting : undefined) ?? 'zoom';
+            const monitor = Main.layoutManager.monitors[actor.meta_window.get_monitor()];
+            const targetGeom = name === 'zoom'
+                ? GnoblinConfig.minimizeTarget(actor.meta_window, monitor)
+                : actor.meta_window.get_icon_geometry();
+            this._unminimizing.add(actor);
+            actor.show();
+            this._runGnoblinAnimation(actor, event, name, {
+                actor,
+                window: actor.meta_window,
+                monitor,
+                rtl: Clutter.get_default_text_direction() === Clutter.TextDirection.RTL,
+                targetGeom,
+            }, () => this._unminimizeWindowDone(shellwm, actor),
+            ['zoom', 'fade', 'gnome'].includes(name)
+                ? { duration: GnoblinConfig.settings['minimize-duration'] }
+                : {});
+            return;
+        }
         const animation = global.session_mode === 'gnoblin'
             ? GnoblinConfig.settings['minimize-animation'] : 'gnome';
         const duration = global.session_mode === 'gnoblin'
@@ -1313,6 +1559,14 @@
