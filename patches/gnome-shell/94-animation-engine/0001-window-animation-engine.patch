+    _cancelGnoblinAnimation(actor) {
+        const active = this._gnoblinAnimationControllers.get(actor);
+        if (active && !active.controller.finished)
+            active.controller.cancel();
+    }
+
+    _runGnoblinAnimation(actor, event, name, context, onComplete, options = {}) {
+        const spec = this._resolveGnoblinAnimation(event, name, context, options);
+        const token = {};
+        const finish = (completed) => {
+            if (this._gnoblinAnimationControllers.get(actor)?.token === token)
+                this._gnoblinAnimationControllers.delete(actor);
+            onComplete(completed);
+        };
+        if (spec.duration <= 0 || !St.Settings.get().enable_animations) {
+            onComplete(true);
+            return null;
+        }
+        const controller = runGnoblinAnimation(actor, spec, {
+            paused: options.paused,
+            onComplete: finish,
+        });
+        this._gnoblinAnimationControllers.set(actor, { token, controller, spec });
+        return controller;
+    }
+
+    _resolveGnoblinAnimation(event, name, context, options = {}) {
+        const registered = GnoblinConfig.getAnimationForEvent?.(event);
+        const windowRule = context.window
+            ? GnoblinConfig.windowAnimation?.(GnoblinConfig.windowProperties(context.window), event)
+            : null;
+        const ruleName = typeof windowRule === 'string' ? windowRule : windowRule?.name;
+        const selectedName = ruleName ?? name ?? registered?.name ?? `gnome-${event}`;
+        const custom = (typeof windowRule === 'object' ? windowRule : null) ??
+            GnoblinConfig.getAnimation?.(selectedName, event) ??
+            (selectedName === registered?.name ? registered : null);
+        const spec = resolveGnoblinAnimation(selectedName, event, context, custom);
+        if (options.from || custom?.from) spec.from = { ...spec.from, ...options.from, ...custom?.from };
+        if (options.to || custom?.to) spec.to = { ...spec.to, ...options.to, ...custom?.to };
+        if (custom?.duration !== undefined) spec.duration = custom.duration;
+        if (options.duration !== undefined && custom?.duration === undefined && selectedName !== 'none')
+            spec.duration = options.duration;
+        if (custom?.ease !== undefined) spec.ease = custom.ease;
+        return spec;
+    }
+
+    _runGnoblinValues(actor, spec, onFrame, onComplete) {
+        const token = {};
+        const finish = (completed) => {
+            if (this._gnoblinAnimationControllers.get(actor)?.token === token)
+                this._gnoblinAnimationControllers.delete(actor);
+            onComplete?.(completed);
+        };
+        if (spec.duration <= 0 || !St.Settings.get().enable_animations) {
+            onFrame?.(sampleGnoblinAnimation(spec, 1), 1);
+            finish(true);
+            return null;
+        }
+        const controller = runGnoblinValues(spec, {
+            actor,
+            onFrame,
+            onComplete: finish,
+        });
+        this._gnoblinAnimationControllers.set(actor, { token, controller, spec });
+        return controller;
+    }
