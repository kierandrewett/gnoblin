     _minimizeWindow(shellwm, actor) {
+        if (global.session_mode === 'gnoblin') {
+            const types = [Meta.WindowType.NORMAL, Meta.WindowType.MODAL_DIALOG, Meta.WindowType.DIALOG];
+            if (!this._shouldAnimateActor(actor, types)) {
+                shellwm.completed_minimize(actor);
+                return;
+            }
+            const event = 'minimize';
+            const registered = GnoblinConfig.getAnimationForEvent?.(event);
+            const windowRule = GnoblinConfig.windowAnimation?.(
+                GnoblinConfig.windowProperties(actor.meta_window), event);
+            const minimizeSetting = GnoblinConfig.settings['minimize-animation'];
+            const eventSelection = typeof minimizeSetting === 'string' ? undefined :
+                GnoblinConfig.animationSelection?.(minimizeSetting, event);
+            const name = (typeof windowRule === 'string' ? windowRule : windowRule?.name) ??
+                eventSelection ?? registered?.name ??
+                (typeof minimizeSetting === 'string' ? minimizeSetting : undefined) ?? 'zoom';
+            const monitor = Main.layoutManager.monitors[actor.meta_window.get_monitor()];
+            const targetGeom = name === 'zoom'
+                ? GnoblinConfig.minimizeTarget(actor.meta_window, monitor)
+                : actor.meta_window.get_icon_geometry();
+            this._minimizing.add(actor);
+            this._runGnoblinAnimation(actor, event, name, {
+                actor,
+                window: actor.meta_window,
+                monitor,
+                rtl: Clutter.get_default_text_direction() === Clutter.TextDirection.RTL,
+                targetGeom,
+            }, () => this._minimizeWindowDone(shellwm, actor),
+            ['zoom', 'fade', 'gnome'].includes(name)
+                ? { duration: GnoblinConfig.settings['minimize-duration'] }
+                : {});
+            return;
+        }
         const animation = global.session_mode === 'gnoblin'
             ? GnoblinConfig.settings['minimize-animation'] : 'gnome';
         const duration = global.session_mode === 'gnoblin'
@@ -1232,12 +1436,54 @@
             actor.set_scale(1.0, 1.0);
