     _syncEnabled(dimmed) {
         const animating = this.actor.get_transition(`@effects.${this.name}.brightness`) !== null;
 
-        this.enabled = Meta.prefs_get_attach_modal_dialogs() && (animating || dimmed);
+        this.enabled = Meta.prefs_get_attach_modal_dialogs() &&
+            (animating || this._gnoblinAnimating || dimmed);
     }
 
     setDimmed(dimmed, animate) {
+        if (global.session_mode === 'gnoblin') {
+            this._gnoblinDimController?.cancel();
+            const from = this._gnoblinDimProgress ?? (this._gnoblinDimmed ? 1 : 0);
+            const event = dimmed ? 'dialog-dim' : 'dialog-undim';
+            const window = this.actor.meta_window;
+            const properties = window ? GnoblinConfig.windowProperties(window) : null;
+            const rule = properties ? GnoblinConfig.windowAnimation?.(properties, event) : null;
+            const registered = GnoblinConfig.getAnimationForEvent?.(event);
+            const ruleName = typeof rule === 'string' ? rule : rule?.name;
+            const name = ruleName ?? registered?.name ?? `gnome-${event}`;
+            const custom = (typeof rule === 'object' ? rule : null) ??
+                GnoblinConfig.getAnimation?.(name, event) ??
+                (name === registered?.name ? registered : null);
+            const spec = resolveGnoblinAnimation(name, event, { actor: this.actor, window }, custom);
+            spec.from = { progress: from, ...custom?.from };
+            spec.to = { progress: dimmed ? 1 : 0, ...custom?.to };
+            if (custom?.duration !== undefined) spec.duration = custom.duration;
+            if (!animate || !St.Settings.get().enable_animations) spec.duration = 0;
+            if (custom?.ease !== undefined) spec.ease = custom.ease;
+            this._gnoblinDimmed = dimmed;
+            this._gnoblinAnimating = spec.duration > 0 && St.Settings.get().enable_animations;
+            const controller = runGnoblinValues(spec, {
+                actor: this.actor,
+                onFrame: values => {
+                    this._gnoblinDimProgress = values.progress;
+                    const val = 127 * (1 + values.progress * DIM_BRIGHTNESS);
+                    this.brightness = new Cogl.Color({
+                        red: val, green: val, blue: val, alpha: 255,
+                    });
+                },
+                onComplete: () => {
+                    this._gnoblinAnimating = false;
+                    this._syncEnabled(dimmed);
+                },
+            });
+            this._gnoblinDimController = controller;
+            this._syncEnabled(dimmed);
+            return;
+        }
         const val = 127 * (1 + (dimmed ? 1 : 0) * DIM_BRIGHTNESS);
         const color = new Cogl.Color({
             red: val,
