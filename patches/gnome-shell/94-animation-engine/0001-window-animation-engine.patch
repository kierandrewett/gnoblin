+            const windowRule = GnoblinConfig.windowAnimation?.(
+                GnoblinConfig.windowProperties(actor.meta_window), event);
+            const minimizeSetting = GnoblinConfig.settings['minimize-animation'];
+            const eventSelection = typeof minimizeSetting === 'string' ? undefined :
