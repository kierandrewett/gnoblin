From 1e7eb7c987b8cd7f8bea3c668295069c479c4f8d Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Mon, 28 Sep 2026 00:32:43 +0100
Subject: [PATCH] brightness: follow backlight changes made outside the shell

When something other than the shell changes a backlight, such as
brightnessctl or a hotkey the firmware handles, each monitor scale
follows it, but the global scale keeps the value the shell last set.
The brightness keys step the global scale, so the next press starts
from that old value: after the screen was dimmed from full brightness
with brightnessctl, brightness up jumps straight back to 100%.

Bring the global scale and the monitor scale factors along with an
outside change, as a change made in the shell does, and save it. No
OSD is shown for it, as before.
---
 js/misc/brightnessManager.js | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/js/misc/brightnessManager.js b/js/misc/brightnessManager.js
index 5e5c1df6..48bda0bc 100644
--- a/js/misc/brightnessManager.js
+++ b/js/misc/brightnessManager.js
@@ -314,11 +314,13 @@ export const BrightnessManager = GObject.registerClass({
         this._inhibitUpdates = true;
 
         // Handle changed backlights
+        let backlightsChanged = false;
         for (const scale of this._monitorScales.values()) {
             if (scale.syncWithBacklight()) {
                 // disable dimming for all if we have a single system initiated
                 // backlight change
                 this._dimmingEnabled = false;
+                backlightsChanged = true;
             }
         }
 
@@ -362,6 +364,19 @@ export const BrightnessManager = GObject.registerClass({
 
             if (showOSD)
                 this._showOSD(this._monitorScales.values());
+        } else if (backlightsChanged) {
+            // a backlight was changed outside the shell, e.g. by
+            // brightnessctl; the monitor scales followed it, and the global
+            // scale must too, or the next step starts from its old value
+            const max = Math.max(...[...this._monitorScales.values()]
+                .map(s => s.value));
+
+            if (max > 0.01) {
+                for (const scale of this._monitorScales.values())
+                    scale.updateScaleFactor(max);
+            }
+
+            this._globalScale.value = max;
         } else {
             scalesUpdated = false;
         }
