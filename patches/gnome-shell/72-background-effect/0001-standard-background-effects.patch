+/* Draw the complete wl_region, including holes and disjoint rectangles.
+ * Clipping the capture to its bounding box is only a cache optimisation. */
+static void
+add_output_rectangles (ShellBlurEffect *self, ClutterPaintNode *node)
+{
+  float width, height;
+  clutter_actor_get_size (self->actor, &width, &height);
+  if (!self->clip_region || self->mode == SHELL_BLUR_MODE_ACTOR)
+    {
+      ClutterActorBox box = self->mode == SHELL_BLUR_MODE_ACTOR
+        ? (ClutterActorBox) {0, 0, width, height} : self->paint_box;
+      clutter_paint_node_add_rectangle (node, &box);
+      return;
+    }
+  float texture_width = self->paint_box.x2 - self->paint_box.x1;
+  float texture_height = self->paint_box.y2 - self->paint_box.y1;
+  if (texture_width <= 0 || texture_height <= 0)
+    return;
+  int count = mtk_region_num_rectangles (self->clip_region);
+  for (int i = 0; i < count; i++)
+    {
+      MtkRectangle rect = mtk_region_get_rectangle (self->clip_region, i);
+      ClutterActorBox box = {MAX (0, rect.x), MAX (0, rect.y),
+        MIN (width, (double) rect.x + rect.width),
+        MIN (height, (double) rect.y + rect.height)};
+      if (box.x2 <= box.x1 || box.y2 <= box.y1)
+        continue;
+      float x1 = (box.x1 - self->paint_box.x1) / texture_width;
+      float y1 = (box.y1 - self->paint_box.y1) / texture_height;
+      float x2 = (box.x2 - self->paint_box.x1) / texture_width;
+      float y2 = (box.y2 - self->paint_box.y1) / texture_height;
+      const float coordinates[] = {x1, y1, x2, y2, x1, y1, x2, y2};
+      clutter_paint_node_add_multitexture_rectangle (node, &box,
+                                                    coordinates, G_N_ELEMENTS (coordinates));
+    }
+}
