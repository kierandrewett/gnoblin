+/**
+ * shell_blur_effect_set_clip_region:
+ * @self: the blur effect
+ * @region: (nullable): explicit surface-local background region
+ *
+ * An explicit region includes fully transparent pixels. NULL restores inferred
+ * alpha coverage. Region ownership remains with the caller.
+ */
+void
+shell_blur_effect_set_clip_region (ShellBlurEffect *self, MtkRegion *region)
+{
+  if ((!region && !self->clip_region) ||
+      (region && self->clip_region && mtk_region_equal (region, self->clip_region)))
+    return;
+  g_clear_pointer (&self->clip_region, mtk_region_unref);
+  self->clip_region = region ? mtk_region_copy (region) : NULL;
+  if (region)
+    {
+      MtkRectangle bounds = mtk_region_get_extents (region);
+      shell_blur_effect_set_region (self, bounds.x, bounds.y, bounds.width, bounds.height);
+    }
+  else
+    shell_blur_effect_clear_region (self);
+  self->cache_flags = 0;
+  self->background_dirty = TRUE;
+  if (self->actor)
+    clutter_actor_queue_redraw (self->actor);
+}
