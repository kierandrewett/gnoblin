From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sun, 27 Sep 2026 07:28:02 +0100
Subject: [PATCH] gnoblin: inherit host wallpaper defaults

---
diff --git a/js/ui/background.js b/js/ui/background.js
index 4edd2e5fc..96ab074e0 100644
--- a/js/ui/background.js
+++ b/js/ui/background.js
@@ -709,7 +709,7 @@ class BackgroundSource {
         // Allow override the background image setting for performance testing
         this._layoutManager = layoutManager;
         this._overrideImage = GLib.getenv('SHELL_BACKGROUND_IMAGE');
-        this._settings = new Gio.Settings({schema_id: settingsSchema});
+        this._settings = this._createSettings(settingsSchema);
         this._backgrounds = [];
 
         const monitorManager = global.backend.get_monitor_manager();
@@ -720,6 +720,46 @@ class BackgroundSource {
         this._interfaceSettings = new Gio.Settings({schema_id: INTERFACE_SCHEMA});
     }
 
+    _createSettings(settingsSchema) {
+        if (Main.sessionMode.currentMode !== 'gnoblin' ||
+            settingsSchema !== BACKGROUND_SCHEMA)
+            return new Gio.Settings({schema_id: settingsSchema});
+
+        // Gnoblin may ship newer desktop schemas in its private prefix. Those
+        // schemas lack the host distribution's default wallpaper override.
+        const prefix = GLib.getenv('GNOBLIN_PREFIX');
+        const privateDataDir = prefix
+            ? GLib.build_filenamev([prefix, 'share'])
+            : null;
+        const requiredKeys = [PRIMARY_COLOR_KEY, SECONDARY_COLOR_KEY,
+            COLOR_SHADING_TYPE_KEY, BACKGROUND_STYLE_KEY,
+            PICTURE_URI_KEY, PICTURE_URI_DARK_KEY];
+        for (const dataDir of GLib.get_system_data_dirs()) {
+            if (dataDir === privateDataDir)
+                continue;
+
+            const schemaDir = GLib.build_filenamev([dataDir, 'glib-2.0', 'schemas']);
+            try {
+                const source = Gio.SettingsSchemaSource.new_from_directory(
+                    schemaDir, null, false);
+                const schema = source.lookup(settingsSchema, false);
+                if (!schema || !requiredKeys.every(key => schema.has_key(key)))
+                    continue;
+
+                const defaultUri = schema.get_key(PICTURE_URI_KEY)
+                    .get_default_value().deep_unpack();
+                const defaultDarkUri = schema.get_key(PICTURE_URI_DARK_KEY)
+                    .get_default_value().deep_unpack();
+                if (defaultUri || defaultDarkUri)
+                    return Gio.Settings.new_full(schema, null, null);
+            } catch {
+                // This data directory does not provide compiled schemas.
+            }
+        }
+
+        return new Gio.Settings({schema_id: settingsSchema});
+    }
+
     _onMonitorsChanged() {
         for (const monitorIndex in this._backgrounds) {
             const background = this._backgrounds[monitorIndex];
