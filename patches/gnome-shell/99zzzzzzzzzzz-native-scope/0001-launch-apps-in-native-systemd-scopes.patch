 /**
diff --git a/src/shell-util.c b/src/shell-util.c
index 53b02d882..176ef9cc8 100644
--- a/src/shell-util.c
+++ b/src/shell-util.c
@@ -41,6 +41,137 @@
 
 #include <systemd/sd-daemon.h>
 
+#ifdef HAVE_SYSTEMD
+typedef struct {
+  char *unit;
+  guint32 pid;
+} ScopeRequest;
+
+static void
+scope_request_free (ScopeRequest *request)
+{
+  g_free (request->unit);
+  g_free (request);
+}
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (ScopeRequest, scope_request_free)
+
+static void
+on_gnoblin_scope_started (GObject      *source,
+                          GAsyncResult *result,
+                          gpointer      user_data)
+{
+  g_autoptr (ScopeRequest) request = user_data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = NULL;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source),
+                                         result, &error);
+  if (error && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    g_warning ("Could not create application scope %s: %s",
+               request->unit, error->message);
+}
+
+static void
+on_gnoblin_scope_bus_ready (GObject      *source,
+                            GAsyncResult *result,
+                            gpointer      user_data)
+{
+  g_autoptr (ScopeRequest) request = user_data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GDBusConnection) bus = g_bus_get_finish (result, &error);
+  GVariantBuilder properties;
+  GVariantBuilder auxiliaries;
+
+  if (!bus)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        g_warning ("Could not connect to user bus for %s: %s",
+                   request->unit, error->message);
+      return;
+    }
+
+  g_variant_builder_init (&properties, G_VARIANT_TYPE ("a(sv)"));
+  g_variant_builder_add (&properties, "(sv)", "Description",
+                         g_variant_new_string ("Application launched by Gnoblin"));
+  g_variant_builder_add (&properties, "(sv)", "PIDs",
+                         g_variant_new_fixed_array (G_VARIANT_TYPE_UINT32,
+                                                    &request->pid, 1,
+                                                    sizeof request->pid));
+  g_variant_builder_add (&properties, "(sv)", "CollectMode",
+                         g_variant_new_string ("inactive-or-failed"));
+  g_variant_builder_init (&auxiliaries, G_VARIANT_TYPE ("a(sa(sv))"));
+  g_dbus_connection_call (bus,
+                          "org.freedesktop.systemd1",
+                          "/org/freedesktop/systemd1",
+                          "org.freedesktop.systemd1.Manager",
+                          "StartTransientUnit",
+                          g_variant_new ("(ss@a(sv)@a(sa(sv)))", request->unit, "fail",
+                                         g_variant_builder_end (&properties),
+                                         g_variant_builder_end (&auxiliaries)),
+                          G_VARIANT_TYPE ("(o)"),
+                          G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                          1000, NULL, on_gnoblin_scope_started,
+                          g_steal_pointer (&request));
+}
+#endif
+
+/**
+ * shell_util_start_systemd_scope:
+ * @name: application ID or executable path
+ * @pid: launched process ID
+ *
+ * Put a launched process in its own user scope when Shell itself runs in a
+ * systemd user unit. The request is asynchronous and does not hold up launch.
+ */
+void
+shell_util_start_systemd_scope (const char *name,
+                                int         pid)
+{
+#ifdef HAVE_SYSTEMD
+  g_autofree char *own_unit = NULL;
+  g_autofree char *app_name = NULL;
+  g_autoptr (GString) escaped = NULL;
+  g_autoptr (ScopeRequest) request = NULL;
+  int status;
+
+  if (pid <= 0)
+    return;
+  status = sd_pid_get_user_unit (getpid (), &own_unit);
+  if (status == -ENODATA)
+    return;
+  if (status < 0)
+    {
+      g_warning ("Could not find Shell user unit: %s", g_strerror (-status));
+      return;
+    }
+
+  if (!name || !*name)
+    name = "org.freedesktop.Unknown";
+  if (*name == '/')
+    app_name = g_path_get_basename (name);
+  else if (g_str_has_suffix (name, ".desktop"))
+    app_name = g_strndup (name, strlen (name) - strlen (".desktop"));
+  else
+    app_name = g_strdup (name);
+
+  escaped = g_string_new (NULL);
+  for (const unsigned char *p = (const unsigned char *) app_name; *p; p++)
+    {
+      if (g_ascii_isalnum (*p) || *p == ':' || *p == '_' || *p == '.')
+        g_string_append_c (escaped, *p);
+      else
+        g_string_append_printf (escaped, "\\x%02x", *p);
+    }
+  request = g_new0 (ScopeRequest, 1);
+  request->unit = g_strdup_printf ("app-gnoblin-%s-%d.scope",
+                                   escaped->str, pid);
+  request->pid = (guint32) pid;
+  g_bus_get (G_BUS_TYPE_SESSION, NULL, on_gnoblin_scope_bus_ready,
+             g_steal_pointer (&request));
+#endif
+}
+
 static void
 stop_pick (ClutterActor *actor)
 {
diff --git a/src/shell-util.h b/src/shell-util.h
index ba34165c8..0e043ebc5 100644
--- a/src/shell-util.h
+++ b/src/shell-util.h
@@ -74,6 +74,9 @@ gboolean shell_util_systemd_unit_exists_finish (GAsyncResult  *res,
 
 void shell_util_sd_notify (void);
 
+void shell_util_start_systemd_scope (const char *name,
+                                     int         pid);
+
 gboolean shell_util_has_x11_display_extension (MetaDisplay *display,
                                                const char  *extension);
 
