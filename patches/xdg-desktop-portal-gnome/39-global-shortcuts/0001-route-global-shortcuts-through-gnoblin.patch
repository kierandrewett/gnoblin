+static void
+native_bind_done (JsonObject *result,
+                  const char *error,
+                  gpointer    user_data)
+{
+  BindShortcutsHandle *handle = user_data;
+  GlobalShortcutsSession *session = (GlobalShortcutsSession *) handle->session;
+  Accelerator *accel = g_ptr_array_index (handle->mapped_accelerators,
+                                          handle->next_accelerator - 1);
+
+  (void) result;
+
+  if (error)
+    {
+      handle->failed = TRUE;
+      g_warning ("Gnoblin could not bind approved accelerator %s: %s",
+                 accel->accelerator, error);
+    }
+  else if (session->closing)
+    native_control_request ("shortcut.unbind", accel->native_id, NULL,
+                            native_unbind_done, NULL);
+  else
+    accel->bound = TRUE;
+
+  if (session->closing)
+    accel->bound = FALSE;
+
+  bind_next_approved_accelerator (handle);
+}
+
+static void
+bind_next_approved_accelerator (BindShortcutsHandle *handle)
+{
+  if (handle->next_accelerator >= handle->mapped_accelerators->len)
+    {
+      finish_native_bind_batch (handle);
+      shortcuts_handle_free (handle);
+      return;
+    }
+
+  Accelerator *accel = g_ptr_array_index (handle->mapped_accelerators,
+                                          handle->next_accelerator++);
+  GlobalShortcutsSession *session = (GlobalShortcutsSession *) handle->session;
+  if (handle->canceled || session->closing)
+    {
+      handle->failed = TRUE;
+      accel->bound = FALSE;
+      bind_next_approved_accelerator (handle);
+      return;
+    }
+
+  g_free (accel->native_id);
+  accel->native_id = g_strdup_printf ("portal-%" G_GUINT64_FORMAT,
+                                      ++native_control.next_binding_id);
+  native_control_request ("shortcut.bind", accel->native_id, accel->accelerator,
+                          native_bind_done, handle);
+}
