From e5c7ec540c0b685ee3f271656665e4c70c3718c3 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sat, 26 Sep 2026 20:59:15 +0000
Subject: [PATCH] portal: add native Gnoblin inhibit backend

---
 data/meson.build               | 1 +
 src/meson.build                | 1 +
 src/xdg-desktop-portal-gnome.c | 7 +++++++
 3 files changed, 9 insertions(+)

diff --git a/data/meson.build b/data/meson.build
index 3619057..33f55f4 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -15,6 +15,7 @@ gnome_portal_interfaces = [
   'org.freedesktop.impl.portal.FileChooser',
   'org.freedesktop.impl.portal.GlobalShortcuts',
   'org.freedesktop.impl.portal.InputCapture',
+  'org.freedesktop.impl.portal.Inhibit',
   'org.freedesktop.impl.portal.Lockdown',
   'org.freedesktop.impl.portal.Notification',
   'org.freedesktop.impl.portal.Print',
diff --git a/src/meson.build b/src/meson.build
index 9d515c0..2e1dbe4 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -104,6 +104,7 @@ sources = built_sources + files(
   'displaystatetracker.c',
   'dynamic-launcher.c',
   'gnoblin-email.c',
+  'gnoblin-inhibit.c',
   'fc-monitor.c',
   'gnoblin-filechooser.c',
   'inputcapture.c',
diff --git a/src/xdg-desktop-portal-gnome.c b/src/xdg-desktop-portal-gnome.c
index f3af8c4..e2f8094 100644
--- a/src/xdg-desktop-portal-gnome.c
+++ b/src/xdg-desktop-portal-gnome.c
@@ -62,6 +62,7 @@
 #include "wallpaper.h"
 #include "dynamic-launcher.h"
 #include "gnoblin-email.h"
+#include "gnoblin-inhibit.h"
 #include "notification.h"
 #include "usb.h"
 
@@ -136,6 +137,12 @@ on_bus_acquired (GDBusConnection *connection,
       g_clear_error (&error);
     }
 
+  if (!gnoblin_inhibit_init (connection, &error))
+    {
+      g_warning ("error: %s\n", error->message);
+      g_clear_error (&error);
+    }
+
   if (!access_init (connection, &error))
     {
       g_warning ("error: %s\n", error->message);
-- 
2.55.0

