From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sat, 26 Sep 2026 20:59:15 +0000
Subject: [PATCH] portal: provide the Gnoblin Email and Inhibit backends

Provide the Gnoblin Email portal through the mailto handler and the native Gnoblin Inhibit backend. Both are overlay
sources and need the same wiring in data/meson.build, src/meson.build and xdg-desktop-portal-gnome.c.
---
 data/meson.build               |  2 ++
 src/meson.build                |  2 ++
 src/xdg-desktop-portal-gnome.c | 14 ++++++++++++++
 3 files changed, 18 insertions(+)

diff --git a/data/meson.build b/data/meson.build
index 05251e1..33f55f4 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -11,9 +11,11 @@ gnome_portal_interfaces = [
   'org.freedesktop.impl.portal.Background',
   'org.freedesktop.impl.portal.Clipboard',
   'org.freedesktop.impl.portal.DynamicLauncher',
+  'org.freedesktop.impl.portal.Email',
   'org.freedesktop.impl.portal.FileChooser',
   'org.freedesktop.impl.portal.GlobalShortcuts',
   'org.freedesktop.impl.portal.InputCapture',
+  'org.freedesktop.impl.portal.Inhibit',
   'org.freedesktop.impl.portal.Lockdown',
   'org.freedesktop.impl.portal.Notification',
   'org.freedesktop.impl.portal.Print',
diff --git a/src/meson.build b/src/meson.build
index 9e5f52f..2e1dbe4 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -103,6 +103,8 @@ sources = built_sources + files(
   'clipboard.c',
   'displaystatetracker.c',
   'dynamic-launcher.c',
+  'gnoblin-email.c',
+  'gnoblin-inhibit.c',
   'fc-monitor.c',
   'gnoblin-filechooser.c',
   'inputcapture.c',
diff --git a/src/xdg-desktop-portal-gnome.c b/src/xdg-desktop-portal-gnome.c
index bd1a3f7..e2f8094 100644
--- a/src/xdg-desktop-portal-gnome.c
+++ b/src/xdg-desktop-portal-gnome.c
@@ -61,6 +61,8 @@
 #include "settings.h"
 #include "wallpaper.h"
 #include "dynamic-launcher.h"
+#include "gnoblin-email.h"
+#include "gnoblin-inhibit.h"
 #include "notification.h"
 #include "usb.h"
 
@@ -129,6 +131,18 @@ on_bus_acquired (GDBusConnection *connection,
       g_clear_error (&error);
     }
 
+  if (!email_init (connection, &error))
+    {
+      g_warning ("error: %s\n", error->message);
+      g_clear_error (&error);
+    }
+
+  if (!gnoblin_inhibit_init (connection, &error))
+    {
+      g_warning ("error: %s\n", error->message);
+      g_clear_error (&error);
+    }
+
   if (!access_init (connection, &error))
     {
       g_warning ("error: %s\n", error->message);
-- 
2.55.0

