From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sat, 26 Sep 2026 20:59:15 +0000
Subject: [PATCH] portal: provide Gnoblin Email through the mailto handler

---
diff --git a/data/meson.build b/data/meson.build
index bcbc8d5..ed8a4ce 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -11,6 +11,7 @@ gnome_portal_interfaces = [
   'org.freedesktop.impl.portal.Background',
   'org.freedesktop.impl.portal.Clipboard',
   'org.freedesktop.impl.portal.DynamicLauncher',
+  'org.freedesktop.impl.portal.Email',
   'org.freedesktop.impl.portal.FileChooser',
   'org.freedesktop.impl.portal.GlobalShortcuts',
   'org.freedesktop.impl.portal.InputCapture',
diff --git a/src/meson.build b/src/meson.build
index d182a4e..506853b 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -104,6 +104,7 @@ sources = built_sources + files(
   'clipboard.c',
   'displaystatetracker.c',
   'dynamic-launcher.c',
+  'gnoblin-email.c',
   'fc-monitor.c',
   'gnoblin-filechooser.c',
   'inputcapture.c',
diff --git a/src/xdg-desktop-portal-gnome.c b/src/xdg-desktop-portal-gnome.c
index bd1a3f7..f3af8c4 100644
--- a/src/xdg-desktop-portal-gnome.c
+++ b/src/xdg-desktop-portal-gnome.c
@@ -61,6 +61,7 @@
 #include "settings.h"
 #include "wallpaper.h"
 #include "dynamic-launcher.h"
+#include "gnoblin-email.h"
 #include "notification.h"
 #include "usb.h"
 
@@ -129,6 +130,12 @@ on_bus_acquired (GDBusConnection *connection,
       g_clear_error (&error);
     }
 
+  if (!email_init (connection, &error))
+    {
+      g_warning ("error: %s\n", error->message);
+      g_clear_error (&error);
+    }
+
   if (!access_init (connection, &error))
     {
       g_warning ("error: %s\n", error->message);
