From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kierandrewett <kieran@drewett.dev>
Date: Sat, 26 Sep 2026 20:59:15 +0000
Subject: [PATCH] portal: provide Gnoblin file chooser with GTK4

---
diff --git a/data/meson.build b/data/meson.build
index 8290989..bcbc8d5 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -11,6 +11,7 @@ gnome_portal_interfaces = [
   'org.freedesktop.impl.portal.Background',
   'org.freedesktop.impl.portal.Clipboard',
   'org.freedesktop.impl.portal.DynamicLauncher',
+  'org.freedesktop.impl.portal.FileChooser',
   'org.freedesktop.impl.portal.GlobalShortcuts',
   'org.freedesktop.impl.portal.InputCapture',
   'org.freedesktop.impl.portal.Lockdown',
diff --git a/src/meson.build b/src/meson.build
index 829770b..d182a4e 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -105,6 +105,7 @@ sources = built_sources + files(
   'displaystatetracker.c',
   'dynamic-launcher.c',
   'fc-monitor.c',
+  'gnoblin-filechooser.c',
   'inputcapture.c',
   'inputcapturedialog.c',
   'globalshortcuts.c',
diff --git a/src/xdg-desktop-portal-gnome.c b/src/xdg-desktop-portal-gnome.c
index e3f474e..bd1a3f7 100644
--- a/src/xdg-desktop-portal-gnome.c
+++ b/src/xdg-desktop-portal-gnome.c
@@ -49,6 +49,7 @@
 #include "appchooser.h"
 #include "background.h"
 #include "clipboard.h"
+#include "filechooser.h"
 #include "globalshortcuts.h"
 #include "lockdown.h"
 #include "print.h"
@@ -122,6 +123,12 @@ on_bus_acquired (GDBusConnection *connection,
   if (settings_only)
     return;
 
+  if (!file_chooser_init (connection, &error))
+    {
+      g_warning ("error: %s\n", error->message);
+      g_clear_error (&error);
+    }
+
   if (!access_init (connection, &error))
     {
       g_warning ("error: %s\n", error->message);
