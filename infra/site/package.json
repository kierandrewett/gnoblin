{
  "name": "gnoblin-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve.mjs",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --plugin prettier-plugin-svelte --check .",
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "test:pages": "node scripts/check-pages.mjs",
    "icons": "node scripts/build-icons.mjs",
    "shots": "node scripts/build-shots.mjs"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "hast-util-to-string": "^3.0.1",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tslib": "^2.9.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.5"
  }
}
