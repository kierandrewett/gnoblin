{
  "name": "repo-index",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@4.17.1",
  "dependencies": {
    "hono": "^4.13.14"
  },
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=esm --platform=neutral --target=es2022 --jsx=automatic --jsx-import-source=hono/jsx --outfile=dist/index.js",
    "typecheck": "tsc --noEmit"
  }
}
