#!/usr/bin/env bash
# Run the legacy `gnoblinctl` against the session scripts/parity-mutter-gnoblin started, for the `mutter-gnoblin` target of
# the parity runner (crates/gnoblin-parity).
#
# usage: parity-gnoblinctl RUNTIME_DIR [GNOBLINCTL ARGUMENTS...]
#
# RUNTIME_DIR is the directory the launcher was given; the control socket is RUNTIME_DIR/compositor-v1.sock. The exit
# status and the output are gnoblinctl's.
#
# Environment (the same variables as the launcher):
#   GNOBLIN_PARITY_GNOBLIN_PREFIX  install prefix of the Gnoblin build. Required.
#   GNOBLIN_PARITY_MUTTER_ROOT     run inside this root file system with chroot (root only). RUNTIME_DIR lies inside it.
set -euo pipefail

runtime_dir="${1:?usage: parity-gnoblinctl RUNTIME_DIR [ARGUMENTS...]}"
shift
prefix="${GNOBLIN_PARITY_GNOBLIN_PREFIX:?set GNOBLIN_PARITY_GNOBLIN_PREFIX to the Gnoblin install prefix}"
prefix="${prefix%/}"

if [ -n "${GNOBLIN_PARITY_MUTTER_ROOT:-}" ]; then
    root="${GNOBLIN_PARITY_MUTTER_ROOT%/}"
    case "$runtime_dir" in
        "$root"/*) ;;
        *)
            echo "parity-gnoblinctl: $runtime_dir is not inside GNOBLIN_PARITY_MUTTER_ROOT ($root)" >&2
            exit 2
            ;;
    esac
    # `bash -c SCRIPT _ RUNTIME ARGS...`: $1 is the runtime directory as the root file system sees it, the rest are
    # gnoblinctl's own arguments.
    exec chroot "$root" /usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/root \
        "GNOBLIN_PARITY_GNOBLIN_PREFIX=$prefix" \
        /bin/bash -c 'source "$GNOBLIN_PARITY_GNOBLIN_PREFIX/libexec/gnoblin-env.sh"
gnoblin_env_apply "$GNOBLIN_PARITY_GNOBLIN_PREFIX"
export GNOBLIN_COMPOSITOR_SOCKET="$1/compositor-v1.sock"
shift
exec gnoblinctl "$@"' _ "${runtime_dir#"$root"}" "$@"
fi

# shellcheck disable=SC1091
source "$prefix/libexec/gnoblin-env.sh"
gnoblin_env_apply "$prefix"
export GNOBLIN_COMPOSITOR_SOCKET="$runtime_dir/compositor-v1.sock"
exec gnoblinctl "$@"
