#!/usr/bin/env bash
# Start the legacy C Gnoblin on its patched Mutter, headless, for the `mutter-gnoblin` target of the parity runner
# (crates/gnoblin-parity).
#
# usage: parity-mutter-gnoblin RUNTIME_DIR DISPLAY
#
# The runner calls this with XDG_RUNTIME_DIR set to RUNTIME_DIR (mode 0700) and expects a Wayland socket named DISPLAY
# in it, and a session bus at RUNTIME_DIR/bus (the way to Mutter's EIS server, `org.gnome.Mutter.RemoteDesktop`). The
# control socket is RUNTIME_DIR/compositor-v1.sock; scripts/parity-gnoblinctl talks to it. The script stays in the
# foreground until the runner kills its process group.
#
# The session is the one `scripts/run-gnoblin-devkit.sh` starts: the guardian in devkit mode, which runs the patched
# Mutter on its headless backend with one 1280x720 virtual monitor, the Lua runtime and the control socket. The devkit
# only matters for the headless backend: Mutter would also start its viewer window, so the host display is unset and
# GNOBLIN_DEVKIT_KEEP_SESSION keeps the session alive when the viewer fails to open (patch devkit-keep-session-after-
# viewer-exit). Nothing of the host session is used: the bus, the XDG directories and the runtime directory are the
# runner's.
#
# Environment:
#   GNOBLIN_PARITY_GNOBLIN_PREFIX  install prefix of a Gnoblin build made with GNOBLIN_DEVKIT=enabled (`./build.sh
#                                  --prefix`). Required.
#   GNOBLIN_PARITY_MUTTER_ROOT     run inside this root file system with chroot (root only), as for parity-mutter51.
set -euo pipefail

runtime_dir="${1:?usage: parity-mutter-gnoblin RUNTIME_DIR DISPLAY}"
display="${2:?usage: parity-mutter-gnoblin RUNTIME_DIR DISPLAY}"

[ -n "${PARITY_LAUNCHER_LIB:-}" ] || source "$(dirname "${BASH_SOURCE[0]}")/parity-launcher-lib.sh"
parity_enter_root "${BASH_SOURCE[0]}" "$runtime_dir" "$display"

prefix="${GNOBLIN_PARITY_GNOBLIN_PREFIX:?set GNOBLIN_PARITY_GNOBLIN_PREFIX to the Gnoblin install prefix}"
prefix="${prefix%/}"
[ -x "$prefix/bin/gnoblin" ] || {
    echo "parity-mutter-gnoblin: $prefix/bin/gnoblin is not an executable; build Gnoblin first (scripts/parity-reference.sh gnoblin)" >&2
    exit 1
}
[ -f "$prefix/share/gnoblin/mutter-devkit-enabled" ] || {
    echo "parity-mutter-gnoblin: $prefix was built without the devkit, which is what gives the compositor its headless backend here" >&2
    exit 1
}

# The same library, data and desktop settings as every other launch of this prefix.
# shellcheck disable=SC1091
source "$prefix/libexec/gnoblin-env.sh"
gnoblin_env_apply "$prefix"

mkdir -m 700 "$runtime_dir"/{home,config,data,cache,state}
export XDG_RUNTIME_DIR="$runtime_dir"
export HOME="$runtime_dir/home" XDG_CONFIG_HOME="$runtime_dir/config" XDG_DATA_HOME="$runtime_dir/data"
export XDG_CACHE_HOME="$runtime_dir/cache" XDG_STATE_HOME="$runtime_dir/state"
export GNOBLIN_COMPOSITOR_SOCKET="$runtime_dir/compositor-v1.sock"
unset GNOBLIN_CONFIG IBUS_ADDRESS WAYLAND_DISPLAY DISPLAY
export GIO_USE_VFS=local GVFS_DISABLE_FUSE=1 GTK_A11Y=none NO_AT_BRIDGE=1
export XDG_SESSION_DESKTOP=gnoblin
# No GPU: render with llvmpipe, so the session is the same on a runner and on a workstation.
export LIBGL_ALWAYS_SOFTWARE=1
# The devkit viewer has no display to open on; the session must outlive it.
export GNOBLIN_DEVKIT_KEEP_SESSION=1
# `gnoblin` runs the guardian, which also needs a session bus: the private one the runner reaches too.
parity_start_bus "$runtime_dir"

xwayland=--no-xwayland
exec "$prefix/bin/gnoblin" --devkit --wayland-display "$display" "$xwayland" </dev/null
