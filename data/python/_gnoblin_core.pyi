"""The built-in module of libgnoblin-runtime-python: the whole of what Python reaches of the Gnoblin core.

Generic by name: classes, properties, methods and signals are named as the schema catalog names them. The typed classes of
``gnoblin`` are generated over this module; a script normally uses those, not this.
"""

from typing import Any, Callable, Sequence

class GnoblinError(Exception): ...
class RetiredError(GnoblinError): ...
class NodeGoneError(GnoblinError): ...
class MemberError(GnoblinError): ...
class RefusedError(GnoblinError): ...
class StaleError(GnoblinError): ...
class UnsupportedError(GnoblinError): ...
class BusyError(GnoblinError): ...
class ThreadError(GnoblinError): ...

def log(level: str, message: str) -> None: ...
def info() -> dict[str, Any]: ...
def stats() -> dict[str, int]: ...
def request_reload() -> None: ...
def request_exit(code: int) -> None: ...
def post(callback: Callable[[], None]) -> None: ...
def keep_state(key: str, data: bytes, version: int = 0) -> None: ...
def kept_state(key: str) -> tuple[bytes, int] | None: ...
def set_node_factory(factory: Callable[[int, str | None], Any]) -> None: ...

# The tree.
def root() -> int: ...
def windows() -> list[int]: ...
def node_exists(id: int) -> bool: ...
def node_class(id: int) -> str: ...
def node_parent(id: int) -> int | None: ...
def node_children(id: int) -> list[int]: ...
def node_get(id: int, name: str) -> Any: ...
def node_set(id: int, name: str, value: Any, seconds: float = 0.0) -> None: ...
def node_call(
    id: int,
    method: str,
    args: tuple[Any, ...] | None = None,
    on_answer: Callable[[bytes, str | None], None] | None = None,
) -> None: ...
def node_insert(id: int, parent: int, index: int | None = None) -> None: ...
def node_destroy(id: int) -> None: ...
def create_node(class_: str) -> int: ...
def adopt_node(class_: str, name: str, ephemeral: bool = False) -> tuple[int, bool]: ...
def flush(on_done: Callable[[int | None, str | None], None]) -> None: ...

# Events, timers and hooks. Each returns the number `unsubscribe` takes.
def on_node_created(class_: str, callback: Callable[[Any], None]) -> int: ...
def on_node_destroyed(class_: str, callback: Callable[[Any], None]) -> int: ...
def on_class_property_changed(class_: str, name: str, callback: Callable[[Any, Any], None]) -> int: ...
def on_property_changed(id: int, name: str, callback: Callable[[Any, Any], None]) -> int: ...
def on_window_request(callback: Callable[[Any, str, float, float], None]) -> int: ...
def on_node_event(id: int, callback: Callable[[str, float, float, int, str, str, float, float, bool], None]) -> int: ...
def on_signal(class_: str, signal: str, callback: Callable[[Any, list[Any]], None]) -> int: ...
def on_shutdown(callback: Callable[[], None]) -> int: ...
def after(ms: int, callback: Callable[[], None]) -> int: ...
def every(ms: int, callback: Callable[[], None]) -> int: ...
def unsubscribe(token: int) -> None: ...

# Input.
def bind(chord: str, callback: Callable[[], None]) -> int: ...
def bind_events(chord: str, callback: Callable[[str, str], None]) -> int: ...
def bind_pointer(chord: str, callback: Callable[[str, float, float, float, float, int, str, int], None]) -> int: ...
def bind_gesture(
    kind: str, fingers: int, callback: Callable[[str, int, str, float, float, float, float], None]
) -> int: ...
def claim_pointer_buttons(device: str, callback: Callable[[int, bool, float, float, int], None]) -> int: ...
def claim_device(device: str) -> int: ...
def grab_input(node: int, scope: str) -> int: ...

# Programs.
def spawn(
    argv: Sequence[str],
    cwd: str | None = None,
    env: Sequence[tuple[str, str]] | None = None,
    stdin: str | None = None,
    stdout: str = "inherit",
    stderr: str = "inherit",
    output_limit: int = 0,
    timeout_ms: int = 0,
    on_exit: Callable[[int | None, str | None, bool, str, str, bool, bool], None] | None = None,
) -> int: ...
def process_signal(token: int, name: str) -> None: ...
